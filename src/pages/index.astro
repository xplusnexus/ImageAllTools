                  <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm sm:text-base font-bold text-white transition-colors hover:text-cyan list-none">
                    <span>{item.q}</span>
                    <span class="text-purple group-open:rotate-45 group-open:text-cyan transition-transform text-2xl leading-none flex-shrink-0 font-bold" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p class="mt-3 text-sm text-slate-100 font-normal leading-relaxed border-t border-[#334468]/40 pt-3">
                    {item.a}
                  </p>
                </details>
              ))}
