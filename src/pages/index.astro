---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CoreValueProps from "../components/CoreValueProps.astro";
import LanguageSelector from "../components/LanguageSelector.astro";

const allTools = await getCollection("tools");

const CATEGORY_ORDER = ["optimize", "create", "edit", "convert", "security"] as const;
const CATEGORY_LABEL: Record<string, string> = {
  optimize: "Optimize & Compress",
  create: "Create & Enhance",
  edit: "Edit, Crop & Transform",
  convert: "Format Converters",
  security: "Security & Privacy",
};

interface FAQItem {
  q: string;
  a: string;
}

interface FAQCategory {
  category: string;
  icon: string;
  badge: string;
  items: FAQItem[];
}

const faqCategories: FAQCategory[] = [
  {
    category: "Use Case / Intent-Based Solutions",
    icon: "🎯",
    badge: "High SEO Intent",
    items: [
      {
        q: "How do I reduce an image file size for email attachments?",
        a: "Use our Image Compressor to shrink file size while keeping visual quality clear and legible. Set a target limit (such as 100KB or 200KB) to ensure your photo stays well below email provider attachment limits like Gmail or Outlook 25MB caps."
      },
      {
        q: "How do I make an image smaller for a website without losing quality?",
        a: "Use our Resize and Compress tools together: first resize your image to its exact responsive display dimensions (e.g. 1200px max width for desktop hero banners), then compress it to modern WebP format. This slashes page payload and improves your Google Core Web Vitals (LCP) score."
      },
      {
        q: "What's the best image size for Instagram, Facebook, and LinkedIn posts?",
        a: "Use our Resize tool's built-in social presets: 1080×1080px for standard Instagram square (or 1080×1350px for portrait), 1200×630px for Facebook and LinkedIn link previews, and 1280×720px for YouTube video thumbnails."
      },
      {
        q: "How do I resize an image for Instagram without cropping or paying for Canva Pro?",
        a: "Open our Instagram Image Resizer, select your target post size (Square 1080×1080 or Portrait 1080×1350), and choose 'Fit with Aesthetic Blur' or 'Clean White/Black Borders'. Our client-side engine automatically surrounds your photo with matching soft blurred margins, preserving 100% of your photo without cropping or paying for Canva Pro's $12.99/mo Magic Resize."
      },
      {
        q: "How do I add text to an image online for free without Canva or Photoshop?",
        a: "Use our Add Text to Image tool. Upload your photo, type your caption, label, or watermark, customize font styles and colors, and position it anywhere on the image. It operates 100% locally in your browser with zero logins, zero ads, and zero watermarks."
      },
      {
        q: "How do I copy or extract text from a photo or screenshot?",
        a: "Use our Image to Text (OCR) converter. It analyzes document photos, book scans, and screenshots with high-accuracy character recognition, allowing you to copy the extracted text directly to your clipboard in a single click."
      },
      {
        q: "How do I blur a face in a photo or add aesthetic background blur?",
        a: "Use our Blur Face tool or Blur Image tool. Upload your photo, position the interactive face box or select 'Background Blur' for a portrait DSLR bokeh effect. You can choose Aesthetic Soft Blur, Motion Blur Effect (+1000% trending), or Censor Pixelation. Processing is 100% on-device with zero server uploads."
      },
      {
        q: "How do I add motion blur to a photo for reels and action edits?",
        a: "Use our Blur Image tool, switch the effect to 'Motion Blur Effect (Speed Blur)', and adjust the intensity slider. It creates dynamic horizontal velocity streaks—ideal for action shots, sports photography, and viral Ravi Telugu edit styles."
      },
      {
        q: "How do I make a free photo collage or side-by-side photo comparison online?",
        a: "Use our Photo Collage Maker. Drag and drop 2 to 9+ photos, choose from templates like 2-Photo Side-by-Side (Before & After), 2×2 Classic Grid, or 3×3 Instagram Grid, customize border gap, corner roundness, and frame colors, and download instantly without watermarks or signups."
      },
      {
        q: "How do I crop an image into a circle or make a circular avatar with a red ring?",
        a: "Use our Circle Crop Image tool. Upload your photo, center the circular guide over your face or logo, choose transparent PNG export (with zero background corners), and optionally add a vibrant profile ring border (Red Circle, Neon Cyan, or Gold) for WhatsApp DP, Instagram, and YouTube avatars."
      },
      {
        q: "How do I flip an image horizontally or fix a mirrored front-camera selfie?",
        a: "Use our Flip Image tool. Upload your photo and click '⇋ Flip Horizontal' to mirror it left-to-right (restoring natural selfie perspective and making t-shirt text readable) or '⇵ Flip Vertical' to turn it upside down. It operates 100% on-device with zero quality loss and zero watermarks."
      },
      {
        q: "How do I put full pic in WhatsApp DP without any app or cropping (WhatsApp par full DP kaise lagaye)?",
        a: "Use our WhatsApp Full DP Maker. Upload any portrait or landscape photo, and our engine automatically mounts it onto a 1:1 HD square canvas with aesthetic blur margins or full black borders. You can preview the exact WhatsApp circular safe ring and download an uncropped 1080×1080px profile picture completely free."
      },
      {
        q: "How do I crop an image online into a square, circle avatar, or YouTube thumbnail?",
        a: "Use our Universal Online Image Cropper. Upload any picture, pick a preset like 1:1 Square (for profile pictures), ⭕ Circle / Round Avatar (with transparent background corners for Discord and Twitter/X), 16:9 Landscape (for YouTube thumbnails), or 35:45 (for passport photos), and click 'Crop & Download' for an instant watermark-free result."
      },
      {
        q: "How do I remove the background from a photo or product to make a transparent PNG or white Amazon backdrop?",
        a: "Use our Instant Background Remover. Drag and drop any portrait, product, logo, or signature, and choose '✨ Transparent PNG' (for alpha-cutout graphics and stickers) or '⚪ Pure White' (for Amazon, Shopify, and eBay marketplace compliance). It runs 100% locally in your browser with zero logins, zero watermarks, and unlimited full-HD downloads."
      },
      {
        q: "How do I extract a color palette from an image or find what color palette season I am?",
        a: "Use our Color Palette Generator & Seasonal Analysis tool. Upload your photo or selfie to extract 5 to 10 dominant colors with exact Hex codes, RGB, and HSL values. The built-in seasonal engine detects warm vs. cool undertones to identify your season (Autumn, Winter, Spring, Summer), audits WCAG AA/AAA contrast ratios, and exports 1-click CSS variables, Tailwind configs, and high-res presentation swatch cards without paywalls."
      }
    ]
  },
  {
    category: "General & Trust",
    icon: "🔒",
    badge: "100% Free & Private",
    items: [
      {
        q: "Is there a limit to how many images I can edit per day?",
        a: "No, there's no daily limit. You can use our tools as many times as you need, completely free, with no restrictions on the number of images processed."
      },
      {
        q: "Do you store or save my uploaded images?",
        a: "No. Since all processing happens locally in your browser via HTML5 Canvas and WebAssembly, we never see, store, or have access to your images. Nothing is ever uploaded to our servers."
      },
      {
        q: "Is AllImageTools.com really 100% free forever?",
        a: "Yes, our core tools are free with no trial periods, credit limits, or hidden premium tiers."
      },
      {
        q: "Do you add watermarks to processed images?",
        a: "No. Your images are returned exactly as edited, with no watermarks, brand logos, or unwanted branding added."
      }
    ]
  },
  {
    category: "Resize Tool & Social Media Presets",
    icon: "📐",
    badge: "Instagram, Canva Free Alt & Presets",
    items: [
      {
        q: "What's the maximum image size I can resize?",
        a: "You can resize images up to 50MB per file and resolutions up to 8K (7680×4320px). Because all calculations execute directly on your device, you are never restricted by server upload limits."
      },
      {
        q: "How do I resize an image for Instagram without cropping?",
        a: "Use our Instagram Resizer and select '✨ Fit (No-Crop) with Aesthetic Blur'. Our engine mounts your horizontal or vertical photo onto an Instagram-compliant 1080×1080 square or 1080×1350 portrait canvas with soft blurred margins, keeping 100% of your subject visible without cropping heads or feet."
      },
      {
        q: "Is ImageAll a free alternative to Canva Pro Magic Resize and Adobe Express?",
        a: "Yes. Canva locks its 'Magic Resize' feature behind a $12.99/month Canva Pro subscription, and Adobe Express requires account logins. ImageAll is 100% free with unlimited one-click Instagram, Facebook, and YouTube presets, no subscriptions, no accounts, and no watermarks."
      },
      {
        q: "Can I resize an image to exact pixel dimensions?",
        a: "Yes, you can enter custom width and height in pixels, scale proportionally by percentage, or choose from common presets (social media, print, web)."
      },
      {
        q: "What is the official Facebook profile picture and cover photo size in 2026?",
        a: "Facebook profile pictures require a 1:1 square (recommended 2048×2048 px HD or 1080×1080 px, displayed at 170×170 px on desktop and 128×128 px on mobile as a circle). Cover photos display at 820×312 px on desktop and 640×360 px on mobile (recommended 1640×624 px 2x HD with a centered mobile-safe zone). Our tool resizes both with zero cropping."
      },
      {
        q: "Will resizing distort my image?",
        a: "No. You can lock the aspect ratio, choose 'Fit with Blur Margin' or 'Center Crop to Fill' to resize into any aspect ratio without stretching or distortion."
      }
    ]
  },
  {
    category: "Compress Tool & Target KB Reducer",
    icon: "🗜️",
    badge: "15KB to 2MB Presets",
    items: [
      {
        q: "How much can I compress an image without losing quality?",
        a: "Our compressor typically reduces file size by 50–80% while maintaining visual quality, using adjustable compression settings and real-time target KB search."
      },
      {
        q: "How do I compress images to 20KB, 40KB, or 50KB for TNPDS and TNeGA portals?",
        a: "Use our Image Compressor and click the 20KB, 40KB, or 50KB preset buttons. For TNPDS ration card applicant photos, set the target under 40KB. For TNeGA candidate photos, set 50KB, and for signatures, set 15KB–20KB. All processing occurs 100% locally in your browser with zero server uploads."
      },
      {
        q: "Why is ImageAll the best private alternative to Pi7 Image Compressor and 11zon?",
        a: "Pi7 and 11zon upload your confidential photos and documents to remote third-party servers. ImageAll executes all compression algorithms locally in your browser memory via WebAssembly and Canvas APIs. Your files never leave your device, there are no queue delays, no ads, and no watermarks."
      },
      {
        q: "Can I compress images to an exact target size like 20KB, 50KB, 100KB, 1MB, or 2MB?",
        a: "Yes. Switch to 'Target file size' mode and click our one-tap presets (15KB, 20KB, 40KB, 50KB, 100KB, 200KB, 300KB, 1MB, 2MB) or type your desired KB. Our binary search engine calculates the exact compression ratio."
      },
      {
        q: "What's the difference between lossy and lossless compression?",
        a: "Lossless compression reduces file size with zero quality loss (ideal for PNG graphics, vector logos, and screenshots); lossy compression allows a greater size reduction with a small, often unnoticeable quality trade-off (best for JPG and WebP photos). You can choose either."
      }
    ]
  },
  {
    category: "PDF Tools & 300KB Compressor",
    icon: "📄",
    badge: "Image to PDF & 300KB",
    items: [
      {
        q: "How do I convert images to PDF and compress under 300KB for government portals?",
        a: "Upload your JPG or PNG document scans into our Image to PDF Converter. Under Compression & Quality, choose 'Compress to ~300KB (TNPDS, TNeGA & Portals)'. Our client-side compiler optimizes embedded image streams so your multi-page PDF stays strictly below the 300KB ceiling."
      },
      {
        q: "Can I combine multiple JPG or PNG images into a single PDF document?",
        a: "Yes. Our multi-image PDF maker lets you upload multiple files, reorder pages with up/down arrows, select A4 or US Letter page dimensions, and merge them into a single clean PDF completely free without watermarks."
      },
      {
        q: "Why is ImageAll Image to PDF better than iLovePDF and Smallpdf?",
        a: "iLovePDF and Smallpdf enforce daily task limits and upload your private ID proofs, bank statements, and certificates to cloud storage. ImageAll compiles PDFs 100% client-side inside your browser sandbox with zero network transmission, zero limits, and zero watermarks."
      }
    ]
  },
  {
    category: "Image Cropper & PFP Studio",
    icon: "✂️",
    badge: "Universal Ratios & Circle Avatar",
    items: [
      {
        q: "How do I crop an image online for free without watermarks or quality loss?",
        a: "Open our Universal Online Image Cropper, drag and drop your photo, and pick any universal preset (Freeform, 1:1 Square, 4:5 Portrait, 16:9 Landscape, 9:16 Story, 4:3 Standard, 3:2 DSLR, or 35:45 Passport). Drag the interactive rule-of-thirds grid to compose your shot and click 'Crop & Download' for an instant, lossless PNG, JPG, or WEBP."
      },
      {
        q: "What is the best square and circle avatar cropper for Discord, WhatsApp, and Twitter/X?",
        a: "Our Image Cropper includes a built-in '⭕ Circle / Round Avatar' shape selector. Unlike basic JPG tools that leave white or black corner boxes, our tool clips your photo along a mathematically smooth circular vector and exports a transparent PNG with zero background corners—perfect for Discord, Steam, Twitter/X, and WhatsApp avatars."
      },
      {
        q: "Can I crop images to official passport and visa sizes (35:45mm)?",
        a: "Yes. Click our '🛂 35:45 (Passport / Visa)' preset button. It automatically constrains your crop box to the international Schengen, UK, and Indian passport photo ratio (7:9), allowing you to frame head-and-shoulder requirements with precision."
      },
      {
        q: "Why is ImageAll's online cropper better than npm packages like Cropper.js or apps like Canva?",
        a: "Developer libraries like Cropper.js and React Image Crop require package configuration and hosting, while Canva locks basic features like transparent PNG export behind a paid subscription and uploads your photos to the cloud. ImageAll executes 100% locally in your browser using hardware-accelerated Canvas with zero logins, zero fees, and zero server uploads."
      },
      {
        q: "Can I move and reposition the crop frame after selecting it?",
        a: "Yes. Simply click and drag inside the illuminated crop window to slide it across your image, or drag outside the box to establish a new custom rectangle. You can also click 'Center 80% Box' to reset your composition."
      }
    ]
  },
  {
    category: "WhatsApp Full DP & No-Crop Studio",
    icon: "💬",
    badge: "Full Black DP & Aesthetic Blur",
    items: [
      {
        q: "How do I put full pic in WhatsApp DP without any app or cropping?",
        a: "Open our WhatsApp Full DP Maker in your mobile or desktop browser, upload your portrait or landscape photo, and our tool automatically fits it into a 1:1 HD square canvas with an Aesthetic Gaussian Blur margin. You can adjust margins, padding, and corner radius, and download a ready-to-set 1080×1080px or 640×640px WhatsApp profile picture without cutting off heads, feet, or friends."
      },
      {
        q: "What is the full form of DP in WhatsApp?",
        a: "The full form of DP in WhatsApp is 'Display Picture' (in Hindi: 'WhatsApp DP ka full form Display Picture hota hai'). In social media and messaging apps, DP refers to your personal user profile photo or avatar."
      },
      {
        q: "How do I create and download a Full Black DP for WhatsApp?",
        a: "Open our WhatsApp DP Maker and click the '🖤 Full Black DP (+350%)' preset button. It generates an instant, pure #000000 high-definition square image formatted for WhatsApp profiles (ideal for privacy, mood status, or mourning). You can download it directly in full HD with zero sign-ups."
      },
      {
        q: "What is the official WhatsApp DP size and resolution in 2026?",
        a: "WhatsApp recommends a minimum square resolution of 500×500 px, with standard HD at 640×640 px and Full HD Retina display at 1080×1080 px (1:1 aspect ratio). Our tool renders at both 640×640 px and 1080×1080 px for sharp, non-pixelated viewing on both smartphones and WhatsApp Web."
      }
    ]
  },
  {
    category: "Background Remover & Transparent PNG Studio",
    icon: "🪄",
    badge: "Free Cutout & White Backdrop",
    items: [
      {
        q: "How do I remove the background from an image online for free without limits?",
        a: "Open our Instant Background Remover, upload your image, and choose your preferred backdrop: Transparent PNG (for graphic design and stickers), Pure White #FFFFFF (for Amazon, Shopify, and eBay), Passport Blue (for visas), or Soft Portrait Blur. It executes 100% on your device with no daily caps and zero watermarks."
      },
      {
        q: "How do I get a pure white background for Amazon and Shopify products?",
        a: "Upload your product picture (clothing, bags, shoes, jewelry, or electronics) and click the '⚪ Pure White' preset. The tool erases cluttered home or studio backgrounds and replaces them with solid RGB 255, 255, 255 (#FFFFFF) compliance."
      },
      {
        q: "Why is ImageAll better than Canva Pro, Adobe Express, and Remove.bg?",
        a: "Canva Pro charges $12.99/month for background removal, Adobe Express enforces account logins, and Remove.bg limits free users to low-res 0.25MP previews while charging credits for HD. ImageAll gives you 100% free, unlimited, full-resolution HD downloads with zero login and zero cloud uploads."
      },
      {
        q: "Can I make a transparent PNG background for signatures, logos, and icons?",
        a: "Yes. Switch the backdrop style to '✨ Transparent (Alpha PNG Cutout)'. The tool removes the white paper or background and saves a clean 32-bit transparent PNG with zero haloing, ready to stamp onto PDFs or branding assets."
      },
      {
        q: "How do I clean photo backgrounds for Aadhaar, Voter ID, and Ration Card portals?",
        a: "Upload your portrait, select 'Pure White' or 'Passport Light Blue', and download the clean photo. You can then use our Image Compressor to compress it under 20KB or 50KB to meet UIDAI, NVSP, and state ration card upload specifications."
      }
    ]
  },
  {
    category: "Format Conversion",
    icon: "🔄",
    badge: "HEIC, WebP, JPG, PNG",
    items: [
      {
        q: "Can I convert HEIC to JPG?",
        a: "Yes, our converter supports converting Apple iPhone HEIC and HEIF photos directly to JPG or PNG with full high-resolution preservation."
      },
      {
        q: "Can I convert PNG to WebP for faster website loading?",
        a: "Yes, WebP conversion is supported and recommended for improving website page speed and Google Core Web Vitals scores."
      },
      {
        q: "Does converting formats reduce image quality?",
        a: "Quality depends on the target format; we optimize default export profiles to minimize loss during conversion and retain alpha transparency when converting between PNG and WebP."
      }
    ]
  },
  {
    category: "HTML to Image & Base64 Studio",
    icon: "💻",
    badge: "Code & Base64",
    items: [
      {
        q: "How do I convert HTML and CSS code to a PNG or JPG image?",
        a: "Open our HTML to Image Converter, paste your raw HTML and CSS markup, choose your width and scale (1x, 2x Retina, 3x Ultra), and click 'Render HTML to Preview'. You can export as a lossless transparent PNG, compressed JPG, or PDF document with zero server latency."
      },
      {
        q: "Can I convert images to Base64 code strings or decode Base64 back to image files?",
        a: "Yes. Our HTML to Image Converter features a dedicated 'Image to Base64 & HTML' tab that generates RFC 2397 Data URIs, HTML <img> tags, and CSS background properties with one-click copy buttons, as well as a 'Base64 to Image' tab to decode data strings into viewable PNG and JPG graphics."
      },
      {
        q: "Can I convert HTML code directly into a PDF document for free?",
        a: "Yes. In the HTML to Image Converter, select 'PDF Document (Print / TNPDS)' from the format dropdown. Our client-side vector compiler creates an unwatermarked, publication-quality PDF file right in your browser."
      }
    ]
  },
  {
    category: "OCR / Image to Text",
    icon: "📝",
    badge: "Text Extraction",
    items: [
      {
        q: "What languages does the OCR tool support?",
        a: "Our OCR tool supports over 100 languages, with optimized recognition models for English, Spanish, French, German, Italian, Portuguese, Chinese, Japanese, and Hindi."
      },
      {
        q: "Can OCR read handwritten text?",
        a: "Our OCR tool is optimized primarily for printed, typed, and scanned documents, signs, and screenshots. Legible block handwriting can often be recognized, but stylized cursive or low-contrast handwriting will have lower accuracy."
      },
      {
        q: "What image quality is needed for accurate OCR results?",
        a: "Clear, well-lit images with high-contrast, legible text produce the best results. Blurry, low-resolution, or heavily skewed images may reduce recognition accuracy."
      }
    ]
  },
  {
    category: "Technical / Compatibility",
    icon: "💻",
    badge: "Browser & Offline",
    items: [
      {
        q: "Which browsers are supported?",
        a: "Our tools work on all modern browsers, including Google Chrome, Mozilla Firefox, Apple Safari, Microsoft Edge, and Opera on desktop and mobile devices."
      },
      {
        q: "Do I need to install any software or extensions?",
        a: "No installation needed — everything runs directly in your web browser with zero software or extension downloads."
      },
      {
        q: "Does this work offline?",
        a: "Yes! Because the tools run 100% on client-side Web APIs, once you have opened the webpage, you can disconnect from Wi-Fi or go into airplane mode and continue editing images offline without network calls."
      }
    ]
  }
];

const allFaqsFlat = faqCategories.flatMap((c) => c.items);
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqsFlat.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a
    }
  }))
};
---
<BaseLayout
  title="ImageAll — Free Online Image Tools: Compress, Resize, Convert, Crop & More | XPlus Nexus"
  description="ImageAll by XPlus Nexus is a free all-in-one image toolkit: compress, resize, convert, crop, rotate, remove backgrounds, watermark, extract colors, and turn images into PDFs — right in your browser."
  canonicalPath="/"
  keyword="free image tools, online image editor, compress image to kb, resize image online, crop image to circle, background remover, image to pdf, photo collage maker, color palette generator, whatsapp full dp maker, flip image, html to image converter, blur face in photo, image tools worldwide"
>
  <!-- SEO WebApplication Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ImageAll",
    url: "https://www.imagealltools.com/",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any (browser-based)",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", name: "XPlus Nexus", url: "https://www.xplusnexus.com" },
    description: "A free, browser-based suite of image tools: compress, resize, convert, crop, rotate, remove backgrounds, watermark, extract colors, and convert images to PDF. 100% on-device processing."
  })} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-14 md:py-20 border-b border-border">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-cyan/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-10 -right-20 w-96 h-96 bg-purple/15 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="wrap relative z-10 max-w-4xl">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl border border-cyan/40 bg-surface shadow-[0_0_20px_rgba(38,224,255,0.18)] mb-4">
        <img src="/logo.png" alt="XPlus Nexus Logo" class="w-6 h-6 rounded-md object-cover" />
        <span class="text-xs sm:text-sm font-semibold text-slate-200">An <strong class="text-cyan font-bold">XPlus Nexus</strong> product</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight text-white leading-tight">
        Every image tool you need, <span class="accent">in one place.</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
        Upload an image and every tool below actually processes it — compress, resize, convert, crop, remove backgrounds, watermark, extract colors, or export to PDF, all on your own device.
      </p>
      
      <div class="mt-6 rounded-xl border border-cyan/40 bg-surface-2 p-4 text-xs sm:text-sm text-slate-200 flex items-start gap-3 shadow-md">
        <span class="text-cyan font-bold text-base leading-none mt-0.5">⚡</span>
        <div>
          <strong class="text-white font-semibold">100% Client-Side Private Engine:</strong> No images are uploaded to any server. Everything runs on your computer or phone using HTML5 Canvas &amp; WebAssembly APIs.
        </div>
      </div>

      <!-- Proven Performance / Trusted by Creators Worldwide (Hero Placement - Dynamic & Real) -->
      <div class="mt-12 pt-10 border-t border-border/80" id="proven-performance-section">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 mb-8">
          <div>
            <!-- Prominent Badge -->
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-purple/60 bg-purple/20 text-purple text-xs sm:text-sm font-black uppercase tracking-wider mb-3.5 shadow-[0_0_20px_rgba(179,102,255,0.35)]">
              <span class="w-2.5 h-2.5 rounded-full bg-purple animate-pulse shadow-[0_0_8px_rgba(179,102,255,0.8)]"></span>
              <span>Proven Performance</span>
              <span class="text-purple/60">•</span>
              <span class="text-white">Global Real-Time Telemetry</span>
            </div>
            <!-- Big Bold Headline -->
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-black text-white tracking-tight leading-tight">
              Proven Performance <span class="text-purple mx-1 sm:mx-2">•</span> Trusted by Creators <span class="accent">Worldwide</span>
            </h2>
            <p class="text-sm sm:text-base text-slate-200 mt-2.5 max-w-2xl leading-relaxed">
              Authentic processing telemetry computed directly on your device. Zero cloud uploads, zero wait times, and verified by creators worldwide.
            </p>
          </div>
          <!-- Live User Telemetry Indicator -->
          <div class="flex items-center gap-3 px-4 py-3 rounded-2xl border border-emerald-500/40 bg-emerald-950/30 shadow-[0_0_20px_rgba(16,185,129,0.15)] w-fit self-start lg:self-end">
            <span class="relative flex h-3.5 w-3.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
