            class="w-full bg-[#192238] border-1.5 border-[#3b4e78] rounded-xl px-4 py-2.5 pl-10 text-white text-sm font-semibold placeholder:text-slate-300 focus:outline-none focus:border-cyan focus:ring-2 focus:ring-cyan/30 transition-all shadow-inner"
          />
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-cyan text-sm pointer-events-none">🔍</span>
        </div>
      </search>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="tools-grid">
        {allTools.map((t: CollectionEntry<"tools">) => (
          <div data-category={t.data.category} class="tool-card-item">
            <ToolCard
              slug={t.slug}
              h1={t.data.h1}
              description={t.data.description}
              category={CATEGORY_LABEL[t.data.category]}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CATEGORIZED FAQ & SCHEMA ================= -->
  <section class="py-16 border-t border-border bg-gradient-to-b from-[#0f1422] via-surface to-[#0f1422]" id="faq">
    <div class="wrap max-w-5xl">
      <div class="section-head mb-12 text-center max-w-2xl mx-auto">
        <span class="text-xs font-semibold uppercase tracking-wider text-purple px-3 py-1 rounded-full border border-purple/30 bg-purple/10">Help &amp; Knowledge Base</span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-white mt-3">Frequently Asked Questions</h2>
        <p class="text-sm sm:text-base text-slate-100 font-normal mt-2 leading-relaxed">
          Everything you need to know about processing images safely, privately, and at maximum quality with ImageAll.
        </p>
      </div>

      <div class="space-y-10">
        {faqCategories.map((group) => (
          <div class="faq-group rounded-2xl border border-[#334468] bg-surface-2 p-5 sm:p-7 shadow-sm">
            <div class="flex items-center justify-between gap-3 mb-5 border-b border-[#334468]/60 pb-3.5">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl flex-shrink-0" aria-hidden="true">{group.icon}</span>
                <h3 class="text-lg sm:text-xl font-display font-bold text-white">{group.category}</h3>
