---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CoreValueProps from "../components/CoreValueProps.astro";

const allTools = await getCollection("tools");

const CATEGORY_ORDER = ["optimize", "create", "edit", "convert", "security"] as const;
const CATEGORY_LABEL: Record<string, string> = {
  optimize: "Optimize & Compress",
  create: "Create & Enhance",
  edit: "Edit, Crop & Transform",
  convert: "Format Converters",
  security: "Security & Privacy",
};

interface FAQItem {
  q: string;
  a: string;
}

interface FAQCategory {
  category: string;
  icon: string;
  badge: string;
  items: FAQItem[];
}

const faqCategories: FAQCategory[] = [
  {
    category: "Use Case / Intent-Based Solutions",
    icon: "🎯",
    badge: "High SEO Intent",
    items: [
      {
        q: "How do I reduce an image file size for email attachments?",
        a: "Use our Image Compressor to shrink file size while keeping visual quality clear and legible. Set a target limit (such as 100KB or 200KB) to ensure your photo stays well below email provider attachment limits like Gmail or Outlook 25MB caps."
      },
      {
        q: "How do I make an image smaller for a website without losing quality?",
        a: "Use our Resize and Compress tools together: first resize your image to its exact responsive display dimensions (e.g. 1200px max width for desktop hero banners), then compress it to modern WebP format. This slashes page payload and improves your Google Core Web Vitals (LCP) score."
      },
      {
        q: "What's the best image size for Instagram, Facebook, and LinkedIn posts?",
        a: "Use our Resize tool's built-in social presets: 1080×1080px for standard Instagram square (or 1080×1350px for portrait), 1200×630px for Facebook and LinkedIn link previews, and 1280×720px for YouTube video thumbnails."
      }
    ]
  },
  {
    category: "General & Trust",
    icon: "🔒",
    badge: "100% Free & Private",
    items: [
      {
        q: "Is there a limit to how many images I can edit per day?",
        a: "No, there's no daily limit. You can use our tools as many times as you need, completely free, with no restrictions on the number of images processed."
      },
      {
        q: "Do you store or save my uploaded images?",
        a: "No. Since all processing happens locally in your browser via HTML5 Canvas and WebAssembly, we never see, store, or have access to your images. Nothing is ever uploaded to our servers."
      },
      {
        q: "Is AllImageTools.com really 100% free forever?",
        a: "Yes, our core tools are free with no trial periods, credit limits, or hidden premium tiers."
      },
      {
        q: "Do you add watermarks to processed images?",
        a: "No. Your images are returned exactly as edited, with no watermarks, brand logos, or unwanted branding added."
      }
    ]
  },
  {
    category: "Resize Tool",
    icon: "📐",
    badge: "Dimensions & Presets",
    items: [
      {
        q: "What's the maximum image size I can resize?",
        a: "You can resize images up to 50MB per file and resolutions up to 8K (7680×4320px). Because all calculations execute directly on your device, you are never restricted by server upload limits."
      },
      {
        q: "Can I resize an image to exact pixel dimensions?",
        a: "Yes, you can enter custom width and height in pixels, scale proportionally by percentage, or choose from common presets (social media, print, web)."
      },
      {
        q: "Will resizing distort my image?",
        a: "No, you can lock the aspect ratio to prevent stretching or distortion, ensuring crisp and proportional scaling."
      }
    ]
  },
  {
    category: "Compress Tool",
    icon: "🗜️",
    badge: "KB Optimizer",
    items: [
      {
        q: "How much can I compress an image without losing quality?",
        a: "Our compressor typically reduces file size by 50–80% while maintaining visual quality, using adjustable compression settings and real-time target KB search."
      },
      {
        q: "What's the difference between lossy and lossless compression?",
        a: "Lossless compression reduces file size with zero quality loss (ideal for PNG graphics, vector logos, and screenshots); lossy compression allows a greater size reduction with a small, often unnoticeable quality trade-off (best for JPG and WebP photos). You can choose either."
      }
    ]
  },
  {
    category: "Crop Tool",
    icon: "✂️",
    badge: "Framing & Ratios",
    items: [
      {
        q: "Can I crop images to specific aspect ratios (1:1, 16:9, etc.)?",
        a: "Yes, preset aspect ratios are available for social media (1:1 square, 4:5 portrait, 16:9 widescreen), YouTube thumbnails, profile pictures, and custom freeform crops."
      },
      {
        q: "Can I crop multiple images to the same dimensions at once?",
        a: "Yes, batch cropping applies the same crop settings and aspect ratios across multiple images simultaneously."
      }
    ]
  },
  {
    category: "Format Conversion",
    icon: "🔄",
    badge: "HEIC, WebP, JPG, PNG",
    items: [
      {
        q: "Can I convert HEIC to JPG?",
        a: "Yes, our converter supports converting Apple iPhone HEIC and HEIF photos directly to JPG or PNG with full high-resolution preservation."
      },
      {
        q: "Can I convert PNG to WebP for faster website loading?",
        a: "Yes, WebP conversion is supported and recommended for improving website page speed and Google Core Web Vitals scores."
      },
      {
        q: "Does converting formats reduce image quality?",
        a: "Quality depends on the target format; we optimize default export profiles to minimize loss during conversion and retain alpha transparency when converting between PNG and WebP."
      }
    ]
  },
  {
    category: "OCR / Image to Text",
    icon: "📝",
    badge: "Text Extraction",
    items: [
      {
        q: "What languages does the OCR tool support?",
        a: "Our OCR tool supports over 100 languages, with optimized recognition models for English, Spanish, French, German, Italian, Portuguese, Chinese, Japanese, and Hindi."
      },
      {
        q: "Can OCR read handwritten text?",
        a: "Our OCR tool is optimized primarily for printed, typed, and scanned documents, signs, and screenshots. Legible block handwriting can often be recognized, but stylized cursive or low-contrast handwriting will have lower accuracy."
      },
      {
        q: "What image quality is needed for accurate OCR results?",
        a: "Clear, well-lit images with high-contrast, legible text produce the best results. Blurry, low-resolution, or heavily skewed images may reduce recognition accuracy."
      }
    ]
  },
  {
    category: "Technical / Compatibility",
    icon: "💻",
    badge: "Browser & Offline",
    items: [
      {
        q: "Which browsers are supported?",
        a: "Our tools work on all modern browsers, including Google Chrome, Mozilla Firefox, Apple Safari, Microsoft Edge, and Opera on desktop and mobile devices."
      },
      {
        q: "Do I need to install any software or extensions?",
        a: "No installation needed — everything runs directly in your web browser with zero software or extension downloads."
      },
      {
        q: "Does this work offline?",
        a: "Yes! Because the tools run 100% on client-side Web APIs, once you have opened the webpage, you can disconnect from Wi-Fi or go into airplane mode and continue editing images offline without network calls."
      }
    ]
  }
];

const allFaqsFlat = faqCategories.flatMap((c) => c.items);
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqsFlat.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a
    }
  }))
};
---
<BaseLayout
  title="ImageAll — Free Online Image Tools: Compress, Resize, Convert, Crop & More | XPlus Nexus"
  description="ImageAll by XPlus Nexus is a free all-in-one image toolkit: compress, resize, convert, crop, rotate, remove backgrounds, watermark, extract colors, and turn images into PDFs — right in your browser."
  canonicalPath="/"
>
  <!-- SEO WebApplication Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "ImageAll",
    url: "https://www.imagealltools.com/",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any (browser-based)",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", name: "XPlus Nexus", url: "https://www.xplusnexus.com" },
    description: "A free, browser-based suite of image tools: compress, resize, convert, crop, rotate, remove backgrounds, watermark, extract colors, and convert images to PDF. 100% on-device processing."
  })} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-14 md:py-20 border-b border-border">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-cyan/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-10 -right-20 w-96 h-96 bg-purple/15 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="wrap relative z-10 max-w-3xl">
      <p class="text-sm font-medium text-ink-muted mb-3.5">
        An <strong class="text-cyan font-semibold">XPlus Nexus</strong> product
      </p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight text-ink leading-tight">
        Every image tool you need, <span class="accent">in one place.</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-ink-muted leading-relaxed">
        Upload an image and every tool below actually processes it — compress, resize, convert, crop, remove backgrounds, watermark, extract colors, or export to PDF, all on your own device.
      </p>
      
      <div class="mt-6 rounded-xl border border-border bg-surface p-4 text-xs sm:text-sm text-ink-muted flex items-start gap-3 shadow-inner">
        <span class="text-cyan font-bold text-base leading-none mt-0.5">⚡</span>
        <div>
          <strong class="text-ink">100% Client-Side Private Engine:</strong> No images are uploaded to any server. Everything runs on your computer or phone using HTML5 Canvas & WebAssembly APIs.
        </div>
      </div>
    </div>
  </section>

  <!-- 🔥 HOT PLACE: Direct-Access Popular Tools -->
  <section class="py-12 border-b border-border bg-gradient-to-b from-[#0a0b0f] via-surface/60 to-[#0d0f17] relative overflow-hidden" id="hot-tools">
    <div class="wrap relative z-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan/10 border border-cyan/30 text-cyan text-xs font-bold uppercase tracking-wider mb-2">
            <span class="animate-pulse">🔥</span> Hot &amp; Most Used Tools
          </div>
          <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink">Direct Access Quick Launch</h2>
          <p class="text-xs sm:text-sm text-ink-muted mt-1 max-w-2xl leading-relaxed">
            Instant, one-click access to our highest-traffic tools: WhatsApp full DP maker, Instagram &amp; Facebook resizers, target KB compressor, multi-page PDF builder, and universal format converter.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a href="#catalog" class="btn btn-ghost text-xs px-3.5 py-2 rounded-xl whitespace-nowrap">
            View All 47 Tools →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <!-- 1. WhatsApp DP Maker -->
        <a href="/whatsapp-dp-maker" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-[#25D366]/70 hover:bg-[#101b14]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-[#25D366]/15 border border-[#25D366]/30 text-[#25D366] flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">💬</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30">WhatsApp Hot</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-[#25D366] transition-colors">WhatsApp Full DP Maker</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Fit any portrait or landscape photo into a 640×640 square profile picture with smooth blurred or gradient margins. Zero cropping!</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">640×640 HD · No Crop Blur</span>
            <span class="text-[#25D366] font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Launch Tool →</span>
          </div>
        </a>

        <!-- 2. Instagram Resizer -->
        <a href="/resize-image-for-instagram" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-[#E1306C]/70 hover:bg-[#1e111a]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-[#E1306C]/15 border border-[#E1306C]/30 text-[#E1306C] flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">📸</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#E1306C]/10 text-[#E1306C] border border-[#E1306C]/30">Instagram Hot</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-[#E1306C] transition-colors">Instagram Photo Resizer</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Resize for 1080×1080 Square, 1080×1350 Portrait, and 1080×1920 Story/Reels. Prevent Instagram compression &amp; clipping.</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">1:1 Square · 4:5 Portrait</span>
            <span class="text-[#E1306C] font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Launch Tool →</span>
          </div>
        </a>

        <!-- 3. Compress Image (Target KB) -->
        <a href="#compress" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-cyan/70 hover:bg-[#0b171f]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-cyan/15 border border-cyan/30 text-cyan flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">🗜️</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-cyan/10 text-cyan border border-cyan/30">Target KB</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-cyan transition-colors">Compress Image to KB</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Reduce photo file size by 50–80% with live target size calculation (20KB, 50KB, 100KB, 200KB) for strict web &amp; government form limits.</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">JPG · PNG · WebP</span>
            <span class="text-cyan font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Compress Now ↓</span>
          </div>
        </a>

        <!-- 4. Image to PDF Converter -->
        <a href="#to-pdf" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-purple/70 hover:bg-[#181124]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-purple/15 border border-purple/30 text-purple flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">📄</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-purple/10 text-purple border border-purple/30">Multi-Page PDF</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-purple transition-colors">Image to PDF Converter</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Combine multiple JPG, PNG, and WebP images into a single clean PDF document. Reorder pages, set A4/Letter size and custom DPI.</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">A4 · Letter · High DPI</span>
            <span class="text-purple font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Create PDF ↓</span>
          </div>
        </a>

        <!-- 5. Facebook Resizer -->
        <a href="/resize-image-for-facebook-post" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-[#1877F2]/70 hover:bg-[#0f1727]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-[#1877F2]/15 border border-[#1877F2]/30 text-[#1877F2] flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">👥</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#1877F2]/10 text-[#1877F2] border border-[#1877F2]/30">Facebook Hot</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-[#1877F2] transition-colors">Facebook Post &amp; Cover Resizer</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Resize images to exact 1200×630 feed link previews, 820×312 cover headers, and profile photos with zero compression blur.</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">1200×630 · 820×312 Headers</span>
            <span class="text-[#1877F2] font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Launch Tool →</span>
          </div>
        </a>

        <!-- 6. All Document & Format Converter -->
        <a href="#convert" class="group relative p-6 rounded-2xl border border-border bg-surface hover:border-[#00D084]/70 hover:bg-[#0c1a14]/80 transition-all duration-200 shadow-sm flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-xl bg-[#00D084]/15 border border-[#00D084]/30 text-[#00D084] flex items-center justify-center text-2xl font-bold group-hover:scale-110 transition-transform">🔄</span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#00D084]/10 text-[#00D084] border border-[#00D084]/30">All Formats</span>
            </div>
            <h3 class="text-lg font-display font-bold text-ink group-hover:text-[#00D084] transition-colors">All Document &amp; Format Converter</h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-2 leading-relaxed">Convert between PDF, HEIC (iPhone), PNG, JPG, WebP, AVIF, TIFF, and SVG. 100% private, instant in-browser conversion with zero quality loss.</p>
          </div>
          <div class="mt-5 pt-3.5 border-t border-border/50 flex items-center justify-between text-xs">
            <span class="text-ink-muted font-medium">PDF · HEIC · WebP · PNG</span>
            <span class="text-[#00D084] font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">Convert Files ↓</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Trusted by Creators Worldwide (Home page only) -->
  <section class="py-10 border-b border-border bg-[#0d0f17]">
    <div class="wrap">
      <div class="text-center max-w-xl mx-auto mb-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-purple">Proven Performance</span>
        <h2 class="text-xl sm:text-2xl font-display font-bold text-ink mt-1">Trusted by Creators Worldwide</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-center">
        <div class="p-5 rounded-2xl border border-border bg-surface shadow-sm">
          <div class="text-2xl sm:text-3xl font-display font-bold text-cyan">100K+</div>
          <div class="text-xs text-ink-muted mt-1 uppercase tracking-wider font-medium">Images Processed</div>
        </div>
        <div class="p-5 rounded-2xl border border-border bg-surface shadow-sm">
          <div class="text-2xl sm:text-3xl font-display font-bold text-purple">10K+</div>
          <div class="text-xs text-ink-muted mt-1 uppercase tracking-wider font-medium">Active Users</div>
        </div>
        <div class="p-5 rounded-2xl border border-border bg-surface shadow-sm">
          <div class="text-2xl sm:text-3xl font-display font-bold text-cyan">100%</div>
          <div class="text-xs text-ink-muted mt-1 uppercase tracking-wider font-medium">Free & In-Browser</div>
        </div>
        <div class="p-5 rounded-2xl border border-border bg-surface shadow-sm">
          <div class="text-2xl sm:text-3xl font-display font-bold text-purple">0 ms</div>
          <div class="text-xs text-ink-muted mt-1 uppercase tracking-wider font-medium">Server Upload Delay</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works (Three simple steps - on every page) -->
  <HowItWorks className="py-12 border-b border-border bg-[#08090c]" />

  <!-- Sticky Interactive Quick Tools Navigation -->
  <nav class="sticky top-[58px] z-30 border-b border-border bg-[#0a0b0f]/95 backdrop-blur-xl py-3.5 shadow-[0_8px_30px_rgba(0,0,0,0.5)]" aria-label="Jump to a tool" id="quick-jump-nav">
    <div class="wrap relative">
      <div class="flex items-center gap-3 overflow-x-auto py-1.5 no-scrollbar scroll-smooth" id="jump-scroll-container">
        <a
          href="/whatsapp-dp-maker"
          class="jump-pill group flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[#25D366]/40 bg-surface text-ink text-sm sm:text-base font-semibold hover:border-[#25D366] hover:bg-[#101b14] hover:text-[#25D366] transition-all duration-200 whitespace-nowrap shadow-sm"
        >
          <span class="text-base text-[#25D366] group-hover:scale-110 transition-transform">💬</span>
          <span>WhatsApp DP</span>
        </a>
        <a
          href="/resize-image-for-instagram"
          class="jump-pill group flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[#E1306C]/40 bg-surface text-ink text-sm sm:text-base font-semibold hover:border-[#E1306C] hover:bg-[#1e111a] hover:text-[#E1306C] transition-all duration-200 whitespace-nowrap shadow-sm"
        >
          <span class="text-base text-[#E1306C] group-hover:scale-110 transition-transform">📸</span>
          <span>Instagram</span>
        </a>
        <a
          href="/resize-image-for-facebook-post"
          class="jump-pill group flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-[#1877F2]/40 bg-surface text-ink text-sm sm:text-base font-semibold hover:border-[#1877F2] hover:bg-[#0f1727] hover:text-[#1877F2] transition-all duration-200 whitespace-nowrap shadow-sm"
        >
          <span class="text-base text-[#1877F2] group-hover:scale-110 transition-transform">👥</span>
          <span>Facebook</span>
        </a>
        <a
          href="#compress"
          data-jump="compress"
          class="jump-pill group flex items-center gap-2.5 px-4 py-2.5 rounded-xl border border-border bg-surface text-ink text-sm sm:text-base font-semibold hover:border-cyan hover:bg-surface-2 hover:text-cyan transition-all duration-200 whitespace-nowrap shadow-sm"
        >
          <span class="text-base text-cyan group-hover:scale-110 transition-transform">🗜️</span>
          <span>Compress</span>
        </a>
        <a
          href="#resize"
          data-jump="resize"
