---
const year = new Date().getFullYear();
---
<footer class="border-t border-border mt-20 pt-14 pb-8 bg-[#08090c] text-ink">
  <div class="wrap grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="md:col-span-1">
      <a class="brand flex items-center gap-2.5 font-display font-bold text-lg text-ink" href="https://www.xplusnexus.com">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>XPlus Nexus</span>
      </a>
      <p class="text-xs text-ink-muted mt-3 leading-relaxed max-w-sm">
        ImageAll is part of the XPlus Nexus product family. Free, privacy-first image tools designed to run 100% locally in your browser.
      </p>
      <div class="flex gap-2.5 mt-4 flex-wrap" aria-label="XPlus Nexus on social media">
        <a href="https://x.com/xplusnexus" aria-label="XPlus Nexus on X" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">𝕏</a>
        <a href="https://www.linkedin.com/company/xplusnexus" aria-label="XPlus Nexus on LinkedIn" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">in</a>
        <a href="https://github.com/xplusnexus" aria-label="XPlus Nexus on GitHub" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">GH</a>
        <a href="https://www.youtube.com/@xplusnexus" aria-label="XPlus Nexus on YouTube" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">▶</a>
        <a href="https://www.instagram.com/xplusnexus" aria-label="XPlus Nexus on Instagram" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">IG</a>
        <a href="https://www.facebook.com/xplusnexus" aria-label="XPlus Nexus on Facebook" rel="me noopener" target="_blank" class="w-8 h-8 rounded-lg border border-border flex items-center justify-center text-xs text-ink hover:border-cyan hover:text-cyan transition-colors">f</a>
      </div>
    </div>
    
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-muted mb-3 font-sans">Core Tools</h4>
      <ul class="space-y-2 text-xs text-ink/80">
        <li><a href="/image-compressor" class="hover:text-cyan transition-colors">Image Compressor</a></li>
        <li><a href="/image-resizer" class="hover:text-cyan transition-colors">Image Resizer</a></li>
        <li><a href="/image-cropper" class="hover:text-cyan transition-colors">Image Cropper</a></li>
        <li><a href="/background-remover" class="hover:text-cyan transition-colors">Remove Background</a></li>
        <li><a href="/rotate-image" class="hover:text-cyan transition-colors">Rotate & Flip</a></li>
      </ul>
    </div>
    
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-muted mb-3 font-sans">More Tools</h4>
      <ul class="space-y-2 text-xs text-ink/80">
        <li><a href="/add-watermark" class="hover:text-cyan transition-colors">Add Watermark</a></li>
        <li><a href="/image-to-pdf" class="hover:text-cyan transition-colors">Image to PDF</a></li>
        <li><a href="/color-palette" class="hover:text-cyan transition-colors">Color Palette Extractor</a></li>
        <li><a href="/blur-image" class="hover:text-cyan transition-colors">Blur Image</a></li>
        <li><a href="/#catalog" class="hover:text-cyan transition-colors">All 47 Tools Catalog</a></li>
      </ul>
    </div>
    
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-muted mb-3 font-sans">Company & Legal</h4>
      <ul class="space-y-2 text-xs text-ink/80">
        <li><a href="https://www.xplusnexus.com" target="_blank" class="hover:text-cyan transition-colors">XPlus Nexus Home</a></li>
        <li><a href="/privacy-policy" class="hover:text-cyan transition-colors">Privacy Policy</a></li>
        <li><a href="/terms-of-service" class="hover:text-cyan transition-colors">Terms of Service</a></li>
        <li><a href="/contact" class="hover:text-cyan transition-colors">Contact Support</a></li>
      </ul>
    </div>
  </div>
  
  <div class="wrap mt-10 pt-5 border-t border-border flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-ink-muted">
    <span>© {year} XPlus Nexus. All rights reserved.</span>
    <span>ImageAll — 100% Client-Side Private Image Toolkit. Hosted on Hostinger.</span>
  </div>
</footer>
