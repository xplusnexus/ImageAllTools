---
<footer class="relative mt-24 border-t border-border/80 bg-gradient-to-b from-[#0a0b0f] via-[#07080c] to-[#030406] text-ink overflow-hidden" role="contentinfo">
  <!-- Glowing top border accent -->
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-cyan/60 via-purple/50 to-transparent" aria-hidden="true"></div>

  <!-- Ambient light blooms -->
  <div class="absolute -top-32 left-1/4 w-[32rem] h-[32rem] bg-cyan/5 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 right-1/4 w-[32rem] h-[32rem] bg-purple/5 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>

  <div class="wrap relative z-10 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12">
      <!-- 1. Brand, Mission & Connect Column -->
      <div class="md:col-span-12 lg:col-span-4 flex flex-col justify-between">
        <div>
          <!-- Interactive Brand Anchor -->
          <a
            class="brand group inline-flex items-center gap-3.5 font-display font-bold text-xl text-ink hover:opacity-95 transition"
            href="https://www.xplusnexus.com"
            target="_blank"
            rel="noopener"
            aria-label="XPlus Nexus Official Website"
          >
            <div class="relative">
              <img
                src="/logo.png"
                alt="XPlus Nexus 3D Chrome Logo"
                class="w-12 h-12 rounded-2xl object-cover border border-cyan/50 p-0.5 bg-surface-2/90 shadow-[0_0_20px_rgba(38,224,255,0.25)] group-hover:scale-105 group-hover:border-cyan group-hover:shadow-[0_0_28px_rgba(38,224,255,0.45)] transition-all duration-300"
              />
              <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[#00D084] rounded-full border-2 border-[#0a0b0f]" title="Active Client-Side Engine"></span>
            </div>
            <div>
              <span class="text-xl tracking-tight text-white group-hover:text-cyan transition-colors">XPlus Nexus</span>
              <span class="text-[10px] font-bold tracking-widest uppercase text-cyan block opacity-90">Innovate · Build · Grow</span>
            </div>
          </a>

          <p class="text-xs sm:text-sm text-ink-muted mt-4 leading-relaxed max-w-sm">
            <strong class="text-ink">ImageAll</strong> is part of the XPlus Nexus product family. High-speed, privacy-first creative utilities engineered to run 100% locally in your browser with zero cloud file storage.
          </p>

          <!-- Security trust indicator badge -->
          <div class="mt-4 inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl border border-border/80 bg-surface/80 text-[11px] font-medium text-ink-muted shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#00D084] animate-pulse"></span>
            <span>Zero-Knowledge Engine · 0 ms Server Lag</span>
          </div>
        </div>

        <!-- 🔥 Interactive "Connect With XPlus Nexus" Hub -->
        <div class="mt-8 p-4 rounded-2xl border border-cyan/20 bg-gradient-to-br from-surface to-surface-2/60 shadow-[0_4px_24px_rgba(0,0,0,0.4)]">
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs">🌐</span>
              <span class="text-xs font-bold uppercase tracking-wider text-cyan font-display">
                Connect With XPlus Nexus
              </span>
            </div>
            <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full bg-cyan/10 text-cyan border border-cyan/25 animate-pulse">
              Official
            </span>
          </div>

          <p class="text-[11px] text-ink-muted mb-3.5 leading-relaxed">
            Follow our official product channels for feature drops, tutorials, and community releases:
          </p>

          <div class="grid grid-cols-6 gap-2" role="group" aria-label="XPlus Nexus social channels">
            {socials.map((s) => (
              <a
                href={s.href}
                aria-label={`Follow XPlus Nexus on ${s.name} (${s.handle})`}
                rel="me noopener"
                target="_blank"
                class={`group relative h-10 rounded-xl border border-border bg-[#0d0f17] flex items-center justify-center text-ink-muted hover:text-white transition-all duration-200 ${s.hoverBg} hover:scale-110 hover:-translate-y-0.5 active:scale-95 shadow-sm`}
                title={`${s.name} - ${s.handle}`}
              >
                <span class="transition-transform group-hover:scale-110" set:html={s.svg} />
                <!-- Tooltip badge -->
                <span class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-150 whitespace-nowrap text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#181b26] border border-border text-cyan shadow-lg z-20">
                  {s.name}
                </span>
              </a>
            ))}
          </div>

          <!-- Direct Link to XPlus Nexus Portal -->
          <a
            href="https://www.xplusnexus.com/"
            target="_blank"
            rel="noopener"
            class="mt-3.5 group flex items-center justify-between px-3 py-2 rounded-xl border border-border/80 bg-surface/90 hover:border-cyan/50 hover:bg-surface-2 text-xs font-semibold text-ink transition-all"
          >
            <span class="text-ink-muted group-hover:text-cyan transition-colors">Explore XPlusNexus.com Ecosystem</span>
            <span class="text-cyan group-hover:translate-x-1 transition-transform">↗</span>
          </a>
        </div>
      </div>

      <!-- 2. Core Tools Column -->
      <div class="md:col-span-4 lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-cyan mb-4 font-sans flex items-center gap-2">
          <span>⚡</span>
          <span>Core Tools</span>
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {coreTools.map((t) => (
            <li>
              <a
                href={t.href}
                class="group flex items-center justify-between gap-2 text-ink-muted hover:text-ink hover:translate-x-1 transition-all duration-200 py-1"
              >
                <span class="group-hover:text-cyan transition-colors">{t.label}</span>
                {t.badge && (
                  <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-surface-2 border border-border text-cyan">
                    {t.badge}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 3. More Tools & Popular Suites Column -->
      <div class="md:col-span-4 lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-purple mb-4 font-sans flex items-center gap-2">
          <span>🛠️</span>
          <span>Popular Suites</span>
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {moreTools.map((t) => (
            <li>
              <a
                href={t.href}
                class={`group flex items-center justify-between gap-2 py-1 transition-all duration-200 hover:translate-x-1 ${
                  t.highlight
                    ? "font-bold text-cyan hover:brightness-125"
                    : "text-ink-muted hover:text-ink"
                }`}
              >
                <span class={t.highlight ? "text-cyan" : "group-hover:text-purple transition-colors"}>
                  {t.label}
                </span>
                {t.badge && (
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-md border ${
                    t.badgeClass || "bg-surface-2 border-border text-purple"
                  }`}>
                    {t.badge}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 4. Company & Legal Column -->
      <div class="md:col-span-4 lg:col-span-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-4 font-sans flex items-center gap-2">
          <span>🏢</span>
          <span>Company &amp; Legal</span>
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {companyLinks.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "noopener" : undefined}
                class="group flex items-center gap-1.5 text-ink-muted hover:text-cyan hover:translate-x-1 transition-all duration-200 py-1"
              >
                <span>{c.label}</span>
                {c.external && (
                  <span class="text-[10px] text-ink-muted group-hover:text-cyan" aria-hidden="true">↗</span>
                )}
              </a>
            </li>
          ))}
        </ul>

        <!-- Direct Contact card with 1-click copy -->
        <div class="mt-6 p-3.5 rounded-xl border border-border/80 bg-surface-2/40 text-[11px] text-ink-muted leading-relaxed">
          <strong class="text-ink font-semibold block mb-0.5">Need a Custom Tool?</strong>
          <span>Reach out at: </span>
          <button
            type="button"
            id="copy-contact-email"
            class="text-cyan font-medium hover:underline inline-flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0"
            title="Click to copy contact email"
          >
            <span id="contact-email-text">support@xplusnexus.com</span>
            <span id="contact-copy-badge" class="text-[9px] px-1.5 py-0.2 rounded bg-cyan/15 text-cyan border border-cyan/30">copy</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Trust Bar -->
    <div class="mt-14 pt-6 border-t border-border/70 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-ink-muted">
      <div class="flex items-center gap-2.5 flex-wrap justify-center sm:justify-start">
        <span>© {year} <strong class="text-ink">XPlus Nexus</strong>. All rights reserved.</span>
        <span class="hidden sm:inline text-border">•</span>
        <span class="inline-flex items-center gap-1.5">
          <span class="text-cyan">⚡</span>
          <span>Hosted on Hostinger Business Cloud</span>
        </span>
      </div>

      <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-end">
        <span class="text-[11px] text-ink-muted/80">100% Client-Side WebAssembly &amp; HTML5 Canvas</span>
        <button
          type="button"
          id="footer-back-to-top"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border border-border bg-surface text-ink hover:border-cyan hover:text-cyan transition-all text-xs cursor-pointer shadow-sm active:scale-95"
          aria-label="Scroll back to top"
        >
          <span>Top</span>
          <span>↑</span>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Smooth scroll back to top button
  document.getElementById("footer-back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Interactive 1-click email copy
  const copyBtn = document.getElementById("copy-contact-email");
  const copyBadge = document.getElementById("contact-copy-badge");
  copyBtn?.addEventListener("click", () => {
    navigator.clipboard?.writeText("support@xplusnexus.com").then(() => {
      if (copyBadge) {
        copyBadge.textContent = "copied!";
        copyBadge.classList.add("bg-[#00D084]/20", "text-[#00D084]", "border-[#00D084]/40");
        setTimeout(() => {
          copyBadge.textContent = "copy";
          copyBadge.classList.remove("bg-[#00D084]/20", "text-[#00D084]", "border-[#00D084]/40");
        }, 2000);
      }
    });
  });
</script>
