    hoverBg: "hover:bg-gradient-to-tr hover:from-[#f09433]/20 hover:via-[#dc2743]/20 hover:to-[#bc1888]/20 hover:border-[#E1306C] hover:text-[#E1306C] hover:shadow-[0_0_16px_rgba(225,48,108,0.4)]",
