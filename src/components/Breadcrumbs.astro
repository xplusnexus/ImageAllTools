---
export interface Props {
  category: string;
  toolTitle: string;
}
const { category, toolTitle } = Astro.props;
const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.imagealltools.com/" },
    { "@type": "ListItem", position: 2, name: categoryLabel, item: `https://www.imagealltools.com/#${category}` },
    { "@type": "ListItem", position: 3, name: toolTitle },
  ],
};
---
<nav class="text-xs text-ink-muted mb-3 flex items-center gap-1.5 flex-wrap" aria-label="Breadcrumb">
  <a href="/" class="hover:text-cyan transition-colors">Home</a>
  <span>/</span>
  <a href={`/#${category}`} class="hover:text-cyan transition-colors">{categoryLabel}</a>
  <span>/</span>
  <span class="text-ink font-medium" aria-current="page">{toolTitle}</span>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
