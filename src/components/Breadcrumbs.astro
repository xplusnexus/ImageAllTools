---
export interface Props {
  category: string;
  toolTitle: string;
}
const { category, toolTitle } = Astro.props;
const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.imagealltools.com/" },
    { "@type": "ListItem", position: 2, name: categoryLabel, item: `https://www.imagealltools.com/#${category}` },
    { "@type": "ListItem", position: 3, name: toolTitle },
  ],
};
---
<nav class="text-xs sm:text-sm text-slate-200 mb-3.5 flex items-center gap-2 flex-wrap font-medium" aria-label="Breadcrumb">
  <a href="/" class="hover:text-cyan text-slate-200 transition-colors">Home</a>
  <span class="text-cyan/60 font-bold">/</span>
  <a href={`/#${category}`} class="hover:text-cyan text-slate-200 transition-colors">{categoryLabel}</a>
  <span class="text-cyan/60 font-bold">/</span>
  <span class="text-white font-bold" aria-current="page">{toolTitle}</span>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
