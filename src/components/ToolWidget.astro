<script>
  (function () {
    const ws = document.getElementById("active-tool-workspace");
    if (!ws) return;

    const mode = ws.getAttribute("data-tool-mode") || "compress";
    const defaultTargetKB = Number(ws.getAttribute("data-target-kb")) || 100;
    const defaultW = Number(ws.getAttribute("data-default-w")) || 0;
    const defaultH = Number(ws.getAttribute("data-default-h")) || 0;
    const defaultFmt = ws.getAttribute("data-default-fmt") || "image/jpeg";

    const drop = document.getElementById("tw-drop");
    const input = document.getElementById("tw-input") as HTMLInputElement;
    const preview = document.getElementById("tw-preview");
    const canvas = document.getElementById("tw-canvas") as HTMLCanvasElement;
    const ctx = canvas ? canvas.getContext("2d") : null;
    const downloadBtn = document.getElementById("tw-download") as HTMLButtonElement;
    const resetBtn = document.getElementById("tw-reset") as HTMLButtonElement;
    const statusEl = document.getElementById("tw-status");

    let currentFile: File | null = null;
    let srcImg: HTMLImageElement | null = null;
    let lastBlob: Blob | null = null;
    let pdfItems: Array<{ file: File; url: string; img: HTMLImageElement }> = [];

    function setStatus(msg: string, cls?: string) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = "status" + (cls ? " " + cls : "");
    }

    function fmtBytes(n: number) {
      if (n < 1024) return n + " B";
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
      return (n / (1024 * 1024)).toFixed(2) + " MB";
    }

    function downloadBlob(blob: Blob, filename: string) {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      try {
        const count = parseInt(localStorage.getItem('imageall_user_processed') || '0', 10) + 1;
        localStorage.setItem('imageall_user_processed', count.toString());
        window.dispatchEvent(new CustomEvent('imageall:processed', { detail: { count } }));
      } catch (e) {}
    }

    function loadImage(file: File): Promise<{ img: HTMLImageElement; url: string }> {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => resolve({ img, url });
        img.onerror = reject;
        img.src = url;
      });
    }

    // Init dropzone
    if (drop && input) {
      drop.addEventListener("click", () => input.click());
      drop.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); }
      });
      drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("drag"); });
      drop.addEventListener("dragleave", () => drop.classList.remove("drag"));
      drop.addEventListener("drop", (e) => {
        e.preventDefault();
        drop.classList.remove("drag");
        if (e.dataTransfer && e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
      });
      input.addEventListener("change", () => {
        if (input.files && input.files.length) handleFiles(input.files);
      });
    }

    function handleFiles(files: FileList) {
      if (mode === "pdf") {
        Array.from(files).forEach((f) => {
          loadImage(f).then((r) => {
            pdfItems.push({ file: f, url: r.url, img: r.img });
            renderPdfList();
          });
        });
        if (preview) preview.style.display = "grid";
        return;
      }

      if (mode === "collage") {
        const fileArr = Array.from(files);
        Promise.all(fileArr.map((f) => loadImage(f).then((r) => ({ file: f, url: r.url, img: r.img }))))
          .then((loaded) => {
            collageItems.push(...loaded);
            renderCollage();
            renderCollageThumbs();
          })
          .catch(() => {
            setStatus("Some images could not be loaded.", "err");
          });
        if (preview) preview.style.display = "grid";
        return;
      }

      if (mode === "html-to-image") {
        currentFile = files[0];
        const reader = new FileReader();
        reader.onload = (e) => {
          const b64 = e.target?.result as string;
          const outEl = document.getElementById("tw-b64-output") as HTMLTextAreaElement;
          const sizeEl = document.getElementById("tw-b64-size");
          const imgTagEl = document.getElementById("tw-b64-img-tag") as HTMLTextAreaElement;
          const cssTagEl = document.getElementById("tw-b64-css-tag") as HTMLTextAreaElement;
          if (outEl) outEl.value = b64;
          if (sizeEl) sizeEl.textContent = `${fmtBytes(b64.length)} (${b64.length.toLocaleString()} chars)`;
          if (imgTagEl) imgTagEl.value = `<img src="${b64}" alt="Embedded Image" />`;
          if (cssTagEl) cssTagEl.value = `background-image: url("${b64}");`;
        };
        reader.readAsDataURL(currentFile);

        loadImage(currentFile).then((r) => {
          srcImg = r.img;
          if (canvas && ctx) {
            canvas.width = r.img.naturalWidth;
            canvas.height = r.img.naturalHeight;
            ctx.drawImage(r.img, 0, 0);
          }
          if (preview) preview.style.display = "grid";
          setStatus(`Loaded image (${r.img.naturalWidth}×${r.img.naturalHeight}px) & generated Base64 Data URI!`, "ok");
        }).catch(() => {
          setStatus("Could not load image.", "err");
        });
        return;
      }

      currentFile = files[0];
      loadImage(currentFile).then((r) => {
        srcImg = r.img;
        if (canvas && ctx) {
          canvas.width = r.img.naturalWidth;
          canvas.height = r.img.naturalHeight;
          ctx.drawImage(r.img, 0, 0);
        }
        if (preview) preview.style.display = "grid";
        setupInitialMode();
      }).catch(() => {
        setStatus("Could not decode image in browser. Please try another format.", "err");
      });
    }

    // ================= SPECIFIC MODE BEHAVIORS ================= //

    // 1. COMPRESS
    let cmpMode = ws.getAttribute("data-tool-slug")?.includes("kb") ? "target" : "quality";
    const qEl = document.getElementById("tw-cmp-q") as HTMLInputElement;
    const qVal = document.getElementById("tw-cmp-q-val");
    const tEl = document.getElementById("tw-cmp-t") as HTMLInputElement;
    const fmtEl = document.getElementById("tw-cmp-fmt") as HTMLSelectElement;

    async function encodeCanvas(quality: number, type: string): Promise<Blob | null> {
      if (!canvas) return null;
      return new Promise((resolve) => {
        canvas.toBlob(resolve, type, type === "image/png" ? undefined : quality);
      });
    }

    async function refreshCompress() {
      if (!srcImg || !currentFile || !canvas) return;
      const type = fmtEl ? fmtEl.value : "image/jpeg";
      let blob: Blob | null = null;
      let finalQ = 0.8;

      if (cmpMode === "target" && tEl && type !== "image/png") {
        const targetBytes = (Number(tEl.value) || 100) * 1024;
        let low = 0.05, high = 1.0;
        for (let i = 0; i < 9; i++) {
          const mid = (low + high) / 2;
          const candidate = await encodeCanvas(mid, type);
          if (!candidate) break;
          if (candidate.size <= targetBytes) {
            blob = candidate;
            finalQ = mid;
            low = mid;
          } else {
            high = mid;
          }
        }
        if (!blob) blob = await encodeCanvas(low, type);
      } else {
        finalQ = (qEl ? Number(qEl.value) : 80) / 100;
        blob = await encodeCanvas(finalQ, type);
      }

      lastBlob = blob;
      if (blob && currentFile) {
        const origSizeEl = document.getElementById("tw-cmp-orig");
        const newSizeEl = document.getElementById("tw-cmp-new");
        const qMetric = document.getElementById("tw-cmp-metric-q");
        const redEl = document.getElementById("tw-cmp-red");
        if (origSizeEl) origSizeEl.textContent = fmtBytes(currentFile.size);
        if (newSizeEl) newSizeEl.textContent = fmtBytes(blob.size);
        if (qMetric) qMetric.textContent = Math.round(finalQ * 100) + "%";
        if (redEl) {
          const redPct = Math.max(0, (1 - blob.size / currentFile.size) * 100).toFixed(1);
          redEl.textContent = redPct + "%";
        }
        setStatus(`Output size: ${fmtBytes(blob.size)} (${Math.round(finalQ * 100)}% quality). Ready to download.`, "ok");
      }
    }

    if (qEl && qVal) {
      qEl.addEventListener("input", () => {
        qVal.textContent = qEl.value;
        if (cmpMode === "quality") refreshCompress();
      });
    }

    const qModeBtn = document.getElementById("tw-cmp-q-mode");
    const tModeBtn = document.getElementById("tw-cmp-t-mode");
    if (qModeBtn && tModeBtn) {
      qModeBtn.addEventListener("click", () => {
        cmpMode = "quality";
        qModeBtn.classList.add("active");
        tModeBtn.classList.remove("active");
        if (qEl) qEl.disabled = false;
        if (tEl) tEl.disabled = true;
        const qField = document.getElementById("tw-cmp-q-field");
        const tField = document.getElementById("tw-cmp-t-field");
        if (qField) qField.style.opacity = "1";
        if (tField) tField.style.opacity = "1";
        refreshCompress();
      });
      tModeBtn.addEventListener("click", () => {
        cmpMode = "target";
        tModeBtn.classList.add("active");
        qModeBtn.classList.remove("active");
        if (qEl) qEl.disabled = true;
        if (tEl) tEl.disabled = false;
        const qField = document.getElementById("tw-cmp-q-field");
        const tField = document.getElementById("tw-cmp-t-field");
        if (qField) qField.style.opacity = "1";
        if (tField) tField.style.opacity = "1";
        refreshCompress();
      });
    }

    document.querySelectorAll("[data-kb]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kb = btn.getAttribute("data-kb") || "100";
        if (tEl) tEl.value = kb;
        document.querySelectorAll("[data-kb]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        if (tModeBtn) tModeBtn.click();
      });
    });

    if (fmtEl) fmtEl.addEventListener("change", refreshCompress);
    if (tEl) tEl.addEventListener("input", refreshCompress);

    // 2. RESIZE
    const resW = document.getElementById("tw-res-w") as HTMLInputElement;
    const resH = document.getElementById("tw-res-h") as HTMLInputElement;
    const resLock = document.getElementById("tw-res-lock") as HTMLInputElement;
    const resPct = document.getElementById("tw-res-pct") as HTMLInputElement;
    const resPctVal = document.getElementById("tw-res-pct-val");
    const resFitEl = document.getElementById("tw-res-fit") as HTMLSelectElement;
    const resPadEl = document.getElementById("tw-res-pad") as HTMLInputElement;
    const resPadVal = document.getElementById("tw-res-pad-val");
    const resApply = document.getElementById("tw-res-apply");

    function renderResize() {
      if (!srcImg || !canvas || !ctx) return;
      const targetW = Math.max(1, Number(resW?.value) || srcImg.naturalWidth);
      const targetH = Math.max(1, Number(resH?.value) || srcImg.naturalHeight);
      const fitMode = resFitEl?.value || (ws?.getAttribute("data-tool-slug")?.includes("instagram") ? "blur" : "stretch");
      const padPct = (Number(resPadEl?.value) || 0) / 100;

      canvas.width = targetW;
      canvas.height = targetH;
      ctx.clearRect(0, 0, targetW, targetH);

      const srcW = srcImg.naturalWidth;
      const srcH = srcImg.naturalHeight;

      if (fitMode === "stretch") {
        ctx.drawImage(srcImg, 0, 0, targetW, targetH);
      } else if (fitMode === "cover") {
        const scale = Math.max(targetW / srcW, targetH / srcH);
        const dw = srcW * scale;
        const dh = srcH * scale;
        const dx = (targetW - dw) / 2;
        const dy = (targetH - dh) / 2;
        ctx.drawImage(srcImg, dx, dy, dw, dh);
      } else {
        // "blur", "white", "black"
        if (fitMode === "blur") {
          ctx.save();
          ctx.filter = "blur(30px) brightness(0.85)";
          const bgScale = Math.max(targetW / srcW, targetH / srcH) * 1.1;
          const bgW = srcW * bgScale;
          const bgH = srcH * bgScale;
          ctx.drawImage(srcImg, (targetW - bgW) / 2, (targetH - bgH) / 2, bgW, bgH);
          ctx.restore();
        } else if (fitMode === "white") {
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, targetW, targetH);
        } else if (fitMode === "black") {
          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, targetW, targetH);
        }

        const availW = targetW * (1 - padPct * 2);
        const availH = targetH * (1 - padPct * 2);
        const fitScale = Math.min(availW / srcW, availH / srcH);
        const fgW = Math.round(srcW * fitScale);
        const fgH = Math.round(srcH * fitScale);
        const fgX = Math.round((targetW - fgW) / 2);
        const fgY = Math.round((targetH - fgH) / 2);

        if (fitMode === "blur" && (padPct > 0.02 || fgW < targetW || fgH < targetH)) {
          ctx.save();
          ctx.shadowColor = "rgba(0,0,0,0.38)";
          ctx.shadowBlur = 20;
          ctx.shadowOffsetY = 4;
          ctx.drawImage(srcImg, fgX, fgY, fgW, fgH);
          ctx.restore();
        } else {
          ctx.drawImage(srcImg, fgX, fgY, fgW, fgH);
        }
      }

      setStatus(`Resized to ${targetW}×${targetH}px (${fitMode === "blur" ? "No-Crop Blur" : fitMode === "cover" ? "Center Fill" : fitMode === "white" ? "White Borders" : fitMode === "black" ? "Black Letterbox" : "Exact Stretch"}). Ready to download.`, "ok");
    }

    if (resW && resH) {
      resW.addEventListener("input", () => {
        if (srcImg && resLock && resLock.checked && srcImg.naturalWidth) {
          const ratio = srcImg.naturalHeight / srcImg.naturalWidth;
          resH.value = String(Math.round(Number(resW.value) * ratio));
        }
        renderResize();
      });
      resH.addEventListener("input", () => {
        if (srcImg && resLock && resLock.checked && srcImg.naturalHeight) {
          const ratio = srcImg.naturalWidth / srcImg.naturalHeight;
          resW.value = String(Math.round(Number(resH.value) * ratio));
        }
        renderResize();
      });
    }

    if (resPct && resPctVal) {
      resPct.addEventListener("input", () => {
        resPctVal.textContent = resPct.value;
        if (srcImg) {
          const scale = Number(resPct.value) / 100;
          if (resW) resW.value = String(Math.round(srcImg.naturalWidth * scale));
          if (resH) resH.value = String(Math.round(srcImg.naturalHeight * scale));
          renderResize();
        }
      });
    }

    if (resFitEl) resFitEl.addEventListener("change", renderResize);
    if (resPadEl && resPadVal) {
      resPadEl.addEventListener("input", () => {
        resPadVal.textContent = resPadEl.value;
        renderResize();
      });
    }

    document.querySelectorAll("[data-preset-w]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const w = btn.getAttribute("data-preset-w") || "";
        const h = btn.getAttribute("data-preset-h") || "";
        if (resW) resW.value = w;
        if (resH) resH.value = h;
        if (resLock) resLock.checked = false;
        document.querySelectorAll("[data-preset-w]").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        renderResize();
      });
    });

    if (resApply) {
      resApply.addEventListener("click", renderResize);
    }

    // 3. CROP
    let cropBox: { x: number; y: number; w: number; h: number } | null = null;
    let isDragging = false;
    let isMoving = false;
    let moveStartX = 0, moveStartY = 0, boxStartX = 0, boxStartY = 0;
    let startX = 0, startY = 0;
    let cropRatio: number | "free" = "free";
    let cropShape: "rect" | "circle" = "rect";

    const cropShapeEl = document.getElementById("tw-crop-shape") as HTMLSelectElement;
    const cropFmtEl = document.getElementById("tw-crop-fmt") as HTMLSelectElement;
    const cropDimsEl = document.getElementById("tw-crop-dims");
    const cropCenterBtn = document.getElementById("tw-crop-center-btn");

    function drawCropOverlay() {
      if (!srcImg || !canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(srcImg, 0, 0);

      if (cropBox && Math.abs(cropBox.w) > 2 && Math.abs(cropBox.h) > 2) {
        const bx = Math.min(cropBox.x, cropBox.x + cropBox.w);
        const by = Math.min(cropBox.y, cropBox.y + cropBox.h);
        const bw = Math.abs(cropBox.w);
        const bh = Math.abs(cropBox.h);

        ctx.save();
        // Dim outside area
        ctx.fillStyle = "rgba(0, 0, 0, 0.58)";
        ctx.beginPath();
        ctx.rect(0, 0, canvas.width, canvas.height);

        if (cropShape === "circle") {
          const cx = bx + bw / 2;
          const cy = by + bh / 2;
          const rx = bw / 2;
          const ry = bh / 2;
          ctx.ellipse(cx, cy, Math.max(1, rx), Math.max(1, ry), 0, 0, Math.PI * 2, true);
          ctx.fill();

          // Stroke circular border
          ctx.strokeStyle = "#26e0ff";
          ctx.lineWidth = 2.5;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.ellipse(cx, cy, Math.max(1, rx), Math.max(1, ry), 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);
        } else {
          ctx.rect(bx + bw, by, -bw, bh);
          ctx.fill();

          // Stroke rectangular border
          ctx.strokeStyle = "#26e0ff";
          ctx.lineWidth = 2;
          ctx.strokeRect(bx, by, bw, bh);

          // Rule of thirds grid
          ctx.strokeStyle = "rgba(38, 224, 255, 0.35)";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(bx + bw / 3, by);
          ctx.lineTo(bx + bw / 3, by + bh);
          ctx.moveTo(bx + (bw * 2) / 3, by);
          ctx.lineTo(bx + (bw * 2) / 3, by + bh);
          ctx.moveTo(bx, by + bh / 3);
          ctx.lineTo(bx + bw, by + bh / 3);
          ctx.moveTo(bx, by + (bh * 2) / 3);
          ctx.lineTo(bx + bw, by + (bh * 2) / 3);
          ctx.stroke();

          // Corner handles
          const hs = 8;
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(bx, by, hs, hs);
          ctx.fillRect(bx + bw - hs, by, hs, hs);
          ctx.fillRect(bx, by + bh - hs, hs, hs);
          ctx.fillRect(bx + bw - hs, by + bh - hs, hs, hs);
        }
        ctx.restore();

        if (cropDimsEl) {
          const ratioStr = (bw / (bh || 1)).toFixed(2);
          cropDimsEl.textContent = `${Math.round(bw)} × ${Math.round(bh)} px (${ratioStr}:1)`;
        }
      } else {
        if (cropDimsEl) cropDimsEl.textContent = "Draw box or select preset";
      }
    }

    function setCenterCrop(ratio: number | "free") {
      if (!canvas) return;
      let w = canvas.width * 0.8;
      let h = canvas.height * 0.8;
      if (ratio !== "free") {
        h = w / ratio;
        if (h > canvas.height * 0.8) {
          h = canvas.height * 0.8;
          w = h * ratio;
        }
      }
      cropBox = {
        x: Math.round((canvas.width - w) / 2),
        y: Math.round((canvas.height - h) / 2),
        w: Math.round(w),
        h: Math.round(h),
      };
      drawCropOverlay();
      if (cropDimsEl) {
        cropDimsEl.textContent = `${Math.round(w)} × ${Math.round(h)} px`;
      }
    }

    if (canvas && mode === "crop") {
      const getPos = (e: MouseEvent | Touch) => {
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        return { x: (e.clientX - rect.left) * sx, y: (e.clientY - rect.top) * sy };
      };

      const handlePointerDown = (pos: { x: number; y: number }) => {
        if (!srcImg) return;
        // Check if inside existing box to drag/move
        if (cropBox && Math.abs(cropBox.w) > 4 && Math.abs(cropBox.h) > 4) {
          const bx = Math.min(cropBox.x, cropBox.x + cropBox.w);
          const by = Math.min(cropBox.y, cropBox.y + cropBox.h);
          const bw = Math.abs(cropBox.w);
          const bh = Math.abs(cropBox.h);
          if (pos.x >= bx && pos.x <= bx + bw && pos.y >= by && pos.y <= by + bh) {
            isMoving = true;
            moveStartX = pos.x;
            moveStartY = pos.y;
            boxStartX = bx;
            boxStartY = by;
            return;
          }
        }

        // Outside existing box: start new crop drag
        isDragging = true;
        startX = pos.x;
        startY = pos.y;
        cropBox = { x: startX, y: startY, w: 0, h: 0 };
      };

      const handlePointerMove = (pos: { x: number; y: number }) => {
        if (!srcImg || !canvas) return;
        if (isMoving && cropBox) {
          const dx = pos.x - moveStartX;
          const dy = pos.y - moveStartY;
          const bw = Math.abs(cropBox.w);
          const bh = Math.abs(cropBox.h);
          cropBox.x = Math.max(0, Math.min(canvas.width - bw, boxStartX + dx));
          cropBox.y = Math.max(0, Math.min(canvas.height - bh, boxStartY + dy));
          cropBox.w = bw;
          cropBox.h = bh;
          drawCropOverlay();
          return;
        }

        if (isDragging) {
          let curW = pos.x - startX;
          let curH = pos.y - startY;

          if (cropRatio !== "free") {
            const signX = curW >= 0 ? 1 : -1;
            const signY = curH >= 0 ? 1 : -1;
            const absW = Math.abs(curW);
            const absH = Math.abs(curH);
            curW = signX * Math.min(absW, absH * cropRatio);
            curH = signY * (Math.abs(curW) / cropRatio);
          }

          cropBox = {
            x: curW >= 0 ? startX : startX + curW,
            y: curH >= 0 ? startY : startY + curH,
            w: Math.abs(curW),
            h: Math.abs(curH),
          };
          drawCropOverlay();
        }
      };

      const handlePointerUp = () => {
        isDragging = false;
        isMoving = false;
        if (cropBox && Math.abs(cropBox.w) > 4 && Math.abs(cropBox.h) > 4) {
          setStatus(`Crop area selected (${Math.round(cropBox.w)}×${Math.round(cropBox.h)}px). Drag inside to move, or click Download.`, "ok");
        }
      };

      canvas.addEventListener("mousedown", (e) => handlePointerDown(getPos(e)));
      window.addEventListener("mousemove", (e) => handlePointerMove(getPos(e)));
      window.addEventListener("mouseup", handlePointerUp);

      canvas.addEventListener("touchstart", (e) => {
        if (e.touches.length === 1) {
          e.preventDefault();
          handlePointerDown(getPos(e.touches[0]));
        }
      }, { passive: false });

      window.addEventListener("touchmove", (e) => {
        if (e.touches.length === 1 && (isDragging || isMoving)) {
          handlePointerMove(getPos(e.touches[0]));
        }
      }, { passive: false });

      window.addEventListener("touchend", handlePointerUp);

      document.querySelectorAll("[data-crop-ratio]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!srcImg || !canvas) return;
          const r = btn.getAttribute("data-crop-ratio");
          document.querySelectorAll("[data-crop-ratio]").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          if (r === "free") {
            cropRatio = "free";
            setStatus("Freeform crop mode: drag on the image to create any custom rectangle.");
            if (!cropBox) setCenterCrop("free");
            else drawCropOverlay();
          } else {
            cropRatio = Number(r);
            setCenterCrop(cropRatio);
            setStatus(`Centered crop box locked to ratio (${Math.round(cropBox?.w || 0)}×${Math.round(cropBox?.h || 0)}px).`, "ok");
          }
        });
      });

      if (cropShapeEl) {
        cropShapeEl.addEventListener("change", () => {
          cropShape = (cropShapeEl.value as "rect" | "circle") || "rect";
          if (cropShape === "circle" && cropRatio === "free") {
            cropRatio = 1;
            const sqBtn = document.querySelector('[data-crop-ratio="1"]');
            if (sqBtn) {
              document.querySelectorAll("[data-crop-ratio]").forEach((b) => b.classList.remove("active"));
              sqBtn.classList.add("active");
            }
          }
          if (!cropBox) setCenterCrop(cropRatio);
          else drawCropOverlay();
          setStatus(`Crop shape set to ${cropShape === "circle" ? "⭕ Circle Avatar (Transparent PNG)" : "Rectangle"}.`, "ok");
        });
      }

      if (cropCenterBtn) {
        cropCenterBtn.addEventListener("click", () => {
          setCenterCrop(cropRatio);
          setStatus("Centered crop box reset to 80% canvas.", "ok");
        });
      }
    }

    // 4. ROTATE / FLIP
    let rotation = 0;
    let flipH = false, flipV = false;

    const rotLeft = document.getElementById("tw-rot-left");
    const rotRight = document.getElementById("tw-rot-right");
    const flipHBtn = document.getElementById("tw-flip-h");
    const flipVBtn = document.getElementById("tw-flip-v");
    const rotResetBtn = document.getElementById("tw-rot-reset");
    const flipStatusEl = document.getElementById("tw-flip-status");

    function renderRotate() {
      if (!srcImg || !canvas || !ctx) return;
      const w = srcImg.naturalWidth, h = srcImg.naturalHeight;
      const swapped = rotation % 180 !== 0;
      canvas.width = swapped ? h : w;
      canvas.height = swapped ? w : h;
      ctx.save();
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate((rotation * Math.PI) / 180);
      ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
      ctx.drawImage(srcImg, -w / 2, -h / 2);
      ctx.restore();

      const mirrorText = flipH ? "Mirror Horizontal: ON" : "Mirror: OFF";
      const vertText = flipV ? "Upside Down: ON" : "Vertical: Normal";
      if (flipStatusEl) {
        flipStatusEl.textContent = `${mirrorText} | ${vertText} | Rotation: ${rotation}°`;
      }
      setStatus(`Applied transformation (${flipH ? "Flipped Horizontally (Mirror). " : ""}${flipV ? "Flipped Vertically. " : ""}Angle: ${rotation}°). Ready to download.`, "ok");
    }

    if (rotLeft) rotLeft.addEventListener("click", () => { rotation = (rotation - 90 + 360) % 360; renderRotate(); });
    if (rotRight) rotRight.addEventListener("click", () => { rotation = (rotation + 90) % 360; renderRotate(); });
    if (flipHBtn) flipHBtn.addEventListener("click", () => { flipH = !flipH; renderRotate(); });
    if (flipVBtn) flipVBtn.addEventListener("click", () => { flipV = !flipV; renderRotate(); });
    if (rotResetBtn) rotResetBtn.addEventListener("click", () => {
      rotation = 0;
      flipH = false;
      flipV = false;
      renderRotate();
    });

    // 5. WATERMARK
    function renderWatermark() {
      if (!srcImg || !canvas || !ctx) return;
      canvas.width = srcImg.naturalWidth;
      canvas.height = srcImg.naturalHeight;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(srcImg, 0, 0);

      const text = (document.getElementById("tw-wm-text") as HTMLInputElement)?.value || "";
      const color = (document.getElementById("tw-wm-color") as HTMLInputElement)?.value || "#ffffff";
      const size = Number((document.getElementById("tw-wm-size") as HTMLInputElement)?.value) || 36;
      const opacity = (Number((document.getElementById("tw-wm-opacity") as HTMLInputElement)?.value) || 60) / 100;
      const pos = (document.getElementById("tw-wm-pos") as HTMLSelectElement)?.value || "bottom-right";

      const sizeVal = document.getElementById("tw-wm-size-val");
      const opVal = document.getElementById("tw-wm-opacity-val");
      if (sizeVal) sizeVal.textContent = String(size);
      if (opVal) opVal.textContent = String(Math.round(opacity * 100));

      const font = (document.getElementById("tw-wm-font") as HTMLSelectElement)?.value || "'Space Grotesk', sans-serif";
      const shadowChecked = (document.getElementById("tw-wm-shadow") as HTMLInputElement)?.checked ?? true;

      ctx.font = `bold ${size}px ${font}`;
      ctx.globalAlpha = opacity;

      const isMeme = ws.getAttribute("data-tool-slug")?.includes("meme");
      const bottomTextEl = document.getElementById("tw-meme-bottom") as HTMLInputElement;
      const bottomText = isMeme && bottomTextEl ? bottomTextEl.value : "";

      if (isMeme) {
        ctx.textAlign = "center";
        const strokeW = Math.max(3, size * 0.12);

        if (text) {
          const topY = Math.max(20, canvas.height * 0.04);
          ctx.textBaseline = "top";
          if (shadowChecked) {
            ctx.strokeStyle = "#000000";
            ctx.lineWidth = strokeW;
            ctx.lineJoin = "round";
            ctx.strokeText(text.toUpperCase(), canvas.width / 2, topY);
          }
          ctx.fillStyle = color;
          ctx.fillText(text.toUpperCase(), canvas.width / 2, topY);
        }

        if (bottomText) {
          const botY = canvas.height - Math.max(20, canvas.height * 0.04);
          ctx.textBaseline = "bottom";
          if (shadowChecked) {
            ctx.strokeStyle = "#000000";
            ctx.lineWidth = strokeW;
            ctx.lineJoin = "round";
            ctx.strokeText(bottomText.toUpperCase(), canvas.width / 2, botY);
          }
          ctx.fillStyle = color;
          ctx.fillText(bottomText.toUpperCase(), canvas.width / 2, botY);
        }
        return;
      }

      ctx.textAlign = "left";
      ctx.textBaseline = "alphabetic";
      const m = ctx.measureText(text);
      const pad = size * 0.6;

      if (pos === "tile") {
        ctx.save();
        ctx.rotate((-25 * Math.PI) / 180);
        const stepX = m.width + size * 3;
        const stepY = size * 4;
        for (let y = -canvas.height; y < canvas.height * 2; y += stepY) {
          for (let x = -canvas.width; x < canvas.width * 2; x += stepX) {
            if (shadowChecked) {
              ctx.strokeStyle = "rgba(0,0,0,0.8)";
              ctx.lineWidth = Math.max(2, size * 0.08);
              ctx.strokeText(text, x, y);
            }
            ctx.fillStyle = color;
            ctx.fillText(text, x, y);
          }
        }
        ctx.restore();
      } else {
        let x = (canvas.width - m.width) / 2;
        let y = (canvas.height + size * 0.35) / 2;

        if (pos === "bottom-right") { x = canvas.width - m.width - pad; y = canvas.height - pad; }
        else if (pos === "bottom-left") { x = pad; y = canvas.height - pad; }
        else if (pos === "bottom-center") { x = (canvas.width - m.width) / 2; y = canvas.height - pad; }
        else if (pos === "top-right") { x = canvas.width - m.width - pad; y = pad + size; }
        else if (pos === "top-left") { x = pad; y = pad + size; }
        else if (pos === "top-center") { x = (canvas.width - m.width) / 2; y = pad + size; }
        else if (pos === "center") { x = (canvas.width - m.width) / 2; y = (canvas.height + size * 0.35) / 2; }

        if (shadowChecked) {
          ctx.strokeStyle = "rgba(0,0,0,0.85)";
          ctx.lineWidth = Math.max(2, size * 0.08);
          ctx.lineJoin = "round";
          ctx.strokeText(text, x, y);
        }
        ctx.fillStyle = color;
        ctx.fillText(text, x, y);
      }
      ctx.globalAlpha = 1;
    }

    ["tw-wm-text", "tw-meme-bottom", "tw-wm-color", "tw-wm-size", "tw-wm-opacity", "tw-wm-pos", "tw-wm-font", "tw-wm-shadow"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener("input", renderWatermark);
    });

    // 6. COLOR PALETTE STUDIO & SEASONAL ANALYSIS
    let currentPaletteColors: number[][] = [];
    const palCountEl = document.getElementById("tw-pal-count") as HTMLSelectElement;
    const palFormatEl = document.getElementById("tw-pal-format") as HTMLSelectElement;
    const palSwatchesWrap = document.getElementById("tw-pal-swatches");
    const palContrastBox = document.getElementById("tw-pal-contrast");
    const palSeasonTitle = document.getElementById("tw-pal-season-title");
    const palSeasonDesc = document.getElementById("tw-pal-season-desc");
    const palSeasonBadge = document.getElementById("tw-pal-season-badge");
    const palSeasonIcon = document.getElementById("tw-pal-season-icon");

    const curatedPresets: Record<string, number[][]> = {
      "autumn": [[194, 65, 12], [234, 88, 12], [217, 119, 6], [202, 138, 4], [120, 53, 15], [67, 20, 7]],
      "soft-autumn": [[180, 115, 89], [214, 162, 137], [158, 119, 119], [132, 140, 127], [163, 140, 107], [92, 70, 58]],
      "deep-winter": [[15, 23, 42], [76, 29, 149], [136, 19, 55], [2, 132, 199], [248, 250, 252], [30, 41, 59]],
      "soft-summer": [[148, 163, 184], [192, 132, 252], [244, 114, 182], [147, 197, 253], [165, 180, 252], [226, 232, 240]],
      "bright-spring": [[244, 63, 94], [251, 146, 60], [250, 204, 21], [74, 222, 128], [56, 189, 248], [168, 85, 247]],
      "jewel": [[131, 24, 67], [88, 28, 135], [20, 83, 45], [12, 74, 110], [180, 83, 9], [76, 5, 25]],
      "green": [[20, 83, 45], [22, 101, 52], [21, 128, 61], [34, 197, 94], [134, 239, 172], [5, 46, 22]],
      "blue": [[12, 74, 110], [3, 105, 161], [2, 132, 199], [14, 165, 233], [56, 189, 248], [186, 230, 253]],
      "halloween": [[234, 88, 12], [249, 115, 22], [88, 28, 135], [17, 24, 39], [107, 114, 128], [254, 240, 138]],
      "viridis": [[68, 1, 84], [70, 50, 126], [54, 92, 141], [39, 127, 142], [31, 161, 135], [74, 193, 109]]
    };

    function rgbToHex(r: number, g: number, b: number): string {
      return "#" + [r, g, b].map((x) => Math.max(0, Math.min(255, Math.round(x))).toString(16).padStart(2, "0")).join("");
    }

    function rgbToHsl(r: number, g: number, b: number): string {
      const rn = r / 255, gn = g / 255, bn = b / 255;
      const max = Math.max(rn, gn, bn), min = Math.min(rn, gn, bn);
      let h = 0, s = 0;
      const l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case rn: h = (gn - bn) / d + (gn < bn ? 6 : 0); break;
          case gn: h = (bn - rn) / d + 2; break;
          case bn: h = (rn - gn) / d + 4; break;
        }
        h /= 6;
      }
      return `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
    }

    function formatColor(c: number[]): string {
      const fmt = palFormatEl?.value || "hex";
      if (fmt === "rgb") return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
      if (fmt === "hsl") return rgbToHsl(c[0], c[1], c[2]);
      return rgbToHex(c[0], c[1], c[2]);
    }

    function extractColors(targetCount = 6): number[][] {
      if (!canvas || !ctx || canvas.width === 0 || canvas.height === 0) {
        return curatedPresets["autumn"].slice(0, targetCount);
      }
      const w = canvas.width, h = canvas.height;
      try {
        const data = ctx.getImageData(0, 0, w, h).data;
        const buckets: Record<string, number> = {};
        const step = Math.max(1, Math.floor((w * h) / 45000));
        for (let i = 0; i < w * h; i += step) {
          const idx = i * 4;
          if (data[idx + 3] < 128) continue;
          const r = Math.round(data[idx] / 24) * 24;
          const g = Math.round(data[idx + 1] / 24) * 24;
          const b = Math.round(data[idx + 2] / 24) * 24;
          const key = `${r},${g},${b}`;
          buckets[key] = (buckets[key] || 0) + 1;
        }
        const sorted = Object.keys(buckets).sort((a, b) => buckets[b] - buckets[a]);
        const picked: number[][] = [];
        sorted.forEach((k) => {
          if (picked.length >= targetCount) return;
          const c = k.split(",").map(Number);
          const tooClose = picked.some((p) => Math.abs(p[0] - c[0]) + Math.abs(p[1] - c[1]) + Math.abs(p[2] - c[2]) < 55);
          if (!tooClose) picked.push(c);
        });
        if (picked.length < targetCount) {
          for (const fallback of curatedPresets["autumn"]) {
            if (picked.length >= targetCount) break;
            const tooClose = picked.some((p) => Math.abs(p[0] - fallback[0]) + Math.abs(p[1] - fallback[1]) + Math.abs(p[2] - fallback[2]) < 40);
            if (!tooClose) picked.push(fallback);
          }
        }
        return picked.slice(0, targetCount);
      } catch (e) {
        return curatedPresets["autumn"].slice(0, targetCount);
      }
    }

    function analyzeSeasonalPalette(colors: number[][]) {
      if (!palSeasonTitle || !palSeasonDesc || !palSeasonBadge || !palSeasonIcon || !colors.length) return;

      let totalR = 0, totalG = 0, totalB = 0;
      let totalLuminance = 0;
      colors.forEach((c) => {
        totalR += c[0];
        totalG += c[1];
        totalB += c[2];
        totalLuminance += 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2];
      });
      const avgR = totalR / colors.length;
      const avgB = totalB / colors.length;
      const avgLum = totalLuminance / colors.length;
      const warmth = avgR - avgB;

      let season = "Warm Autumn";
      let desc = "Warm earthy undertones with rich terracotta, amber, olive, and deep gold.";
      let badge = "True Autumn 🍂";
      let icon = "🍂";

      if (warmth > 20) {
        if (avgLum > 140) {
          season = "Bright Spring";
          desc = "Warm, vibrant, high-clarity tones with coral, sunny gold, peach, and fresh greens.";
          badge = "True Spring 🌸";
          icon = "🌸";
        } else if (warmth > 40 && avgLum < 110) {
          season = "Deep Autumn";
          desc = "Rich, dark, warm palette featuring spiced cinnamon, espresso, burnt orange, and maroon.";
          badge = "Deep Autumn 🍁";
          icon = "🍁";
        } else {
          season = "Soft / Warm Autumn";
          desc = "Muted earthy undertones, terracotta, warm taupe, and toasted caramel.";
          badge = "Soft Autumn 🍂";
          icon = "🍂";
        }
      } else if (warmth < -15) {
        if (avgLum < 110) {
          season = "Deep Winter";
          desc = "Cool, high-contrast, vivid tones including deep navy, royal cobalt, iced berry, and emerald.";
          badge = "Deep Winter ❄️";
          icon = "❄️";
        } else {
          season = "Soft Summer";
          desc = "Cool, delicate, powdery tones featuring lavender, rose, muted slate, and soft blue.";
          badge = "Soft Summer ☀️";
          icon = "☀️";
        }
      } else {
        if (avgLum > 135) {
          season = "Light Summer / Neutral";
          desc = "Soft pastel balance with cool delicate highlights, blush, and airy neutrals.";
          badge = "Light Summer ⛅";
          icon = "⛅";
        } else {
          season = "Dark / Jewel Tones";
          desc = "Saturated balance with sapphire, ruby, emerald, and charcoal contrast.";
          badge = "Jewel Tones 💎";
          icon = "💎";
        }
      }

      palSeasonTitle.textContent = `Color Season Analysis: ${season}`;
      palSeasonDesc.textContent = desc;
      palSeasonBadge.textContent = badge;
      palSeasonIcon.textContent = icon;
    }

    function renderPalette(keepExistingColors = false) {
      if (!palSwatchesWrap) return;
      const count = Number(palCountEl?.value) || 6;

      if (!keepExistingColors || currentPaletteColors.length === 0) {
        currentPaletteColors = extractColors(count);
      } else if (currentPaletteColors.length !== count) {
        if (currentPaletteColors.length < count) {
          const fresh = extractColors(count);
          currentPaletteColors = fresh;
        } else {
          currentPaletteColors = currentPaletteColors.slice(0, count);
        }
      }

      palSwatchesWrap.innerHTML = "";
      let selected: Array<{ hex: string; formatted: string; rgb: number[]; el: HTMLElement }> = [];

      currentPaletteColors.forEach((c) => {
        const hex = rgbToHex(c[0], c[1], c[2]);
        const formatted = formatColor(c);
        const el = document.createElement("div");
        el.className = "swatch";
        el.innerHTML = `<div class="swatch-color" style="background:${hex}"></div><span class="text-[11px] font-mono select-all">${formatted}</span>`;

        el.addEventListener("click", () => {
          navigator.clipboard?.writeText(formatted).catch(() => {});
          if (selected.length === 2) selected = [];
          selected.push({ hex, formatted, rgb: c, el });
          document.querySelectorAll(".swatch").forEach((s) => s.classList.remove("selected"));
          selected.forEach((s) => s.el.classList.add("selected"));

          if (palContrastBox) {
            if (selected.length === 2) {
              const l = (rgb: number[]) => {
                const a = rgb.map((v) => {
                  const s = v / 255;
                  return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
                });
                return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
              };
              const l1 = l(selected[0].rgb) + 0.05;
              const l2 = l(selected[1].rgb) + 0.05;
              const ratio = l1 > l2 ? l1 / l2 : l2 / l1;
              const passesAA = ratio >= 4.5;
              const passesAAA = ratio >= 7.0;
              const rating = passesAAA ? "Passes AAA (Large & Small Text)" : passesAA ? "Passes AA (Normal Text)" : "Fails WCAG AA (Low Contrast)";
              palContrastBox.innerHTML = `<strong>${selected[0].hex}</strong> on <strong>${selected[1].hex}</strong> — Contrast Ratio: <strong>${ratio.toFixed(2)}:1</strong> (<span class="${passesAA ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}">${rating}</span>).`;
            } else {
              palContrastBox.textContent = `Copied ${formatted}! Click a second swatch to test WCAG AA / AAA contrast.`;
            }
          }
        });
        palSwatchesWrap.appendChild(el);
      });

      analyzeSeasonalPalette(currentPaletteColors);
      setStatus(`Palette updated with ${currentPaletteColors.length} swatches. Click swatches to copy or test contrast.`, "ok");
    }

    // Palette Presets and Eyedropper Listeners
    document.querySelectorAll("[data-pal-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-pal-preset") || "autumn";
        if (curatedPresets[key]) {
          const count = Number(palCountEl?.value) || 6;
          currentPaletteColors = curatedPresets[key].slice(0, count);
          renderPalette(true);
          document.querySelectorAll("[data-pal-preset]").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        }
      });
    });

    const palRandomBtn = document.getElementById("tw-pal-random-btn");
    if (palRandomBtn) {
      palRandomBtn.addEventListener("click", () => {
        const count = Number(palCountEl?.value) || 6;
        const baseHue = Math.floor(Math.random() * 360);
        const generated: number[][] = [];
        for (let i = 0; i < count; i++) {
          const h = (baseHue + i * (360 / count) + Math.floor(Math.random() * 20 - 10) + 360) % 360;
          const s = 0.45 + Math.random() * 0.45;
          const l = 0.25 + Math.random() * 0.55;

          const c = (1 - Math.abs(2 * l - 1)) * s;
          const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
          const m = l - c / 2;
          let r = 0, g = 0, b = 0;
          if (h < 60) { r = c; g = x; b = 0; }
          else if (h < 120) { r = x; g = c; b = 0; }
          else if (h < 180) { r = 0; g = c; b = x; }
          else if (h < 240) { r = 0; g = x; b = c; }
          else if (h < 300) { r = x; g = 0; b = c; }
          else { r = c; g = 0; b = x; }
          generated.push([Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)]);
        }
        currentPaletteColors = generated;
        renderPalette(true);
        setStatus("Generated new harmonic color palette (Coolors style)!", "ok");
      });
    }

    if (palCountEl) {
      palCountEl.addEventListener("change", () => renderPalette(false));
    }
    if (palFormatEl) {
      palFormatEl.addEventListener("change", () => renderPalette(true));
    }

    // Eyedropper on Canvas Click in Palette Mode
    if (canvas && mode === "palette") {
      canvas.addEventListener("click", (e) => {
        if (!ctx || canvas.width === 0 || canvas.height === 0) return;
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        const x = Math.floor((e.clientX - rect.left) * scaleX);
        const y = Math.floor((e.clientY - rect.top) * scaleY);
        try {
          const pixel = ctx.getImageData(x, y, 1, 1).data;
          const sampled = [pixel[0], pixel[1], pixel[2]];
          const hex = rgbToHex(sampled[0], sampled[1], sampled[2]);
          currentPaletteColors.unshift(sampled);
          const count = Number(palCountEl?.value) || 6;
          currentPaletteColors = currentPaletteColors.slice(0, count);
          renderPalette(true);
          setStatus(`Sampled color ${hex} at (${x}, ${y})! Added to your active palette.`, "ok");
        } catch (err) {}
      });
    }

    // Copy Handlers
    const copyHexesBtn = document.getElementById("tw-pal-copy-hexes");
    if (copyHexesBtn) {
      copyHexesBtn.addEventListener("click", () => {
        if (!currentPaletteColors.length) return;
        const hexList = currentPaletteColors.map((c) => rgbToHex(c[0], c[1], c[2])).join(", ");
        navigator.clipboard?.writeText(hexList).then(() => {
          setStatus(`Copied all hex codes: ${hexList}`, "ok");
        });
      });
    }

    const copyCssBtn = document.getElementById("tw-pal-copy-css");
    if (copyCssBtn) {
      copyCssBtn.addEventListener("click", () => {
        if (!currentPaletteColors.length) return;
        const vars = currentPaletteColors.map((c, i) => `  --color-palette-${i + 1}: ${rgbToHex(c[0], c[1], c[2])};`).join("\n");
        const cssCode = `:root {\n${vars}\n}`;
        navigator.clipboard?.writeText(cssCode).then(() => {
          setStatus("Copied CSS Custom Properties (:root variables) to clipboard!", "ok");
        });
      });
    }

    const copyTailwindBtn = document.getElementById("tw-pal-copy-tailwind");
    if (copyTailwindBtn) {
      copyTailwindBtn.addEventListener("click", () => {
        if (!currentPaletteColors.length) return;
        const weights = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900];
        const lines = currentPaletteColors.map((c, i) => `      ${weights[i] || (i + 1) * 100}: '${rgbToHex(c[0], c[1], c[2])}',`).join("\n");
        const twCode = `// tailwind.config.js\nmodule.exports = {\n  theme: {\n    extend: {\n      colors: {\n        palette: {\n${lines}\n        }\n      }\n    }\n  }\n};`;
        navigator.clipboard?.writeText(twCode).then(() => {
          setStatus("Copied Tailwind CSS theme.extend.colors config!", "ok");
        });
      });
    }

    const copyJsonBtn = document.getElementById("tw-pal-copy-json");
    if (copyJsonBtn) {
      copyJsonBtn.addEventListener("click", () => {
        if (!currentPaletteColors.length) return;
        const payload = currentPaletteColors.map((c, i) => ({
          index: i + 1,
          hex: rgbToHex(c[0], c[1], c[2]),
          rgb: `rgb(${c[0]}, ${c[1]}, ${c[2]})`,
          hsl: rgbToHsl(c[0], c[1], c[2])
        }));
        navigator.clipboard?.writeText(JSON.stringify(payload, null, 2)).then(() => {
          setStatus("Copied JSON color palette schema to clipboard!", "ok");
        });
      });
    }

    // 7. PDF
    function renderPdfList() {
      const listEl = document.getElementById("tw-pdf-list");
      if (!listEl) return;
      listEl.innerHTML = "";
      pdfItems.forEach((it, i) => {
        const item = document.createElement("div");
        item.className = "pdf-item";
        item.innerHTML = `
          <img src="${it.url}" alt="${it.file.name}" />
          <span>${i + 1}. ${it.file.name}</span>
          <button type="button" data-move="-1" ${i === 0 ? "disabled" : ""}>↑</button>
          <button type="button" data-move="1" ${i === pdfItems.length - 1 ? "disabled" : ""}>↓</button>
          <button type="button" data-remove="${i}">Remove</button>
        `;
        item.querySelector("[data-move='-1']")?.addEventListener("click", () => {
          const temp = pdfItems[i - 1];
          pdfItems[i - 1] = pdfItems[i];
          pdfItems[i] = temp;
          renderPdfList();
        });
        item.querySelector("[data-move='1']")?.addEventListener("click", () => {
          const temp = pdfItems[i + 1];
          pdfItems[i + 1] = pdfItems[i];
          pdfItems[i] = temp;
          renderPdfList();
        });
        item.querySelector("[data-remove]")?.addEventListener("click", () => {
          pdfItems.splice(i, 1);
          renderPdfList();
        });
        listEl.appendChild(item);
      });
      setStatus(`${pdfItems.length} image(s) queued for PDF compilation.`, "ok");
    }

    // 8. BG REMOVE
    const bgRunBtn = document.getElementById("tw-bg-run");
    if (bgRunBtn) {
      bgRunBtn.addEventListener("click", async () => {
        if (!currentFile || !canvas || !ctx) return;
        setStatus("Loading background removal model... (runs 100% locally in browser)", "");
        try {
          const mod: any = await import("https://esm.sh/@imgly/background-removal");
          const removeBackground = mod.default || mod.removeBackground;
          const blob: Blob = await removeBackground(currentFile);
          lastBlob = blob;
          const img = new Image();
          img.onload = () => {
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 0, 0);
            setStatus("Background removed! Ready to download PNG.", "ok");
          };
          img.src = URL.createObjectURL(blob);
        } catch (err: any) {
          setStatus("Could not load AI model locally: " + (err?.message || "connection error"), "err");
        }
      });
    }

    // 9. BLUR & CENSOR
    let blurBox: { x: number; y: number; w: number; h: number } | null = null;
    let isBlurDragging = false;
    let blurStartX = 0, blurStartY = 0;

    const blurEffectEl = document.getElementById("tw-blur-effect") as HTMLSelectElement;
    const blurScopeEl = document.getElementById("tw-blur-scope") as HTMLSelectElement;
    const blurRadiusEl = document.getElementById("tw-blur-radius") as HTMLInputElement;
    const blurRadiusVal = document.getElementById("tw-blur-radius-val");
    const blurCenterBtn = document.getElementById("tw-blur-center");
    const blurClearBtn = document.getElementById("tw-blur-clear");

    function renderBlur(showGuide = true) {
      if (!srcImg || !canvas || !ctx) return;
      const w = srcImg.naturalWidth;
      const h = srcImg.naturalHeight;
      canvas.width = w;
      canvas.height = h;

      const effect = blurEffectEl?.value || "smooth";
      const scope = blurScopeEl?.value || "selection";
      const radius = Number(blurRadiusEl?.value) || 20;

      // Draw base sharp image
      ctx.clearRect(0, 0, w, h);
      ctx.filter = "none";
      ctx.drawImage(srcImg, 0, 0, w, h);

      if (!blurBox && (scope === "selection" || scope === "background")) {
        // default face box centered
        blurBox = {
          x: Math.round(w * 0.28),
          y: Math.round(h * 0.15),
          w: Math.round(w * 0.44),
          h: Math.round(h * 0.48),
        };
      }

      function applyEffectToRegion(targetCtx: CanvasRenderingContext2D, rx: number, ry: number, rw: number, rh: number) {
        if (rw <= 0 || rh <= 0) return;
        if (effect === "smooth") {
          targetCtx.save();
          targetCtx.beginPath();
          targetCtx.rect(rx, ry, rw, rh);
          targetCtx.clip();
          targetCtx.filter = `blur(${radius}px)`;
          targetCtx.drawImage(srcImg, 0, 0, w, h);
          targetCtx.restore();
        } else if (effect === "motion") {
          targetCtx.save();
          targetCtx.beginPath();
          targetCtx.rect(rx, ry, rw, rh);
          targetCtx.clip();
          const steps = 16;
          const maxOffset = radius * 2.2;
          targetCtx.globalAlpha = 1 / (steps / 2);
          for (let i = -steps / 2; i <= steps / 2; i++) {
            const offsetX = (i / (steps / 2)) * maxOffset;
            targetCtx.drawImage(srcImg, offsetX, 0, w, h);
          }
          targetCtx.restore();
        } else if (effect === "pixelate") {
          const pixelSize = Math.max(6, Math.round(radius * 0.85));
          const off = document.createElement("canvas");
          const sw = Math.max(1, Math.round(rw / pixelSize));
          const sh = Math.max(1, Math.round(rh / pixelSize));
          off.width = sw;
          off.height = sh;
          const octx = off.getContext("2d");
          if (octx) {
            octx.imageSmoothingEnabled = true;
            octx.drawImage(srcImg, rx, ry, rw, rh, 0, 0, sw, sh);
            targetCtx.save();
            targetCtx.imageSmoothingEnabled = false;
            targetCtx.drawImage(off, 0, 0, sw, sh, rx, ry, rw, rh);
            targetCtx.restore();
          }
        } else if (effect === "blackout") {
          targetCtx.save();
          targetCtx.fillStyle = "#0c0d12";
          targetCtx.fillRect(rx, ry, rw, rh);
          targetCtx.fillStyle = "#ffffff";
          targetCtx.font = `bold ${Math.max(12, Math.round(rh * 0.22))}px sans-serif`;
          targetCtx.textAlign = "center";
          targetCtx.textBaseline = "middle";
          targetCtx.fillText("PRIVACY PROTECTED", rx + rw / 2, ry + rh / 2);
          targetCtx.restore();
        }
      }

      if (scope === "entire") {
        applyEffectToRegion(ctx, 0, 0, w, h);
      } else if (scope === "selection" && blurBox) {
        applyEffectToRegion(ctx, blurBox.x, blurBox.y, blurBox.w, blurBox.h);
      } else if (scope === "background" && blurBox) {
        const offCanvas = document.createElement("canvas");
        offCanvas.width = w;
        offCanvas.height = h;
        const offCtx = offCanvas.getContext("2d");
        if (offCtx) {
          applyEffectToRegion(offCtx, 0, 0, w, h);
          ctx.drawImage(offCanvas, 0, 0);

          ctx.save();
          ctx.beginPath();
          const cx = blurBox.x + blurBox.w / 2;
          const cy = blurBox.y + blurBox.h / 2;
          const rx = blurBox.w / 2;
          const ry = blurBox.h / 2;
          ctx.ellipse(cx, cy, Math.max(1, rx), Math.max(1, ry), 0, 0, Math.PI * 2);
          ctx.clip();
          ctx.drawImage(srcImg, 0, 0, w, h);
          ctx.restore();
        }
      }

      if (showGuide && blurBox && (scope === "selection" || scope === "background")) {
        ctx.save();
        ctx.strokeStyle = scope === "selection" ? "#26e0ff" : "#ffbb00";
        ctx.lineWidth = Math.max(2, Math.round(w / 400));
        ctx.setLineDash([6, 6]);
        if (scope === "selection") {
          ctx.strokeRect(blurBox.x, blurBox.y, blurBox.w, blurBox.h);
        } else {
          ctx.beginPath();
          const cx = blurBox.x + blurBox.w / 2;
          const cy = blurBox.y + blurBox.h / 2;
          ctx.ellipse(cx, cy, Math.max(1, blurBox.w / 2), Math.max(1, blurBox.h / 2), 0, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.fillStyle = scope === "selection" ? "#26e0ff" : "#ffbb00";
        ctx.font = "bold 13px Inter, sans-serif";
        const tagText = scope === "selection" ? "Face / Censor Box" : "Sharp Portrait Subject";
        ctx.fillText(tagText, blurBox.x + 4, Math.max(16, blurBox.y - 6));
        ctx.restore();
      }

      setStatus(`Applied ${effect} effect (${scope}). Drag on image to adjust area.`, "ok");
    }

    if (canvas && mode === "blur") {
      canvas.addEventListener("mousedown", (e) => {
        if (!srcImg) return;
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        blurStartX = (e.clientX - rect.left) * sx;
        blurStartY = (e.clientY - rect.top) * sy;
        isBlurDragging = true;
        blurBox = { x: blurStartX, y: blurStartY, w: 0, h: 0 };
      });

      window.addEventListener("mousemove", (e) => {
        if (!isBlurDragging || !canvas) return;
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        const curX = (e.clientX - rect.left) * sx;
        const curY = (e.clientY - rect.top) * sy;
        blurBox = {
          x: Math.min(blurStartX, curX),
          y: Math.min(blurStartY, curY),
          w: Math.abs(curX - blurStartX),
          h: Math.abs(curY - blurStartY),
        };
        renderBlur(true);
      });

      window.addEventListener("mouseup", () => {
        if (isBlurDragging) {
          isBlurDragging = false;
          renderBlur(true);
        }
      });
    }

    if (blurEffectEl) blurEffectEl.addEventListener("change", () => renderBlur(true));
    if (blurScopeEl) blurScopeEl.addEventListener("change", () => renderBlur(true));
    if (blurRadiusEl) {
      blurRadiusEl.addEventListener("input", () => {
        if (blurRadiusVal) blurRadiusVal.textContent = blurRadiusEl.value;
        renderBlur(true);
      });
    }
    if (blurCenterBtn) {
      blurCenterBtn.addEventListener("click", () => {
        if (!srcImg) return;
        const w = srcImg.naturalWidth;
        const h = srcImg.naturalHeight;
        blurBox = {
          x: Math.round(w * 0.28),
          y: Math.round(h * 0.15),
          w: Math.round(w * 0.44),
          h: Math.round(h * 0.48),
        };
        renderBlur(true);
      });
    }
    if (blurClearBtn) {
      blurClearBtn.addEventListener("click", () => {
        if (!srcImg || !canvas || !ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.filter = "none";
        ctx.drawImage(srcImg, 0, 0);
        setStatus("Blur cleared. Adjust settings to reapply blur.");
      });
    }

    // 10. PHOTO COLLAGE MAKER
    let collageItems: { file: File; url: string; img: HTMLImageElement }[] = [];

    const colLayoutEl = document.getElementById("tw-col-layout") as HTMLSelectElement;
    const colRatioEl = document.getElementById("tw-col-ratio") as HTMLSelectElement;
    const colGapEl = document.getElementById("tw-col-gap") as HTMLInputElement;
    const colGapVal = document.getElementById("tw-col-gap-val");
    const colRadiusEl = document.getElementById("tw-col-radius") as HTMLInputElement;
    const colRadiusVal = document.getElementById("tw-col-radius-val");
    const colBgEl = document.getElementById("tw-col-bg") as HTMLInputElement;
    const colCountEl = document.getElementById("tw-col-count");
    const colThumbsEl = document.getElementById("tw-col-thumbs");
    const colAddBtn = document.getElementById("tw-col-add-btn");
    const colClearBtn = document.getElementById("tw-col-clear-btn");

    function renderCollageThumbs() {
      if (colCountEl) colCountEl.textContent = `${collageItems.length} photo(s) in collage`;
      if (!colThumbsEl) return;
      colThumbsEl.innerHTML = "";
      collageItems.forEach((item, idx) => {
        const thumb = document.createElement("div");
        thumb.className = "relative flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden border border-border group";
        thumb.innerHTML = `
          <img src="${item.url}" class="w-full h-full object-cover" alt="Thumb ${idx + 1}" />
          <button class="absolute top-0 right-0 w-4 h-4 bg-red-500 text-white text-[10px] flex items-center justify-center rounded-bl opacity-80 hover:opacity-100" type="button" data-del-idx="${idx}">×</button>
        `;
        const delBtn = thumb.querySelector("[data-del-idx]");
        if (delBtn) {
          delBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            collageItems.splice(idx, 1);
            renderCollage();
            renderCollageThumbs();
          });
        }
        colThumbsEl.appendChild(thumb);
      });
    }

    function renderCollage() {
      if (!canvas || !ctx) return;
      if (!collageItems.length) {
        setStatus("Upload 2 or more photos to generate your photo collage.", "");
        return;
      }

      const ratio = colRatioEl?.value || "1:1";
      const layout = colLayoutEl?.value || "auto";
      const gap = Number(colGapEl?.value) ?? 12;
      const radius = Number(colRadiusEl?.value) ?? 10;
      const bgColor = colBgEl?.value || "#ffffff";

      // Base canvas size for crisp resolution
      let cw = 1600;
      let ch = 1600;
      if (ratio === "4:5") { cw = 1600; ch = 2000; }
      else if (ratio === "9:16") { cw = 1440; ch = 2560; }
      else if (ratio === "16:9") { cw = 1920; ch = 1080; }
      else if (ratio === "4:3") { cw = 1600; ch = 1200; }

      canvas.width = cw;
      canvas.height = ch;

      // Fill background frame
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, cw, ch);

      const n = collageItems.length;
      let cells: { x: number; y: number; w: number; h: number }[] = [];

      const innerX = gap;
      const innerY = gap;
      const innerW = cw - gap * 2;
      const innerH = ch - gap * 2;

      let chosenLayout = layout;
      if (layout === "auto") {
        if (n <= 1) chosenLayout = "1-full";
        else if (n === 2) chosenLayout = ratio === "16:9" || ratio === "4:3" ? "2-side" : "2-stack";
        else if (n === 3) chosenLayout = "3-left-big";
        else if (n === 4) chosenLayout = "4-grid";
        else if (n <= 6) chosenLayout = "6-grid";
        else chosenLayout = "9-grid";
      }

      if (chosenLayout === "1-full") {
        cells.push({ x: innerX, y: innerY, w: innerW, h: innerH });
      } else if (chosenLayout === "2-side") {
        const w = (innerW - gap) / 2;
        cells.push({ x: innerX, y: innerY, w, h: innerH });
        cells.push({ x: innerX + w + gap, y: innerY, w, h: innerH });
      } else if (chosenLayout === "2-stack") {
        const h = (innerH - gap) / 2;
        cells.push({ x: innerX, y: innerY, w: innerW, h });
        cells.push({ x: innerX, y: innerY + h + gap, w: innerW, h });
      } else if (chosenLayout === "3-left-big") {
        const w1 = (innerW - gap) * 0.55;
        const w2 = innerW - gap - w1;
        const h2 = (innerH - gap) / 2;
        cells.push({ x: innerX, y: innerY, w: w1, h: innerH });
        cells.push({ x: innerX + w1 + gap, y: innerY, w: w2, h: h2 });
        cells.push({ x: innerX + w1 + gap, y: innerY + h2 + gap, w: w2, h: h2 });
      } else if (chosenLayout === "3-strip") {
        const w = (innerW - gap * 2) / 3;
        for (let i = 0; i < 3; i++) {
          cells.push({ x: innerX + i * (w + gap), y: innerY, w, h: innerH });
        }
      } else if (chosenLayout === "4-grid") {
        const w = (innerW - gap) / 2;
        const h = (innerH - gap) / 2;
        cells.push({ x: innerX, y: innerY, w, h });
        cells.push({ x: innerX + w + gap, y: innerY, w, h });
        cells.push({ x: innerX, y: innerY + h + gap, w, h });
        cells.push({ x: innerX + w + gap, y: innerY + h + gap, w, h });
      } else if (chosenLayout === "4-top-big") {
        const hTop = (innerH - gap) * 0.6;
        const hBot = innerH - gap - hTop;
        const wBot = (innerW - gap * 2) / 3;
        cells.push({ x: innerX, y: innerY, w: innerW, h: hTop });
        cells.push({ x: innerX, y: innerY + hTop + gap, w: wBot, h: hBot });
        cells.push({ x: innerX + wBot + gap, y: innerY + hTop + gap, w: wBot, h: hBot });
        cells.push({ x: innerX + (wBot + gap) * 2, y: innerY + hTop + gap, w: wBot, h: hBot });
      } else if (chosenLayout === "6-grid") {
        const cols = ratio === "16:9" ? 3 : 2;
        const rows = ratio === "16:9" ? 2 : 3;
        const w = (innerW - gap * (cols - 1)) / cols;
        const h = (innerH - gap * (rows - 1)) / rows;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            cells.push({ x: innerX + c * (w + gap), y: innerY + r * (h + gap), w, h });
          }
        }
      } else if (chosenLayout === "9-grid") {
        const w = (innerW - gap * 2) / 3;
        const h = (innerH - gap * 2) / 3;
        for (let r = 0; r < 3; r++) {
          for (let c = 0; c < 3; c++) {
            cells.push({ x: innerX + c * (w + gap), y: innerY + r * (h + gap), w, h });
          }
        }
      }

      // Draw each image in its cell with object-fit: cover and rounded corners
      cells.forEach((cell, i) => {
        const item = collageItems[i % collageItems.length];
        if (!item || !item.img) return;

        ctx.save();
        ctx.beginPath();
        if (typeof (ctx as any).roundRect === "function" && radius > 0) {
          (ctx as any).roundRect(cell.x, cell.y, cell.w, cell.h, radius);
        } else {
          ctx.rect(cell.x, cell.y, cell.w, cell.h);
        }
        ctx.clip();

        const img = item.img;
        const imgW = img.naturalWidth || 1;
        const imgH = img.naturalHeight || 1;
        const cellRatio = cell.w / cell.h;
        const imgRatio = imgW / imgH;

        let dw: number, dh: number, dx: number, dy: number;
        if (imgRatio > cellRatio) {
          dh = cell.h;
          dw = cell.h * imgRatio;
          dx = cell.x + (cell.w - dw) / 2;
          dy = cell.y;
        } else {
          dw = cell.w;
          dh = cell.w / imgRatio;
          dx = cell.x;
          dy = cell.y + (cell.h - dh) / 2;
        }

        ctx.drawImage(img, dx, dy, dw, dh);
        ctx.restore();
      });

      setStatus(`Collage rendered (${collageItems.length} photos, ${cw}×${ch}px, ${ratio}). Ready to download.`, "ok");
    }

    if (colAddBtn && input) {
      colAddBtn.addEventListener("click", () => input.click());
    }
    if (colClearBtn) {
      colClearBtn.addEventListener("click", () => {
        collageItems = [];
        renderCollageThumbs();
        if (canvas && ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
        setStatus("Collage cleared. Upload new photos to begin.");
      });
    }

    document.querySelectorAll("[data-col-color]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const color = btn.getAttribute("data-col-color") || "#ffffff";
        if (colBgEl) colBgEl.value = color;
        renderCollage();
      });
    });

    if (colLayoutEl) colLayoutEl.addEventListener("change", renderCollage);
    if (colRatioEl) colRatioEl.addEventListener("change", renderCollage);
    if (colBgEl) colBgEl.addEventListener("input", renderCollage);
    if (colGapEl) {
      colGapEl.addEventListener("input", () => {
        if (colGapVal) colGapVal.textContent = colGapEl.value;
        renderCollage();
      });
    }
    if (colRadiusEl) {
      colRadiusEl.addEventListener("input", () => {
        if (colRadiusVal) colRadiusVal.textContent = colRadiusEl.value;
        renderCollage();
      });
    }

    // 11. CIRCLE CROP
    let circCenter = { x: 0, y: 0, r: 0 };
    let isCircDragging = false;
    let circDragStartX = 0, circDragStartY = 0;
    let initialCircCenter = { x: 0, y: 0, r: 0 };

    const circBgEl = document.getElementById("tw-circ-bg") as HTMLSelectElement;
    const circCustomBgField = document.getElementById("tw-circ-custom-bg-field");
    const circCustomBgEl = document.getElementById("tw-circ-custom-bg") as HTMLInputElement;
    const circBorderWidthEl = document.getElementById("tw-circ-border-width") as HTMLInputElement;
    const circBorderWidthVal = document.getElementById("tw-circ-border-width-val");
    const circBorderColorEl = document.getElementById("tw-circ-border-color") as HTMLInputElement;
    const circCenterBtn = document.getElementById("tw-circ-center");
    const circMaxBtn = document.getElementById("tw-circ-max");

    function initCircCenter() {
      if (!srcImg) return;
      const w = srcImg.naturalWidth;
      const h = srcImg.naturalHeight;
      const minDim = Math.min(w, h);
      circCenter = {
        x: Math.round(w / 2),
        y: Math.round(h / 2),
        r: Math.round(minDim * 0.44),
      };
    }

    function drawCircleOverlay(showGuide = true) {
      if (!srcImg || !canvas || !ctx) return;
      const w = srcImg.naturalWidth;
      const h = srcImg.naturalHeight;
      canvas.width = w;
      canvas.height = h;

      if (!circCenter.r) initCircCenter();

      ctx.clearRect(0, 0, w, h);
      ctx.drawImage(srcImg, 0, 0, w, h);

      const borderWidth = Number(circBorderWidthEl?.value) || 0;
      const borderColor = circBorderColorEl?.value || "#ef4444";

      if (showGuide) {
        ctx.save();
        ctx.fillStyle = "rgba(0, 0, 0, 0.6)";
        ctx.beginPath();
        ctx.rect(0, 0, w, h);
        ctx.arc(circCenter.x, circCenter.y, circCenter.r, 0, Math.PI * 2, true);
        ctx.fill();

        ctx.strokeStyle = borderWidth > 0 ? borderColor : "#26e0ff";
        ctx.lineWidth = Math.max(borderWidth, Math.max(2, Math.round(w / 400)));
        ctx.beginPath();
        ctx.arc(circCenter.x, circCenter.y, circCenter.r, 0, Math.PI * 2);
        ctx.stroke();

        ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(circCenter.x - 10, circCenter.y);
        ctx.lineTo(circCenter.x + 10, circCenter.y);
        ctx.moveTo(circCenter.x, circCenter.y - 10);
        ctx.lineTo(circCenter.x, circCenter.y + 10);
        ctx.stroke();

        ctx.restore();
        setStatus(`Circle crop ready (radius: ${circCenter.r}px). Drag to reposition.`, "ok");
      }
    }

    if (canvas && mode === "circle") {
      canvas.addEventListener("mousedown", (e) => {
        if (!srcImg) return;
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        circDragStartX = (e.clientX - rect.left) * sx;
        circDragStartY = (e.clientY - rect.top) * sy;
        initialCircCenter = { ...circCenter };
        isCircDragging = true;
      });

      window.addEventListener("mousemove", (e) => {
        if (!isCircDragging || !canvas || !srcImg) return;
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        const curX = (e.clientX - rect.left) * sx;
        const curY = (e.clientY - rect.top) * sy;
        const dx = curX - circDragStartX;
        const dy = curY - circDragStartY;

        circCenter.x = Math.max(circCenter.r, Math.min(srcImg.naturalWidth - circCenter.r, Math.round(initialCircCenter.x + dx)));
        circCenter.y = Math.max(circCenter.r, Math.min(srcImg.naturalHeight - circCenter.r, Math.round(initialCircCenter.y + dy)));
        drawCircleOverlay(true);
      });

      window.addEventListener("mouseup", () => {
        if (isCircDragging) {
          isCircDragging = false;
          drawCircleOverlay(true);
        }
      });
    }

    if (circBgEl) {
      circBgEl.addEventListener("change", () => {
        if (circCustomBgField) {
          circCustomBgField.style.display = circBgEl.value === "custom" ? "block" : "none";
        }
        drawCircleOverlay(true);
      });
    }
    if (circCustomBgEl) circCustomBgEl.addEventListener("input", () => drawCircleOverlay(true));
    if (circBorderWidthEl) {
      circBorderWidthEl.addEventListener("input", () => {
        if (circBorderWidthVal) circBorderWidthVal.textContent = circBorderWidthEl.value;
        drawCircleOverlay(true);
      });
    }
    if (circBorderColorEl) circBorderColorEl.addEventListener("input", () => drawCircleOverlay(true));

    document.querySelectorAll("[data-circ-color]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const color = btn.getAttribute("data-circ-color") || "#ef4444";
        if (circBorderColorEl) circBorderColorEl.value = color;
        if (circBorderWidthEl && Number(circBorderWidthEl.value) === 0) {
          circBorderWidthEl.value = "6";
          if (circBorderWidthVal) circBorderWidthVal.textContent = "6";
        }
        drawCircleOverlay(true);
      });
    });

    if (circCenterBtn) {
