    function cleanXHtml(html: string): string {
      return html
        .replace(/<img\b([^>]*[^\/])>/gi, '<img $1 />')
        .replace(/<br\b([^>]*[^\/])>/gi, '<br $1 />')
        .replace(/<hr\b([^>]*[^\/])>/gi, '<hr $1 />')
        .replace(/<input\b([^>]*[^\/])>/gi, '<input $1 />')
        .replace(/&(?!(?:amp|lt|gt|quot|apos|#\d+|#x[a-f\d]+);)/gi, '&amp;');
    }

    function measureHtmlHeight(html: string, width: number): number {
      const m = document.createElement("div");
      m.style.cssText = `position: absolute; left: -9999px; top: 0; width: ${width}px; visibility: hidden; pointer-events: none; box-sizing: border-box;`;
      m.innerHTML = html;
      document.body.appendChild(m);
      const h = Math.max(80, m.offsetHeight + 24);
      document.body.removeChild(m);
      return h;
    }

    let isH2iInitialized = false;

    function renderHtmlSnippet() {
      const codeEl = document.getElementById("tw-h2i-code") as HTMLTextAreaElement;
      if (!codeEl || !canvas || !ctx) return;
      const rawHtml = codeEl.value.trim() || htmlTemplates.card;
      const widthInput = document.getElementById("tw-h2i-width") as HTMLInputElement;
      const heightInput = document.getElementById("tw-h2i-height") as HTMLInputElement;
      const scaleSelect = document.getElementById("tw-h2i-scale") as HTMLSelectElement;
      const bgSelect = document.getElementById("tw-h2i-bg") as HTMLSelectElement;

      const w = Math.max(160, Math.min(2560, Number(widthInput?.value) || 540));
      const userH = Number(heightInput?.value) || 0;
      const h = userH > 0 ? userH : measureHtmlHeight(rawHtml, w);
      const scale = Number(scaleSelect?.value) || 2;
      const bgChoice = bgSelect?.value || "transparent";

      let bgCss = "";
      if (bgChoice === "white") bgCss = "background-color: #ffffff;";
      else if (bgChoice === "dark") bgCss = "background-color: #0f172a;";
      else if (bgChoice === "gradient") bgCss = "background: linear-gradient(135deg, #090d16 0%, #171c2f 50%, #1e1b4b 100%);";

      const xhtml = cleanXHtml(rawHtml);
      const svgData = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}">
  <foreignObject width="100%" height="100%">
    <div xmlns="http://www.w3.org/1999/xhtml" style="width:100%; height:100%; margin:0; padding:12px; box-sizing:border-box; display:flex; align-items:center; justify-content:center; ${bgCss}">
      ${xhtml}
    </div>
  </foreignObject>
</svg>`;

      const blob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        canvas.width = w * scale;
        canvas.height = h * scale;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        ctx.scale(scale, scale);
        ctx.drawImage(img, 0, 0, w, h);
        ctx.restore();
        URL.revokeObjectURL(url);
        if (preview) preview.style.display = "grid";
        setStatus(`Rendered HTML: ${canvas.width}×${canvas.height}px (${scale}x scale). Ready to download.`, "ok");
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        setStatus("Could not render HTML. Please check for unclosed HTML tags or syntax errors.", "err");
      };
      img.src = url;
    }

    function initHtmlToImage() {
      if (isH2iInitialized) return;
      isH2iInitialized = true;

      const codeEl = document.getElementById("tw-h2i-code") as HTMLTextAreaElement;
      if (codeEl && !codeEl.value) {
