          tabImg2B64?.classList.add("active");
          setStatus("Drop or upload an image to convert to Base64 Data URI & HTML code.", "ok");
        } else {
          tabB642Img?.classList.add("active");
          setStatus("Paste your Base64 Data URI below and click Decode to Image.", "ok");
        }
      }

      tabCode?.addEventListener("click", () => switchH2iTab("code"));
      tabImg2B64?.addEventListener("click", () => switchH2iTab("img2b64"));
      tabB642Img?.addEventListener("click", () => switchH2iTab("b642img"));

      // Trigger buttons and inputs
      const renderBtn = document.getElementById("tw-h2i-render");
      renderBtn?.addEventListener("click", renderHtmlSnippet);

      const widthInput = document.getElementById("tw-h2i-width");
      const heightInput = document.getElementById("tw-h2i-height");
      const scaleSelect = document.getElementById("tw-h2i-scale");
      const bgSelect = document.getElementById("tw-h2i-bg");

      [widthInput, heightInput, scaleSelect, bgSelect].forEach((el) => {
        el?.addEventListener("change", renderHtmlSnippet);
      });

      // Copy image to clipboard
      const copyImgBtn = document.getElementById("tw-h2i-copy-img");
      copyImgBtn?.addEventListener("click", () => {
        if (!canvas) return;
        canvas.toBlob((blob) => {
          if (blob && navigator.clipboard && (window as any).ClipboardItem) {
            navigator.clipboard.write([new ClipboardItem({ "image/png": blob })])
              .then(() => setStatus("Rendered image copied to clipboard!", "ok"))
              .catch(() => setStatus("Clipboard access denied. Use the Download button instead.", "err"));
          } else {
            setStatus("Direct clipboard copy not supported in this browser.", "err");
          }
        }, "image/png");
      });

      // Copy URI, HTML tag, CSS property
      const copyUriBtn = document.getElementById("tw-b64-copy-uri");
      copyUriBtn?.addEventListener("click", () => {
        const out = (document.getElementById("tw-b64-output") as HTMLTextAreaElement)?.value;
        if (out) {
          navigator.clipboard.writeText(out).then(() => setStatus("Base64 Data URI copied to clipboard!", "ok"));
        } else {
          setStatus("Please upload an image first to generate Base64 data.", "err");
        }
      });

      const copyImgTagBtn = document.getElementById("tw-b64-copy-imgtag");
      copyImgTagBtn?.addEventListener("click", () => {
        const out = (document.getElementById("tw-b64-img-tag") as HTMLTextAreaElement)?.value;
        if (out) {
          navigator.clipboard.writeText(out).then(() => setStatus("HTML <img> code copied to clipboard!", "ok"));
        }
      });

      const copyCssTagBtn = document.getElementById("tw-b64-copy-csstag");
      copyCssTagBtn?.addEventListener("click", () => {
        const out = (document.getElementById("tw-b64-css-tag") as HTMLTextAreaElement)?.value;
        if (out) {
          navigator.clipboard.writeText(out).then(() => setStatus("CSS background-image copied to clipboard!", "ok"));
        }
      });

      // Decode Base64 to Canvas
      const decodeBtn = document.getElementById("tw-b64-decode-btn");
      decodeBtn?.addEventListener("click", () => {
        const inputStr = ((document.getElementById("tw-b64-input") as HTMLTextAreaElement)?.value || "").trim();
        if (!inputStr) {
          setStatus("Please paste a Base64 Data URI or image string first.", "err");
          return;
        }
        const b64Data = inputStr.startsWith("data:") ? inputStr : "data:image/png;base64," + inputStr;
        const img = new Image();
        img.onload = () => {
          if (canvas && ctx) {
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 0, 0);
            srcImg = img;
            if (preview) preview.style.display = "grid";
            setStatus(`Decoded Base64 image (${img.naturalWidth}×${img.naturalHeight}px). Ready to download.`, "ok");
          }
        };
        img.onerror = () => {
          setStatus("Invalid Base64 image data. Please ensure proper Data URI syntax.", "err");
        };
        img.src = b64Data;
      });

      // Initial render of default template
      renderHtmlSnippet();
    }

    // 8. WHATSAPP FULL DP STUDIO
    const dpBgEl = document.getElementById("tw-dp-bg") as HTMLSelectElement;
    const dpCustomColorField = document.getElementById("tw-dp-custom-color-field");
    const dpCustomColorEl = document.getElementById("tw-dp-custom-color") as HTMLInputElement;
    const dpSizeEl = document.getElementById("tw-dp-size") as HTMLSelectElement;
    const dpPaddingEl = document.getElementById("tw-dp-padding") as HTMLInputElement;
    const dpPaddingVal = document.getElementById("tw-dp-padding-val");
    const dpZoomEl = document.getElementById("tw-dp-zoom") as HTMLInputElement;
    const dpZoomVal = document.getElementById("tw-dp-zoom-val");
    const dpPosEl = document.getElementById("tw-dp-pos") as HTMLSelectElement;
    const dpRadiusEl = document.getElementById("tw-dp-radius") as HTMLInputElement;
    const dpRadiusVal = document.getElementById("tw-dp-radius-val");
    const dpGuideCheck = document.getElementById("tw-dp-guide") as HTMLInputElement;

    function renderWhatsAppDp(showCircleGuide = true) {
      if (!canvas || !ctx) return;
      const size = Number(dpSizeEl?.value) || 640;
      canvas.width = size;
      canvas.height = size;
      ctx.clearRect(0, 0, size, size);

      const bgType = dpBgEl?.value || "blur";
      const customColor = dpCustomColorEl?.value || "#0f172a";
      const paddingPct = Number(dpPaddingEl?.value || 8) / 100;
      const zoom = Number(dpZoomEl?.value || 100) / 100;
      const borderRadius = Number(dpRadiusEl?.value || 0);
      const positionY = dpPosEl?.value || "center";

      // If no image is loaded yet, but black DP is selected
      if (!srcImg) {
        if (bgType === "black") {
          ctx.fillStyle = "#000000";
          ctx.fillRect(0, 0, size, size);
          if (showCircleGuide && dpGuideCheck?.checked) {
            drawWhatsAppGuide(size);
          }
          setStatus("Full Black WhatsApp DP generated (pure #000000). Ready to download!", "ok");
        }
        return;
      }

      // 1. Draw Background Margin
      if (bgType === "blur") {
        ctx.save();
        ctx.filter = `blur(${Math.round(size * 0.045)}px) brightness(0.72)`;
        const overflow = size * 0.12;
        ctx.drawImage(srcImg, -overflow, -overflow, size + overflow * 2, size + overflow * 2);
        ctx.restore();
        ctx.fillStyle = "rgba(0, 0, 0, 0.12)";
        ctx.fillRect(0, 0, size, size);
      } else if (bgType === "black") {
        ctx.fillStyle = "#000000";
        ctx.fillRect(0, 0, size, size);
      } else if (bgType === "white") {
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, size, size);
      } else if (bgType === "gradient") {
        const grad = ctx.createLinearGradient(0, 0, size, size);
        grad.addColorStop(0, "#090d16");
        grad.addColorStop(0.5, "#171c2f");
        grad.addColorStop(1, "#1e1b4b");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, size, size);
      } else if (bgType === "custom") {
        ctx.fillStyle = customColor;
        ctx.fillRect(0, 0, size, size);
      }

      // 2. Compute inner image dimensions (Fit without crop)
      const availW = size * (1 - paddingPct * 2) * zoom;
      const availH = size * (1 - paddingPct * 2) * zoom;
      const imgW = srcImg.naturalWidth;
      const imgH = srcImg.naturalHeight;
      const scale = Math.min(availW / imgW, availH / imgH);
      const drawW = Math.round(imgW * scale);
      const drawH = Math.round(imgH * scale);

      const drawX = Math.round((size - drawW) / 2);
      let drawY = Math.round((size - drawH) / 2);
      if (positionY === "top") drawY = Math.round(size * paddingPct);
      else if (positionY === "bottom") drawY = Math.round(size - drawH - size * paddingPct);

      // 3. Draw Inner Photo
      ctx.save();
      if (borderRadius > 0) {
        ctx.beginPath();
        if ((ctx as any).roundRect) {
          (ctx as any).roundRect(drawX, drawY, drawW, drawH, borderRadius);
        } else {
          ctx.rect(drawX, drawY, drawW, drawH);
        }
        ctx.clip();
      }
      ctx.drawImage(srcImg, drawX, drawY, drawW, drawH);
      ctx.restore();

      // 4. Circle safe-zone guide
      if (showCircleGuide && dpGuideCheck?.checked) {
        drawWhatsAppGuide(size);
      }
      setStatus(`WhatsApp Full DP ready (${size}×${size}px). No crop will occur!`, "ok");
    }

    function drawWhatsAppGuide(size: number) {
      if (!ctx) return;
      ctx.save();
      const r = size / 2;
      ctx.beginPath();
      ctx.arc(r, r, r, 0, Math.PI * 2);
      ctx.rect(size, 0, -size, size);
      ctx.fillStyle = "rgba(0, 0, 0, 0.42)";
      ctx.fill();

      // Green WhatsApp dashed ring
      ctx.beginPath();
      ctx.arc(r, r, r - 3, 0, Math.PI * 2);
      ctx.strokeStyle = "#25D366";
      ctx.lineWidth = 3;
      ctx.setLineDash([8, 6]);
      ctx.stroke();

      // Label
      ctx.fillStyle = "#25D366";
      ctx.font = "bold 13px system-ui, sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("WhatsApp Circle Safe-Zone", r, 28);
      ctx.restore();
    }

    let isDpInitialized = false;
    function initWhatsAppDp() {
      if (isDpInitialized) return;
      isDpInitialized = true;

      dpBgEl?.addEventListener("change", () => {
        if (dpCustomColorField) {
          dpCustomColorField.style.display = dpBgEl.value === "custom" ? "block" : "none";
        }
        renderWhatsAppDp(true);
      });

      dpCustomColorEl?.addEventListener("input", () => renderWhatsAppDp(true));
      dpSizeEl?.addEventListener("change", () => renderWhatsAppDp(true));

      dpPaddingEl?.addEventListener("input", () => {
        if (dpPaddingVal) dpPaddingVal.textContent = dpPaddingEl.value;
        renderWhatsAppDp(true);
      });

      dpZoomEl?.addEventListener("input", () => {
        if (dpZoomVal) dpZoomVal.textContent = dpZoomEl.value;
        renderWhatsAppDp(true);
      });

      dpPosEl?.addEventListener("change", () => renderWhatsAppDp(true));

      dpRadiusEl?.addEventListener("input", () => {
        if (dpRadiusVal) dpRadiusVal.textContent = dpRadiusEl.value;
        renderWhatsAppDp(true);
      });

      dpGuideCheck?.addEventListener("change", () => renderWhatsAppDp(true));

      // Presets
      const presetBlur = document.getElementById("tw-dp-preset-blur");
      const presetBlack = document.getElementById("tw-dp-preset-black");
      const presetWhite = document.getElementById("tw-dp-preset-white");
      const presetGradient = document.getElementById("tw-dp-preset-gradient");
      const presetCircle = document.getElementById("tw-dp-preset-circle");

      function setActivePreset(btn: HTMLElement | null) {
        [presetBlur, presetBlack, presetWhite, presetGradient, presetCircle].forEach((b) => b?.classList.remove("active"));
        btn?.classList.add("active");
      }

      presetBlur?.addEventListener("click", () => {
        setActivePreset(presetBlur);
        if (dpBgEl) dpBgEl.value = "blur";
        if (dpCustomColorField) dpCustomColorField.style.display = "none";
        if (dpPaddingEl) { dpPaddingEl.value = "8"; if (dpPaddingVal) dpPaddingVal.textContent = "8"; }
        renderWhatsAppDp(true);
      });

      presetBlack?.addEventListener("click", () => {
        setActivePreset(presetBlack);
        if (dpBgEl) dpBgEl.value = "black";
        if (dpCustomColorField) dpCustomColorField.style.display = "none";
        if (dpPaddingEl) { dpPaddingEl.value = "10"; if (dpPaddingVal) dpPaddingVal.textContent = "10"; }
        if (preview) preview.style.display = "grid";
        renderWhatsAppDp(true);
      });

      presetWhite?.addEventListener("click", () => {
        setActivePreset(presetWhite);
        if (dpBgEl) dpBgEl.value = "white";
        if (dpCustomColorField) dpCustomColorField.style.display = "none";
        if (dpPaddingEl) { dpPaddingEl.value = "10"; if (dpPaddingVal) dpPaddingVal.textContent = "10"; }
        renderWhatsAppDp(true);
      });

      presetGradient?.addEventListener("click", () => {
        setActivePreset(presetGradient);
        if (dpBgEl) dpBgEl.value = "gradient";
        if (dpCustomColorField) dpCustomColorField.style.display = "none";
        renderWhatsAppDp(true);
      });

      presetCircle?.addEventListener("click", () => {
        setActivePreset(presetCircle);
        if (dpPaddingEl) { dpPaddingEl.value = "16"; if (dpPaddingVal) dpPaddingVal.textContent = "16"; }
        if (dpGuideCheck) dpGuideCheck.checked = true;
        renderWhatsAppDp(true);
      });
    }

    // 10. BACKGROUND REMOVER
    let isBgRemoveInitialized = false;

    function renderBgRemove(showOriginal = false) {
      if (!srcImg || !canvas || !ctx) return;
      const w = srcImg.naturalWidth;
      const h = srcImg.naturalHeight;
      canvas.width = w;
      canvas.height = h;

      if (showOriginal) {
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(srcImg, 0, 0);
        setStatus("Showing original image. Click 'Re-apply Background Removal' to cut out again.");
        return;
      }

      // Offscreen canvas for pixel manipulation
      const offscreen = document.createElement("canvas");
      offscreen.width = w;
      offscreen.height = h;
      const oCtx = offscreen.getContext("2d", { willReadFrequently: true });
      if (!oCtx) return;
      oCtx.drawImage(srcImg, 0, 0);
      const imgData = oCtx.getImageData(0, 0, w, h);
      const data = imgData.data;

      const sampleMode = (document.getElementById("tw-bg-sample") as HTMLSelectElement)?.value || "auto-corners";
      const tolPercent = Number((document.getElementById("tw-bg-tolerance") as HTMLInputElement)?.value) || 28;
      const feather = Number((document.getElementById("tw-bg-feather") as HTMLInputElement)?.value) || 2;
      const bgType = (document.getElementById("tw-bg-type") as HTMLSelectElement)?.value || "transparent";
      const customColor = (document.getElementById("tw-bg-custom-color") as HTMLInputElement)?.value || "#ffffff";

      // 1. Determine sampled backdrop color
      let bgR = 255, bgG = 255, bgB = 255;
      if (sampleMode === "white-studio") {
        bgR = 250; bgG = 250; bgB = 250;
      } else if (sampleMode === "dark-studio") {
        bgR = 15; bgG = 15; bgB = 15;
      } else if (sampleMode === "green-screen") {
        bgR = 0; bgG = 220; bgB = 0;
      } else if (sampleMode === "top-left") {
        bgR = data[0]; bgG = data[1]; bgB = data[2];
      } else {
        const cornerIndices = [
          0,
          Math.max(0, (w - 1) * 4),
          Math.max(0, ((h - 1) * w) * 4),
          Math.max(0, ((h - 1) * w + (w - 1)) * 4),
          Math.max(0, Math.floor(w / 2) * 4),
          Math.max(0, ((h - 1) * w + Math.floor(w / 2)) * 4),
          Math.max(0, (Math.floor(h / 2) * w) * 4),
          Math.max(0, (Math.floor(h / 2) * w + (w - 1)) * 4),
        ];
        let sumR = 0, sumG = 0, sumB = 0;
        cornerIndices.forEach((idx) => {
          sumR += data[idx] || 0;
          sumG += data[idx + 1] || 0;
          sumB += data[idx + 2] || 0;
        });
        bgR = Math.round(sumR / cornerIndices.length);
        bgG = Math.round(sumG / cornerIndices.length);
        bgB = Math.round(sumB / cornerIndices.length);
      }

      const thresh = (tolPercent / 100) * 441.67;
      const totalPixels = w * h;
      const isBg = new Uint8Array(totalPixels);
      const queue = new Int32Array(totalPixels);
      let qHead = 0;
      let qTail = 0;

      // Seed all border pixels
      for (let x = 0; x < w; x++) {
        let idx = x;
        let d = Math.hypot(data[idx * 4] - bgR, data[idx * 4 + 1] - bgG, data[idx * 4 + 2] - bgB);
        if (d <= thresh) { isBg[idx] = 1; queue[qTail++] = idx; }

        idx = (h - 1) * w + x;
        d = Math.hypot(data[idx * 4] - bgR, data[idx * 4 + 1] - bgG, data[idx * 4 + 2] - bgB);
        if (d <= thresh && !isBg[idx]) { isBg[idx] = 1; queue[qTail++] = idx; }
      }

      for (let y = 1; y < h - 1; y++) {
        let idx = y * w;
        let d = Math.hypot(data[idx * 4] - bgR, data[idx * 4 + 1] - bgG, data[idx * 4 + 2] - bgB);
        if (d <= thresh && !isBg[idx]) { isBg[idx] = 1; queue[qTail++] = idx; }

        idx = y * w + (w - 1);
        d = Math.hypot(data[idx * 4] - bgR, data[idx * 4 + 1] - bgG, data[idx * 4 + 2] - bgB);
        if (d <= thresh && !isBg[idx]) { isBg[idx] = 1; queue[qTail++] = idx; }
      }

      // BFS flood fill
      while (qHead < qTail) {
        const cur = queue[qHead++];
        const cx = cur % w;
        const cy = (cur / w) | 0;

        if (cy > 0) {
          const n = cur - w;
          if (!isBg[n]) {
            const nd = Math.hypot(data[n * 4] - bgR, data[n * 4 + 1] - bgG, data[n * 4 + 2] - bgB);
            if (nd <= thresh) { isBg[n] = 1; queue[qTail++] = n; }
          }
        }
        if (cy < h - 1) {
          const n = cur + w;
          if (!isBg[n]) {
            const nd = Math.hypot(data[n * 4] - bgR, data[n * 4 + 1] - bgG, data[n * 4 + 2] - bgB);
            if (nd <= thresh) { isBg[n] = 1; queue[qTail++] = n; }
          }
        }
        if (cx > 0) {
          const n = cur - 1;
          if (!isBg[n]) {
            const nd = Math.hypot(data[n * 4] - bgR, data[n * 4 + 1] - bgG, data[n * 4 + 2] - bgB);
            if (nd <= thresh) { isBg[n] = 1; queue[qTail++] = n; }
          }
        }
        if (cx < w - 1) {
          const n = cur + 1;
          if (!isBg[n]) {
            const nd = Math.hypot(data[n * 4] - bgR, data[n * 4 + 1] - bgG, data[n * 4 + 2] - bgB);
            if (nd <= thresh) { isBg[n] = 1; queue[qTail++] = n; }
          }
        }
      }

      // Erase background pixels
      for (let i = 0; i < totalPixels; i++) {
        if (isBg[i]) {
          data[i * 4 + 3] = 0;
        }
      }

      // Edge feathering
      if (feather > 0) {
        for (let i = 0; i < totalPixels; i++) {
          if (!isBg[i]) {
            const cx = i % w;
            const cy = (i / w) | 0;
            let nearBg = false;
            for (let dy = -feather; dy <= feather && !nearBg; dy++) {
              const ny = cy + dy;
              if (ny < 0 || ny >= h) continue;
              for (let dx = -feather; dx <= feather && !nearBg; dx++) {
                const nx = cx + dx;
                if (nx < 0 || nx >= w) continue;
                if (isBg[ny * w + nx]) nearBg = true;
              }
            }
            if (nearBg) {
              const d = Math.hypot(data[i * 4] - bgR, data[i * 4 + 1] - bgG, data[i * 4 + 2] - bgB);
              const factor = Math.max(0, Math.min(1, d / (thresh || 1)));
              data[i * 4 + 3] = Math.round(data[i * 4 + 3] * factor);
            }
          }
        }
      }

      oCtx.putImageData(imgData, 0, 0);

      // Render replacement backdrop to display canvas
      ctx.clearRect(0, 0, w, h);
      if (bgType === "white") {
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, w, h);
      } else if (bgType === "passport-blue") {
        ctx.fillStyle = "#3b82f6";
        ctx.fillRect(0, 0, w, h);
      } else if (bgType === "custom") {
        ctx.fillStyle = customColor;
        ctx.fillRect(0, 0, w, h);
      } else if (bgType === "blur") {
        ctx.save();
        ctx.filter = "blur(18px)";
        ctx.drawImage(srcImg, -20, -20, w + 40, h + 40);
        ctx.restore();
      }
      ctx.drawImage(offscreen, 0, 0);

      const typeDesc = bgType === "transparent" ? "transparent PNG" : bgType === "white" ? "pure white backdrop" : bgType === "passport-blue" ? "passport blue" : bgType === "blur" ? "portrait bokeh blur" : "custom color";
      setStatus(`Background removed (${w}×${h}px, ${typeDesc}). Ready to download!`, "ok");
    }

    function initBgRemove() {
      if (isBgRemoveInitialized) return;
      isBgRemoveInitialized = true;

      const bgTypeEl = document.getElementById("tw-bg-type") as HTMLSelectElement;
      const customField = document.getElementById("tw-bg-custom-field");
      const customColorEl = document.getElementById("tw-bg-custom-color");
      const sampleEl = document.getElementById("tw-bg-sample");
      const tolEl = document.getElementById("tw-bg-tolerance") as HTMLInputElement;
      const tolVal = document.getElementById("tw-bg-tol-val");
      const featherEl = document.getElementById("tw-bg-feather") as HTMLInputElement;
      const featherVal = document.getElementById("tw-bg-feather-val");
      const reprocessBtn = document.getElementById("tw-bg-run");
      const restoreBtn = document.getElementById("tw-bg-restore");

      const pTrans = document.getElementById("tw-bg-preset-trans");
      const pWhite = document.getElementById("tw-bg-preset-white");
      const pBlue = document.getElementById("tw-bg-preset-blue");
      const pRed = document.getElementById("tw-bg-preset-red");
      const pDark = document.getElementById("tw-bg-preset-dark");
      const pBlur = document.getElementById("tw-bg-preset-blur");

      function setActivePreset(btn: HTMLElement | null) {
        document.querySelectorAll("#tw-bg-preset-trans, #tw-bg-preset-white, #tw-bg-preset-blue, #tw-bg-preset-red, #tw-bg-preset-dark, #tw-bg-preset-blur").forEach((b) => b.classList.remove("active"));
        btn?.classList.add("active");
      }

      pTrans?.addEventListener("click", () => {
        setActivePreset(pTrans);
        if (bgTypeEl) bgTypeEl.value = "transparent";
        if (customField) customField.style.display = "none";
        renderBgRemove();
      });

      pWhite?.addEventListener("click", () => {
        setActivePreset(pWhite);
        if (bgTypeEl) bgTypeEl.value = "white";
        if (customField) customField.style.display = "none";
        renderBgRemove();
      });

      pBlue?.addEventListener("click", () => {
        setActivePreset(pBlue);
        if (bgTypeEl) bgTypeEl.value = "passport-blue";
        if (customField) customField.style.display = "none";
        renderBgRemove();
      });

      pRed?.addEventListener("click", () => {
        setActivePreset(pRed);
        if (bgTypeEl) bgTypeEl.value = "custom";
        if (customColorEl) customColorEl.value = "#ef4444";
        if (customField) customField.style.display = "block";
        renderBgRemove();
      });

      pDark?.addEventListener("click", () => {
        setActivePreset(pDark);
        if (bgTypeEl) bgTypeEl.value = "custom";
        if (customColorEl) customColorEl.value = "#0f172a";
        if (customField) customField.style.display = "block";
        renderBgRemove();
      });

      pBlur?.addEventListener("click", () => {
        setActivePreset(pBlur);
        if (bgTypeEl) bgTypeEl.value = "blur";
        if (customField) customField.style.display = "none";
        renderBgRemove();
      });

      bgTypeEl?.addEventListener("change", () => {
        if (customField) customField.style.display = bgTypeEl.value === "custom" ? "block" : "none";
        renderBgRemove();
      });

      customColorEl?.addEventListener("input", () => renderBgRemove());
      sampleEl?.addEventListener("change", () => renderBgRemove());

      tolEl?.addEventListener("input", () => {
        if (tolVal) tolVal.textContent = tolEl.value;
        renderBgRemove();
      });

      featherEl?.addEventListener("input", () => {
        if (featherVal) featherVal.textContent = featherEl.value;
        renderBgRemove();
      });

      reprocessBtn?.addEventListener("click", () => renderBgRemove(false));
      restoreBtn?.addEventListener("click", () => renderBgRemove(true));
    }

    // Setup initial mode triggers
    function setupInitialMode() {
      if (mode === "compress") {
        refreshCompress();
      } else if (mode === "resize") {
        if (defaultW && defaultH) {
          if (resW) resW.value = String(defaultW);
          if (resH) resH.value = String(defaultH);
        } else if (srcImg) {
          if (resW) resW.value = String(srcImg.naturalWidth);
          if (resH) resH.value = String(srcImg.naturalHeight);
        }
        renderResize();
      } else if (mode === "crop") {
        if (!cropBox) {
          setCenterCrop("free");
        } else {
          drawCropOverlay();
        }
      } else if (mode === "circle") {
        initCircCenter();
        drawCircleOverlay(true);
      } else if (mode === "rotate") {
        if (ws?.getAttribute("data-tool-slug")?.includes("flip")) {
          flipH = true;
        }
        renderRotate();
      } else if (mode === "watermark") {
        renderWatermark();
      } else if (mode === "palette") {
        renderPalette();
      } else if (mode === "blur") {
        renderBlur(true);
      } else if (mode === "collage") {
        renderCollage();
        renderCollageThumbs();
      } else if (mode === "html-to-image") {
        initHtmlToImage();
      } else if (mode === "whatsapp-dp") {
        initWhatsAppDp();
        renderWhatsAppDp(true);
      } else if (mode === "bg-remove") {
        initBgRemove();
        renderBgRemove();
      } else {
        setStatus("Image loaded. Adjust settings and download your processed image.", "ok");
      }
    }

    // Download Handler
    if (downloadBtn) {
      downloadBtn.addEventListener("click", async () => {
        if (mode === "pdf") {
          if (!pdfItems.length) { setStatus("Add at least one image first.", "err"); return; }
          const jspdf = (window as any).jspdf;
          if (!jspdf) { setStatus("PDF generator library unavailable.", "err"); return; }

          try {
            const pageSize = (document.getElementById("tw-pdf-size") as HTMLSelectElement)?.value || "a4";
            const orientation = (document.getElementById("tw-pdf-orientation") as HTMLSelectElement)?.value || "portrait";
            const qualityMode = (document.getElementById("tw-pdf-quality") as HTMLSelectElement)?.value || "balanced";
            let doc: any = null;

            let qualityVal = 0.8;
            let maxDim = 1800;
            if (qualityMode === "300kb") {
              const count = Math.max(1, pdfItems.length);
              qualityVal = count === 1 ? 0.65 : count <= 3 ? 0.5 : 0.35;
              maxDim = 1200;
            } else if (qualityMode === "small") {
              qualityVal = 0.5;
              maxDim = 1000;
            } else if (qualityMode === "high") {
              qualityVal = 0.95;
              maxDim = 2600;
            }

            pdfItems.forEach((it, i) => {
              let w = it.img.naturalWidth, h = it.img.naturalHeight;
              if (w > maxDim || h > maxDim) {
                const s = Math.min(maxDim / w, maxDim / h);
                w = Math.max(1, Math.round(w * s));
                h = Math.max(1, Math.round(h * s));
              }

              const opts = pageSize === "fit"
                ? { orientation: w >= h ? "landscape" : "portrait", unit: "px", format: [w, h] }
                : { orientation, unit: "pt", format: pageSize };
              if (i === 0) doc = new jspdf.jsPDF(opts);
              else doc.addPage(opts.format, opts.orientation);

              const pageW = doc.internal.pageSize.getWidth(), pageH = doc.internal.pageSize.getHeight();
              const margin = 12;
              const scale = Math.min((pageW - margin * 2) / w, (pageH - margin * 2) / h);
              const dw = w * scale, dh = h * scale;
              const x = (pageW - dw) / 2, y = (pageH - dh) / 2;

              const c = document.createElement("canvas");
              c.width = w; c.height = h;
              c.getContext("2d")?.drawImage(it.img, 0, 0, w, h);
              doc.addImage(c.toDataURL("image/jpeg", qualityVal), "JPEG", x, y, dw, dh, undefined, "FAST");
            });

            const blob = doc.output("blob");
            downloadBlob(blob, "document.pdf");
            setStatus(`PDF generated (${fmtBytes(blob.size)}) with ${pdfItems.length} page(s). Ready to download.`, "ok");
          } catch (e: any) {
            setStatus("Could not generate PDF: " + e?.message, "err");
          }
          return;
        }

        if (mode === "html-to-image") {
          if (!canvas || canvas.width === 0 || canvas.height === 0) {
            setStatus("Please render an HTML snippet or decode an image first.", "err");
            return;
          }
          const fmtSelect = (document.getElementById("tw-h2i-fmt") as HTMLSelectElement)?.value || "image/png";
          if (fmtSelect === "application/pdf") {
            const jspdf = (window as any).jspdf;
            if (!jspdf) { setStatus("PDF generator library unavailable.", "err"); return; }
            try {
              const doc = new jspdf.jsPDF({
                orientation: canvas.width >= canvas.height ? "landscape" : "portrait",
                unit: "px",
                format: [canvas.width, canvas.height]
              });
              doc.addImage(canvas.toDataURL("image/jpeg", 0.95), "JPEG", 0, 0, canvas.width, canvas.height, undefined, "FAST");
              const blob = doc.output("blob");
              downloadBlob(blob, "html-render.pdf");
              setStatus(`Downloaded PDF document (${fmtBytes(blob.size)}).`, "ok");
            } catch (err: any) {
              setStatus("Could not generate PDF: " + err?.message, "err");
            }
            return;
          }

          canvas.toBlob((blob) => {
            if (blob) {
              const ext = fmtSelect === "image/jpeg" ? "jpg" : fmtSelect === "image/webp" ? "webp" : "png";
              downloadBlob(blob, `html-render.${ext}`);
              setStatus(`Downloaded ${ext.toUpperCase()} image (${fmtBytes(blob.size)}).`, "ok");
            }
          }, fmtSelect, 0.95);
          return;
        }

        if (mode === "whatsapp-dp") {
          const bgType = (document.getElementById("tw-dp-bg") as HTMLSelectElement)?.value;
          if (!srcImg && bgType !== "black") {
            setStatus("Please upload a photo first or select Full Black DP.", "err");
            return;
          }
          renderWhatsAppDp(false); // Clean export without circle guide
          const cvtFmt = defaultFmt || "image/jpeg";
          canvas.toBlob((blob) => {
            if (blob) {
              const ext = cvtFmt === "image/png" ? "png" : "jpg";
              const prefix = bgType === "black" && !srcImg ? "full-black-whatsapp-dp" : "whatsapp-full-dp";
              downloadBlob(blob, `${prefix}.${ext}`);
              setStatus(`Downloaded WhatsApp Full DP (${canvas.width}×${canvas.height}px, ${fmtBytes(blob.size)}). No crop!`, "ok");
              renderWhatsAppDp(true); // Restore guide after capture
            }
          }, cvtFmt, 0.95);
          return;
        }

        if (mode === "palette") {
          if (!currentPaletteColors.length) {
            renderPalette();
          }
          if (!currentPaletteColors.length) {
            setStatus("No color palette available to export.", "err");
            return;
          }

          const outW = 1200;
          const outH = 630;
          const out = document.createElement("canvas");
          out.width = outW;
          out.height = outH;
          const octx = out.getContext("2d");
          if (!octx) return;

          const bgGrad = octx.createLinearGradient(0, 0, outW, outH);
          bgGrad.addColorStop(0, "#0c0d12");
          bgGrad.addColorStop(1, "#181a24");
          octx.fillStyle = bgGrad;
          octx.fillRect(0, 0, outW, outH);

          octx.fillStyle = "#ffffff";
          octx.font = "bold 28px system-ui, -apple-system, sans-serif";
          octx.fillText("COLOR PALETTE & SEASONAL ANALYSIS", 50, 60);

          const seasonText = palSeasonTitle?.textContent?.replace("Color Season Analysis: ", "") || "Warm Autumn";
          octx.fillStyle = "#26e0ff";
          octx.font = "600 18px system-ui, -apple-system, sans-serif";
          octx.fillText(`Archetype: ${seasonText} • Client-Side Extract`, 50, 92);

          const hasImage = srcImg && canvas && canvas.width > 0;
          if (hasImage) {
            const imgBoxX = 50, imgBoxY = 130, imgBoxW = 440, imgBoxH = 430;
            octx.save();
            octx.beginPath();
            octx.roundRect(imgBoxX, imgBoxY, imgBoxW, imgBoxH, 16);
            octx.clip();
            const imgRatio = srcImg.naturalWidth / srcImg.naturalHeight;
            const boxRatio = imgBoxW / imgBoxH;
            let sx = 0, sy = 0, sw = srcImg.naturalWidth, sh = srcImg.naturalHeight;
            if (imgRatio > boxRatio) {
              sw = sh * boxRatio;
              sx = (srcImg.naturalWidth - sw) / 2;
            } else {
              sh = sw / boxRatio;
              sy = (srcImg.naturalHeight - sh) / 2;
            }
            octx.drawImage(srcImg, sx, sy, sw, sh, imgBoxX, imgBoxY, imgBoxW, imgBoxH);
            octx.restore();

            octx.strokeStyle = "rgba(255, 255, 255, 0.15)";
            octx.lineWidth = 2;
            octx.beginPath();
            octx.roundRect(imgBoxX, imgBoxY, imgBoxW, imgBoxH, 16);
            octx.stroke();

            const swatchStartX = 520;
            const swatchTotalW = outW - swatchStartX - 50;
            const numSwatches = currentPaletteColors.length;
            const barH = Math.floor((imgBoxH - (numSwatches - 1) * 12) / numSwatches);

            currentPaletteColors.forEach((c, i) => {
              const sy = imgBoxY + i * (barH + 12);
              const hex = rgbToHex(c[0], c[1], c[2]);
              const rgbStr = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;

              octx.fillStyle = hex;
              octx.beginPath();
              octx.roundRect(swatchStartX, sy, swatchTotalW, barH, 10);
              octx.fill();

              const lum = 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2];
              octx.fillStyle = lum > 140 ? "#0c0d12" : "#ffffff";
              octx.font = "bold 18px monospace";
              octx.fillText(hex.toUpperCase(), swatchStartX + 20, sy + barH / 2 + 6);

              octx.font = "500 13px system-ui, sans-serif";
              octx.fillText(rgbStr, swatchStartX + 140, sy + barH / 2 + 5);
            });
          } else {
            const numSwatches = currentPaletteColors.length;
            const cardW = Math.floor((outW - 100 - (numSwatches - 1) * 14) / numSwatches);
            const cardH = 430;
            const startY = 130;

            currentPaletteColors.forEach((c, i) => {
              const cx = 50 + i * (cardW + 14);
              const hex = rgbToHex(c[0], c[1], c[2]);
              const rgbStr = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;

              octx.fillStyle = hex;
              octx.beginPath();
              octx.roundRect(cx, startY, cardW, cardH, 12);
              octx.fill();

              const lum = 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2];
              octx.fillStyle = lum > 140 ? "rgba(0,0,0,0.85)" : "rgba(255,255,255,0.95)";
              octx.font = "bold 16px monospace";
              octx.fillText(hex.toUpperCase(), cx + 12, startY + cardH - 34);
              octx.font = "500 11px system-ui, sans-serif";
              octx.fillText(rgbStr, cx + 12, startY + cardH - 14);
            });
          }

          octx.fillStyle = "#64748b";
          octx.font = "12px system-ui, -apple-system, sans-serif";
          octx.fillText("Generated with ImageAllTools Color Palette Studio • https://imagealltools.com/color-palette", 50, 600);

          out.toBlob((blob) => {
            if (blob) {
              downloadBlob(blob, "color-palette-swatch-card.png");
              setStatus(`Downloaded Color Palette Presentation Card (${outW}×${outH}px, ${fmtBytes(blob.size)}).`, "ok");
            }
          }, "image/png", 0.95);
          return;
        }

        if (!srcImg && !lastBlob) {
          setStatus("Please upload an image first.", "err");
          return;
        }

        if (mode === "crop" && cropBox && Math.abs(cropBox.w) > 2 && Math.abs(cropBox.h) > 2 && srcImg) {
          const bx = Math.min(cropBox.x, cropBox.x + cropBox.w);
          const by = Math.min(cropBox.y, cropBox.y + cropBox.h);
          const bw = Math.round(Math.abs(cropBox.w));
          const bh = Math.round(Math.abs(cropBox.h));

          const out = document.createElement("canvas");
          out.width = bw;
          out.height = bh;
          const outCtx = out.getContext("2d");
          if (!outCtx) return;

          const chosenFmt = cropFmtEl?.value || "png";
          const isCircle = cropShape === "circle";

          if (isCircle) {
            outCtx.save();
            outCtx.beginPath();
            outCtx.ellipse(bw / 2, bh / 2, bw / 2, bh / 2, 0, 0, Math.PI * 2);
            outCtx.clip();
            outCtx.drawImage(srcImg, bx, by, bw, bh, 0, 0, bw, bh);
            outCtx.restore();
          } else {
            outCtx.drawImage(srcImg, bx, by, bw, bh, 0, 0, bw, bh);
          }

          let mime = "image/png";
          let ext = "png";
          if (!isCircle) {
            if (chosenFmt === "jpg") { mime = "image/jpeg"; ext = "jpg"; }
            else if (chosenFmt === "webp") { mime = "image/webp"; ext = "webp"; }
          } else if (chosenFmt === "webp") {
            mime = "image/webp";
            ext = "webp";
          }

          out.toBlob((blob) => {
            if (blob) {
              const filename = isCircle ? `circle-avatar.${ext}` : `cropped-image.${ext}`;
              downloadBlob(blob, filename);
              setStatus(`Downloaded ${isCircle ? "circle avatar" : "cropped image"} (${bw}×${bh}px, ${fmtBytes(blob.size)}).`, "ok");
            }
          }, mime, 0.95);
          return;
        }

        if (mode === "bg-remove" && canvas && srcImg) {
          const bgType = (document.getElementById("tw-bg-type") as HTMLSelectElement)?.value || "transparent";
          const fmtSelect = (document.getElementById("tw-bg-fmt") as HTMLSelectElement)?.value || (bgType === "transparent" ? "image/png" : "image/jpeg");
          const ext = fmtSelect === "image/jpeg" ? "jpg" : fmtSelect === "image/webp" ? "webp" : "png";
          const prefix = bgType === "transparent" ? "transparent-cutout" : bgType === "white" ? "white-background-product" : bgType === "passport-blue" ? "passport-photo" : "background-removed";

          canvas.toBlob((blob) => {
            if (blob) {
              downloadBlob(blob, `${prefix}.${ext}`);
              setStatus(`Downloaded ${prefix}.${ext} (${canvas.width}×${canvas.height}px, ${fmtBytes(blob.size)}).`, "ok");
            }
          }, fmtSelect, 0.95);
          return;
        }

        if (mode === "circle" && srcImg && circCenter.r > 2) {
          const r = circCenter.r;
          const diam = Math.round(r * 2);
          const out = document.createElement("canvas");
          out.width = diam;
          out.height = diam;
          const octx = out.getContext("2d");
          if (octx) {
            const bgChoice = circBgEl?.value || "transparent";
            const customBg = circCustomBgEl?.value || "#ffffff";
            const borderWidth = Number(circBorderWidthEl?.value) || 0;
            const borderColor = circBorderColorEl?.value || "#ef4444";

            if (bgChoice === "custom") {
              octx.fillStyle = customBg;
              octx.fillRect(0, 0, diam, diam);
            } else if (bgChoice !== "transparent") {
              octx.fillStyle = bgChoice;
              octx.fillRect(0, 0, diam, diam);
            }

            octx.save();
            octx.beginPath();
            const drawR = Math.max(1, r - (borderWidth > 0 ? borderWidth / 2 : 0));
            octx.arc(r, r, drawR, 0, Math.PI * 2);
            octx.clip();

            const sx = circCenter.x - r;
            const sy = circCenter.y - r;
            octx.drawImage(srcImg, sx, sy, diam, diam, 0, 0, diam, diam);
            octx.restore();

            if (borderWidth > 0) {
              octx.save();
              octx.strokeStyle = borderColor;
              octx.lineWidth = borderWidth;
              octx.beginPath();
              octx.arc(r, r, drawR, 0, Math.PI * 2);
              octx.stroke();
              octx.restore();
            }

            out.toBlob((blob) => {
              if (blob) {
                downloadBlob(blob, "circle-cropped.png");
                setStatus(`Downloaded circular image (${fmtBytes(blob.size)}).`, "ok");
              }
            }, "image/png");
          }
          return;
        }

        if (mode === "blur" && canvas && srcImg) {
          renderBlur(false); // Render clean image without dashed guide box
          const cvtFmt = defaultFmt || "image/png";
          canvas.toBlob((blob) => {
            if (blob) {
              const ext = cvtFmt === "image/jpeg" ? "jpg" : cvtFmt === "image/webp" ? "webp" : "png";
              downloadBlob(blob, `blurred-photo.${ext}`);
              setStatus(`Downloaded ${fmtBytes(blob.size)}.`, "ok");
              renderBlur(true); // Restore guide after capture
            }
          }, cvtFmt, 0.95);
          return;
        }

        if (mode === "collage" && canvas) {
          canvas.toBlob((blob) => {
            if (blob) {
              downloadBlob(blob, "photo-collage.png");
              setStatus(`Downloaded photo collage (${fmtBytes(blob.size)}).`, "ok");
            }
          }, "image/png", 0.95);
          return;
        }

        if (mode === "rotate" && canvas && srcImg) {
          const cvtFmt = defaultFmt || "image/png";
          canvas.toBlob((blob) => {
            if (blob) {
              const ext = cvtFmt === "image/jpeg" ? "jpg" : cvtFmt === "image/webp" ? "webp" : "png";
              const prefix = ws?.getAttribute("data-tool-slug")?.includes("flip") ? "flipped-image" : "rotated-image";
              downloadBlob(blob, `${prefix}.${ext}`);
              setStatus(`Downloaded ${prefix} (${fmtBytes(blob.size)}).`, "ok");
            }
          }, cvtFmt, 0.95);
          return;
        }

        if (lastBlob) {
          downloadBlob(lastBlob, "processed-image");
          return;
        }

        if (mode === "resize" && canvas && srcImg) {
          const cvtFmt = defaultFmt || "image/jpeg";
          canvas.toBlob((blob) => {
            if (blob) {
              const ext = cvtFmt === "image/png" ? "png" : "jpg";
              const isIG = ws?.getAttribute("data-tool-slug")?.includes("instagram");
              const isFB = ws?.getAttribute("data-tool-slug")?.includes("facebook");
              const prefix = isIG ? `instagram-post-${canvas.width}x${canvas.height}` : isFB ? `facebook-${canvas.width}x${canvas.height}` : `resized-${canvas.width}x${canvas.height}`;
              downloadBlob(blob, `${prefix}.${ext}`);
              setStatus(`Downloaded ${prefix}.${ext} (${fmtBytes(blob.size)}). Ready to publish!`, "ok");
            }
          }, cvtFmt, 0.92);
          return;
        }

        if (canvas) {
          const cvtFmt = (document.getElementById("tw-cvt-fmt") as HTMLSelectElement)?.value || defaultFmt || "image/png";
          canvas.toBlob((blob) => {
            if (blob) {
              const ext = cvtFmt === "image/jpeg" ? "jpg" : cvtFmt === "image/webp" ? "webp" : "png";
              downloadBlob(blob, `processed.${ext}`);
              setStatus(`Downloaded ${fmtBytes(blob.size)}.`, "ok");
            }
          }, cvtFmt, 0.9);
        }
      });
    }

    // Reset Handler
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        currentFile = null;
        srcImg = null;
        lastBlob = null;
        cropBox = null;
        circCenter = { x: 0, y: 0, r: 0 };
        rotation = 0;
        flipH = false;
        flipV = false;
        pdfItems = [];
        collageItems = [];
        if (input) input.value = "";
        if (canvas && ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (mode === "html-to-image") {
          initHtmlToImage();
        } else if (mode === "whatsapp-dp") {
          initWhatsAppDp();
          if (preview) preview.style.display = "none";
          setStatus("Workspace reset. Upload a photo or click Full Black DP.");
        } else if (mode === "bg-remove") {
          initBgRemove();
          if (preview) preview.style.display = "none";
          setStatus("Workspace reset. Upload an image to remove background.");
        } else if (mode === "palette") {
          currentPaletteColors = [];
          renderPalette(false);
          if (preview) preview.style.display = "none";
          setStatus("Workspace reset. Upload an image to extract colors.");
        } else {
          if (preview) preview.style.display = "none";
          setStatus("Workspace reset. Upload an image to begin.");
        }
      });
    }

    if (mode === "html-to-image") {
      initHtmlToImage();
    } else if (mode === "whatsapp-dp") {
      initWhatsAppDp();
    } else if (mode === "bg-remove") {
      initBgRemove();
    } else if (mode === "palette") {
      renderPalette(false);
    }
  })();
</script>
