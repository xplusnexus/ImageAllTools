---
export interface Props {
  slug?: string;
  toolName?: string;
  engine?: "client" | "server";
  engineModule?: string;
}
const { slug = "image-compressor", toolName = "Image Tool", engine = "client" } = Astro.props;

// Determine tool type from slug
let mode = "compress";
if (slug.includes("resize")) mode = "resize";
else if (slug.includes("html-to-image") || slug.includes("html-to-img") || slug.includes("base64")) mode = "html-to-image";
else if (slug.includes("whatsapp-dp") || slug.includes("full-dp") || slug.includes("no-crop") || slug.includes("dp-maker")) mode = "whatsapp-dp";
else if (slug.includes("circle")) mode = "circle";
else if (slug.includes("crop") || slug.includes("passport")) mode = "crop";
else if (slug.includes("rotate") || slug.includes("flip")) mode = "rotate";
else if (slug.includes("watermark") || slug.includes("add-text") || slug.includes("meme")) mode = "watermark";
else if (slug.includes("pdf")) mode = "pdf";
else if (slug.includes("palette")) mode = "palette";
else if (slug.includes("background") || slug.includes("bg-remove")) mode = "bg-remove";
else if (slug.includes("to-") || slug.includes("convert")) mode = "convert";
else if (slug.includes("blur") || slug.includes("censor") || slug.includes("pixelat")) mode = "blur";
else if (slug.includes("collage")) mode = "collage";

// Default presets
let defaultTargetKB = "100";
if (slug.includes("15kb")) defaultTargetKB = "15";
else if (slug.includes("20kb")) defaultTargetKB = "20";
else if (slug.includes("40kb")) defaultTargetKB = "40";
else if (slug.includes("50kb")) defaultTargetKB = "50";
else if (slug.includes("100kb")) defaultTargetKB = "100";
else if (slug.includes("200kb")) defaultTargetKB = "200";
else if (slug.includes("300kb")) defaultTargetKB = "300";
else if (slug.includes("1mb")) defaultTargetKB = "1024";
else if (slug.includes("2mb")) defaultTargetKB = "2048";

let defaultWidth = "";
let defaultHeight = "";
if (slug.includes("1920x1080")) { defaultWidth = "1920"; defaultHeight = "1080"; }
else if (slug.includes("1080x1080")) { defaultWidth = "1080"; defaultHeight = "1080"; }
else if (slug.includes("512x512")) { defaultWidth = "512"; defaultHeight = "512"; }
else if (slug.includes("youtube-thumbnail")) { defaultWidth = "1280"; defaultHeight = "720"; }
else if (slug.includes("instagram")) { defaultWidth = "1080"; defaultHeight = "1080"; }
else if (slug.includes("facebook")) { defaultWidth = "1200"; defaultHeight = "630"; }
else if (slug.includes("linkedin")) { defaultWidth = "1200"; defaultHeight = "627"; }

let defaultFormat = "image/jpeg";
if (slug.includes("to-png")) defaultFormat = "image/png";
else if (slug.includes("to-webp")) defaultFormat = "image/webp";
else if (slug.includes("to-jpg")) defaultFormat = "image/jpeg";
---
<div
  class="workspace"
  id="active-tool-workspace"
  data-tool-slug={slug}
  data-tool-mode={mode}
  data-target-kb={defaultTargetKB}
  data-default-w={defaultWidth}
  data-default-h={defaultHeight}
  data-default-fmt={defaultFormat}
>
  <!-- Universal Dropzone -->
  <div class="dropzone" id="tw-drop" tabindex="0" role="button" aria-label={`Upload image for ${toolName}`}>
    {mode === "html-to-image" ? (
      <span><strong>Paste HTML/CSS code or drag an image / Base64</strong> here. Convert code to PNG/JPG or images to Base64 Data URIs.</span>
    ) : mode === "whatsapp-dp" ? (
      <span><strong>Click to upload</strong> or drag your full photo here. Fit any vertical or horizontal picture into a WhatsApp Full DP with no crop!</span>
    ) : slug.includes("instagram") ? (
      <span><strong>Click to upload</strong> or drag your photo here. Resize for Instagram posts (1:1 Square, 4:5 Portrait) and Stories (9:16) without cropping!</span>
    ) : slug.includes("facebook") ? (
      <span><strong>Click to upload</strong> or drag your photo here. Resize for Facebook profile picture (1:1), cover photo (820×312), and feed posts (1200×630) with no crop!</span>
    ) : mode === "palette" ? (
      <span><strong>Click to upload</strong> or drag your photo, artwork, or UI design here. Extract dominant colors, seasonal color palettes, and hex codes instantly!</span>
    ) : mode === "bg-remove" ? (
      <span><strong>Click to upload</strong> or drag your portrait, product, logo, or signature here. Instant background removal with transparent PNG cutout or solid studio backdrop!</span>
    ) : mode === "crop" ? (
      <span><strong>Click to upload</strong> or drag your image here. Crop freeform or lock to 1:1 Square, 4:5, 16:9, Passport, or Circular avatar shapes!</span>
    ) : mode === "collage" ? (
      <span><strong>Click to upload</strong> or drag 2 to 9+ photos here to build your collage. Supports JPG, PNG, WEBP, AVIF.</span>
    ) : mode === "pdf" ? (
      <span><strong>Click to upload</strong> or drag multiple images here to convert to PDF.</span>
    ) : (
      <span><strong>Click to upload</strong> or drag an image here. Supports JPG, PNG, WEBP, GIF, SVG, AVIF.</span>
    )}
  </div>
  <input type="file" id="tw-input" accept="image/*,.heic,.heif,.avif,.tif,.tiff,.svg" multiple={mode === "pdf" || mode === "collage"} hidden />

  <!-- Multi-file PDF list container (only for PDF) -->
  {mode === "pdf" && <div id="tw-pdf-list" class="pdf-list"></div>}

  <!-- Preview Row (hidden until image loaded, or displayed immediately for html-to-image) -->
  <div class="preview-row" id="tw-preview" style={mode === "html-to-image" ? "display:grid;" : "display:none;"}>
    {mode !== "pdf" && (
      <div class="canvas-holder">
        <canvas id="tw-canvas"></canvas>
      </div>
    )}

    <!-- ================= MODE CONTROLS ================= -->
    {mode === "compress" && (
      <div class="controls">
        <div class="field">
          <label for="tw-cmp-fmt">Output format</label>
          <select id="tw-cmp-fmt">
            <option value="image/jpeg" selected={defaultFormat === "image/jpeg"}>JPG</option>
            <option value="image/webp" selected={defaultFormat === "image/webp"}>WEBP</option>
            <option value="image/png" selected={defaultFormat === "image/png"}>PNG (lossless)</option>
          </select>
        </div>
        <div class="field">
          <span class="field-label">Compression method</span>
          <div class="mode-switch" role="group" aria-label="Compression method">
            <button class={`mode-option ${slug.includes("kb") ? "" : "active"}`} id="tw-cmp-q-mode" type="button">Quality</button>
            <button class={`mode-option ${slug.includes("kb") ? "active" : ""}`} id="tw-cmp-t-mode" type="button">Target file size</button>
          </div>
        </div>
        <div class="field" id="tw-cmp-q-field">
          <label for="tw-cmp-q">Quality (<span id="tw-cmp-q-val">80</span>%)</label>
          <input type="range" id="tw-cmp-q" min="10" max="100" value="80" disabled={slug.includes("kb")} />
        </div>
        <div class="field" id="tw-cmp-t-field">
          <label for="tw-cmp-t">Target size (KB)</label>
          <div class="target-inline">
            <input type="number" id="tw-cmp-t" min="1" value={defaultTargetKB} disabled={!slug.includes("kb")} />
            <span class="helper">KB maximum goal</span>
          </div>
          <div class="target-presets">
            {[
              { kb: "15", label: "15 KB" },
              { kb: "20", label: "20 KB" },
              { kb: "40", label: "40 KB" },
              { kb: "50", label: "50 KB" },
              { kb: "100", label: "100 KB" },
              { kb: "200", label: "200 KB" },
              { kb: "300", label: "300 KB" },
              { kb: "1024", label: "1 MB" },
              { kb: "2048", label: "2 MB" },
            ].map(({ kb, label }) => (
              <button class={`preset ${defaultTargetKB === kb ? "active" : ""}`} type="button" data-kb={kb}>{label}</button>
            ))}
          </div>
        </div>
      </div>
      <div class="metrics" aria-live="polite">
        <div class="metric"><div class="metric-label">Original</div><div class="metric-value" id="tw-cmp-orig">—</div></div>
        <div class="metric"><div class="metric-label">Quality</div><div class="metric-value" id="tw-cmp-metric-q">80%</div></div>
        <div class="metric"><div class="metric-label">New size</div><div class="metric-value" id="tw-cmp-new">—</div></div>
        <div class="metric"><div class="metric-label">Reduction</div><div class="metric-value" id="tw-cmp-red">—</div></div>
      </div>
    )}

    {mode === "resize" && (
      <div class="controls">
        <div class="field col-span-full">
          <span class="field-label">Quick Presets</span>
          {slug.includes("facebook") ? (
            <div class="target-presets mt-1">
              <button class="preset active" type="button" data-preset-w="1200" data-preset-h="630">📱 Feed Post (1200×630 - Link / 1.91:1)</button>
              <button class="preset" type="button" data-preset-w="2048" data-preset-h="2048">👤 Profile Picture (2048×2048 HD - 1:1)</button>
              <button class="preset" type="button" data-preset-w="820" data-preset-h="312">🖼️ Cover Photo (820×312 Desktop Safe)</button>
              <button class="preset" type="button" data-preset-w="1640" data-preset-h="624">🌟 Cover Photo HD (1640×624 - 2x Retina)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1080">📸 Square Post (1080×1080 - 1:1)</button>
              <button class="preset" type="button" data-preset-w="1920" data-preset-h="1005">🎉 Event Banner (1920×1005)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1920">🎬 Story & Reel (1080×1920)</button>
            </div>
          ) : slug.includes("instagram") ? (
            <div class="target-presets mt-1">
              <button class="preset active" type="button" data-preset-w="1080" data-preset-h="1080">📸 Square 1:1 (1080×1080)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1350">📱 Portrait 4:5 (1080×1350 - Best)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1920">🎬 Story / Reel 9:16 (1080×1920)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="566">🖼️ Landscape 1.91:1 (1080×566)</button>
              <button class="preset" type="button" data-preset-w="1200" data-preset-h="630">📘 Facebook (1200×630)</button>
            </div>
          ) : (
            <div class="target-presets mt-1">
              <button class="preset" type="button" data-preset-w="1920" data-preset-h="1080">1920×1080 (HD)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1080">1080×1080 (Square)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1350">1080×1350 (IG 4:5)</button>
              <button class="preset" type="button" data-preset-w="1080" data-preset-h="1920">1080×1920 (Story)</button>
              <button class="preset" type="button" data-preset-w="1200" data-preset-h="630">1200×630 (Social)</button>
              <button class="preset" type="button" data-preset-w="1280" data-preset-h="720">1280×720 (YouTube)</button>
            </div>
          )}
        </div>

        <div class="field">
          <label for="tw-res-fit">Fit & No-Crop Method</label>
          <select id="tw-res-fit">
            <option value="blur" selected={slug.includes("instagram") || slug.includes("facebook")}>✨ Fit (No-Crop) with Aesthetic Blur</option>
            <option value="white">🤍 Fit (No-Crop) with Clean White Padding</option>
            <option value="black">🖤 Fit (No-Crop) with Black Letterbox</option>
            <option value="cover">✂️ Center Crop to Fill (No Borders)</option>
            <option value="stretch" selected={!slug.includes("instagram") && !slug.includes("facebook")}>↔️ Stretch / Exact Dimensions</option>
          </select>
        </div>

        <div class="field">
          <label for="tw-res-pad">Padding / Margin (<span id="tw-res-pad-val">0</span>%)</label>
          <input type="range" id="tw-res-pad" min="0" max="25" value="0" />
        </div>

        <div class="field">
          <label for="tw-res-w">Width (px)</label>
          <input type="number" id="tw-res-w" min="1" value={defaultWidth} />
        </div>
        <div class="field">
          <label for="tw-res-h">Height (px)</label>
          <input type="number" id="tw-res-h" min="1" value={defaultHeight} />
        </div>
        <div class="field">
          <label class="flex items-center gap-2 cursor-pointer pt-3">
            <input type="checkbox" id="tw-res-lock" checked={!slug.includes("instagram")} />
            <span class="text-xs text-white font-medium">Lock aspect ratio</span>
          </label>
        </div>
        <div class="field">
          <label for="tw-res-pct">Scale (<span id="tw-res-pct-val">100</span>%)</label>
          <input type="range" id="tw-res-pct" min="5" max="200" value="100" />
        </div>
        <div class="field col-span-full">
          <button class="btn btn-primary" id="tw-res-apply" type="button">🔄 Apply Resize & Render</button>
        </div>
      </div>
    )}

    {mode === "crop" && (
      <div class="controls">
        <div class="field col-span-full">
          <span class="field-label">Crop Aspect Ratio Presets</span>
          <div class="target-presets mt-1">
            <button class="preset active" type="button" data-crop-ratio="free">✨ Freeform</button>
            <button class="preset" type="button" data-crop-ratio="1">📸 1:1 Square (PFP / Avatar)</button>
            <button class="preset" type="button" data-crop-ratio="0.8">📱 4:5 Portrait (IG Feed)</button>
            <button class="preset" type="button" data-crop-ratio="1.7778">🖥️ 16:9 Landscape (YouTube)</button>
            <button class="preset" type="button" data-crop-ratio="0.5625">🎬 9:16 Story / Reel</button>
            <button class="preset" type="button" data-crop-ratio="1.3333">📷 4:3 Standard</button>
            <button class="preset" type="button" data-crop-ratio="1.5">🖼️ 3:2 DSLR Print</button>
            <button class="preset" type="button" data-crop-ratio="0.7778">🛂 35:45 (Passport / Visa)</button>
          </div>
        </div>

        <div class="field">
          <label for="tw-crop-shape">Crop Shape</label>
          <select id="tw-crop-shape">
            <option value="rect" selected>Rectangle / Square</option>
            <option value="circle">⭕ Circle / Round Avatar (Transparent PNG)</option>
          </select>
        </div>

        <div class="field">
          <label for="tw-crop-fmt">Output Format</label>
          <select id="tw-crop-fmt">
            <option value="image/png" selected>PNG (Lossless / Transparent)</option>
            <option value="image/jpeg">JPG (Compressed / Small Size)</option>
            <option value="image/webp">WEBP (Modern Web)</option>
          </select>
        </div>

        <div class="field col-span-full">
          <div class="text-xs text-slate-100 flex items-center justify-between pt-1">
            <span>Selection: <strong id="tw-crop-dims" class="text-white font-bold">Draw box or select preset</strong></span>
            <button class="btn btn-sm btn-ghost text-xs" id="tw-crop-center-btn" type="button">🎯 Center 80% Box</button>
          </div>
        </div>
      </div>
    )}

    {mode === "circle" && (
      <div class="controls">
        <div class="field">
          <label for="tw-circ-bg">Background outside circle</label>
          <select id="tw-circ-bg">
            <option value="transparent" selected>Transparent PNG (Zero Background)</option>
            <option value="#ffffff">Solid White (#ffffff)</option>
            <option value="#0c0d12">Solid Dark Slate (#0c0d12)</option>
            <option value="#fdfbf7">Aesthetic Cream (#fdfbf7)</option>
            <option value="custom">Custom Color Picker</option>
          </select>
        </div>
        <div class="field" id="tw-circ-custom-bg-field" style="display:none;">
          <label for="tw-circ-custom-bg">Pick background color</label>
          <input type="color" id="tw-circ-custom-bg" value="#ffffff" />
        </div>
        <div class="field">
          <label for="tw-circ-border-width">Profile ring border (<span id="tw-circ-border-width-val">0</span>px)</label>
          <input type="range" id="tw-circ-border-width" min="0" max="36" value="0" />
        </div>
        <div class="field">
          <label for="tw-circ-border-color">Ring / Border color</label>
          <div class="flex items-center gap-2">
            <input type="color" id="tw-circ-border-color" value="#ef4444" class="w-10 h-9 p-1 rounded border border-border cursor-pointer bg-transparent" />
            <div class="flex gap-1.5 flex-wrap">
              <button class="w-6 h-6 rounded-full border border-border/80 bg-[#ef4444]" type="button" data-circ-color="#ef4444" title="Red Circle (+30% Trend)"></button>
              <button class="w-6 h-6 rounded-full border border-border/80 bg-[#26e0ff]" type="button" data-circ-color="#26e0ff" title="Neon Cyan"></button>
              <button class="w-6 h-6 rounded-full border border-border/80 bg-[#eab308]" type="button" data-circ-color="#eab308" title="Gold Ring"></button>
              <button class="w-6 h-6 rounded-full border border-border/80 bg-[#ffffff]" type="button" data-circ-color="#ffffff" title="White Ring"></button>
              <button class="w-6 h-6 rounded-full border border-border/80 bg-[#0c0d12]" type="button" data-circ-color="#0c0d12" title="Dark Slate Ring"></button>
            </div>
          </div>
        </div>
        <div class="field col-span-full flex gap-2">
          <button class="btn btn-ghost" id="tw-circ-center" type="button">🎯 Center Circle</button>
          <button class="btn btn-ghost" id="tw-circ-max" type="button">⛶ Fit Full Width/Height</button>
        </div>
      </div>
    )}

    {mode === "rotate" && (
      <div class="controls">
        <div class="field col-span-full">
          <label class="block mb-2 font-bold text-white">{slug.includes("flip") ? "Mirror & Flip Options" : "Rotate & Orientation Controls"}</label>
          <div class="flex gap-2.5 flex-wrap">
            <button class={`btn ${slug.includes("flip") ? "btn-primary" : "btn-ghost"}`} id="tw-flip-h" type="button">⇋ Flip Horizontal (Mirror Left/Right)</button>
            <button class="btn btn-ghost" id="tw-flip-v" type="button">⇵ Flip Vertical (Upside Down)</button>
            <button class="btn btn-ghost" id="tw-rot-right" type="button">⟳ Rotate 90° Clockwise</button>
            <button class="btn btn-ghost" id="tw-rot-left" type="button">⟲ Rotate 90° Counter-Clockwise</button>
            <button class="btn btn-ghost" id="tw-rot-reset" type="button">↺ Reset Orientation</button>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <span class="text-xs text-slate-100 font-medium" id="tw-flip-status">Orientation: Original | Angle: 0°</span>
          </div>
        </div>
      </div>
    )}

    {mode === "watermark" && (
      <div class="controls">
        {slug.includes("meme") ? (
          <>
            <div class="field col-span-full">
              <label for="tw-wm-text">Top meme text</label>
              <input type="text" id="tw-wm-text" value="ONE DOES NOT SIMPLY" />
            </div>
            <div class="field col-span-full">
              <label for="tw-meme-bottom">Bottom meme text</label>
              <input type="text" id="tw-meme-bottom" value="CREATE MEMES WITH WATERMARKS" />
            </div>
          </>
        ) : (
          <div class="field col-span-full">
            <label for="tw-wm-text">{slug.includes("add-text") ? "Text to add on image" : "Watermark / Caption text"}</label>
            <input type="text" id="tw-wm-text" value={slug.includes("add-text") ? "Your Text Here" : "ImageAll / XPlus Nexus"} />
          </div>
        )}
        <div class="field">
          <label for="tw-wm-font">Font style / Meme font</label>
          <select id="tw-wm-font">
            <option value="'Impact', sans-serif" selected={slug.includes("meme")}>Classic Meme Font (Impact)</option>
            <option value="'Space Grotesk', sans-serif" selected={!slug.includes("meme")}>Modern Bold (Space Grotesk)</option>
            <option value="'Inter', sans-serif">Clean Minimal (Inter)</option>
            <option value="Georgia, serif">Classic Editorial (Serif)</option>
            <option value="'Courier New', monospace">Typewriter (Monospace)</option>
            <option value="cursive">Handwriting Script</option>
          </select>
        </div>
        <div class="field">
          <label for="tw-wm-color">Text color</label>
          <input type="color" id="tw-wm-color" value="#ffffff" />
        </div>
        <div class="field">
          <label for="tw-wm-size">Font size (<span id="tw-wm-size-val">{slug.includes("meme") ? "52" : "42"}</span>px)</label>
          <input type="range" id="tw-wm-size" min="16" max="220" value={slug.includes("meme") ? "52" : "42"} />
        </div>
        <div class="field">
          <label for="tw-wm-opacity">Opacity (<span id="tw-wm-opacity-val">100</span>%)</label>
          <input type="range" id="tw-wm-opacity" min="10" max="100" value="100" />
        </div>
        {!slug.includes("meme") && (
          <div class="field">
            <label for="tw-wm-pos">Position</label>
            <select id="tw-wm-pos">
              <option value="center" selected>Center (Hero Overlay)</option>
              <option value="top-center">Top Center (Header)</option>
              <option value="bottom-center">Bottom Center (Subtitle)</option>
              <option value="bottom-right">Bottom Right (Signature)</option>
              <option value="bottom-left">Bottom Left</option>
              <option value="top-right">Top Right</option>
              <option value="top-left">Top Left</option>
              <option value="tile">Repeating Tile Watermark</option>
            </select>
          </div>
        )}
        <div class="field">
          <label class="flex items-center gap-2 cursor-pointer pt-3">
            <input type="checkbox" id="tw-wm-shadow" checked />
            <span class="text-xs text-white font-medium">{slug.includes("meme") ? "Heavy black stroke (Classic Meme outline)" : "Dark text outline (always readable)"}</span>
          </label>
        </div>
      </div>
    )}

    {mode === "html-to-image" && (
      <div class="controls">
        <div class="field col-span-full">
          <span class="field-label">Conversion Mode</span>
          <div class="mode-switch" role="group" aria-label="HTML to Image Mode Selection">
            <button class="mode-option active" id="tw-h2i-tab-code" type="button">💻 HTML / CSS to Image</button>
            <button class="mode-option" id="tw-h2i-tab-img2b64" type="button">🖼️ Image to Base64 & HTML</button>
            <button class="mode-option" id="tw-h2i-tab-b642img" type="button">🔄 Base64 to Image</button>
          </div>
        </div>

        <!-- TAB 1: HTML / CSS to Image -->
        <div id="tw-h2i-pane-code" class="col-span-full grid grid-cols-1 md:grid-cols-2 gap-3">
          <div class="field col-span-full">
            <span class="field-label">Quick Starter Templates</span>
            <div class="target-presets mt-1">
              <button class="preset active" type="button" id="tw-h2i-preset-card">Modern Card</button>
              <button class="preset" type="button" id="tw-h2i-preset-code">Code Terminal</button>
              <button class="preset" type="button" id="tw-h2i-preset-quote">Testimonial Quote</button>
              <button class="preset" type="button" id="tw-h2i-preset-pricing">Pricing Badge</button>
              <button class="preset" type="button" id="tw-h2i-preset-receipt">Receipt / Invoice</button>
            </div>
          </div>

          <div class="field col-span-full">
            <div class="flex justify-between items-center mb-1">
              <label for="tw-h2i-code" class="font-bold text-xs text-white">HTML & Inline CSS Code</label>
              <span class="text-xs text-cyan font-semibold">HTML5, Flexbox & Gradients supported</span>
