---
export interface Props {
  slug: string;
  h1: string;
  description: string;
  category?: string;
  isNew?: boolean;
}
const { slug, h1, description, category, isNew = false } = Astro.props;
---
<a
  href={`/${slug}`}
  class="group relative block p-5 rounded-2xl border border-[#334468] bg-gradient-to-b from-[#151d31] to-[#1c263e] hover:border-cyan hover:shadow-[0_4px_24px_rgba(38,224,255,0.15)] transition-all duration-200"
>
  <div class="flex items-center justify-between mb-2">
    <span class="text-xs uppercase font-bold tracking-wider text-cyan">{category || "Tool"}</span>
    {isNew && (
      <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-gradient-to-r from-cyan to-purple text-[#04141a]">
        New
      </span>
    )}
  </div>
  <div class="font-display font-bold text-white group-hover:text-cyan transition-colors text-sm sm:text-base mb-1.5 leading-snug">
    {h1}
  </div>
  <p class="text-xs sm:text-sm text-slate-100 line-clamp-2 leading-relaxed font-normal">
    {description}
  </p>
</a>
