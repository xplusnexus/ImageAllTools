---
export interface Props {
  slug: string;
  h1: string;
  description: string;
  category?: string;
  isNew?: boolean;
}

const { slug, h1, description, category, isNew = false } = Astro.props;

const categoryMap: Record<string, string> = {
  optimize: "Optimize & Compress",
  create: "Create & Enhance",
  edit: "Edit, Crop & Transform",
  convert: "Format Converters",
  security: "Security & Privacy",
};

const displayCategory = categoryMap[category?.toLowerCase() || ""] || category || "Image Tool";

function getToolIcon(slugStr: string, titleStr: string): string {
  const s = `${slugStr} ${titleStr}`.toLowerCase();
  if (s.includes("compress")) return "🗜️";
  if (s.includes("resize") || s.includes("1080") || s.includes("1920") || s.includes("512")) return "📐";
  if (s.includes("crop") || s.includes("circle") || s.includes("avatar") || s.includes("pfp") || s.includes("dp")) return "✂️";
  if (s.includes("background") || s.includes("bg") || s.includes("cutout")) return "🪄";
  if (s.includes("rotate") || s.includes("flip")) return "⟳";
  if (s.includes("watermark")) return "🏷️";
  if (s.includes("pdf")) return "📄";
  if (s.includes("palette") || s.includes("color") || s.includes("picker")) return "🎨";
  if (s.includes("blur") || s.includes("pixelat")) return "👁️";
  if (s.includes("upscaler")) return "🚀";
  if (s.includes("text") || s.includes("ocr")) return "🔤";
  if (s.includes("collage") || s.includes("meme")) return "🖼️";
  if (s.includes("passport")) return "🛂";
  if (s.includes("metadata") || s.includes("exif")) return "🛡️";
  if (s.includes("beautifier") || s.includes("screenshot")) return "✨";
  if (s.includes("to-") || s.includes("converter") || s.includes("convert")) return "🔄";
  return "⚡";
}

const icon = getToolIcon(slug, h1);
---
<article
  class="tool-card group relative flex flex-col justify-between h-full rounded-2xl border border-[#2e3e60] bg-gradient-to-b from-[#151e33] via-[#162138] to-[#1a2640] p-5 transition-all duration-300 focus-within:ring-2 focus-within:ring-cyan shadow-sm"
  itemscope
  itemtype="https://schema.org/SoftwareApplication"
  data-tool-slug={slug}
  data-tool-category={displayCategory}
>
  <!-- Schema.org Microdata for Top 1 Search & Answer Engine (AEO) Ranking -->
  <meta itemprop="applicationCategory" content="MultimediaApplication" />
  <meta itemprop="applicationSubCategory" content="PhotoEditorApplication" />
  <meta itemprop="operatingSystem" content="All (Web Browser, Windows, macOS, Linux, iOS, Android)" />
  <meta itemprop="browserRequirements" content="Requires JavaScript. Requires HTML5 Canvas." />
  <meta itemprop="softwareVersion" content="2.5.0" />
  <div itemprop="offers" itemscope itemtype="https://schema.org/Offer" class="sr-only">
    <meta itemprop="price" content="0" />
    <meta itemprop="priceCurrency" content="USD" />
    <meta itemprop="availability" content="https://schema.org/InStock" />
  </div>

  <a
    href={`/${slug}`}
    itemprop="url"
    class="flex flex-col justify-between h-full text-left focus:outline-none"
    aria-label={`Launch ${h1} - Free online image tool running client-side`}
  >
    <header>
      <!-- Top Meta Bar: Icon, Category & Live Status Pill -->
      <div class="flex items-center justify-between gap-2 mb-3.5">
        <div class="flex items-center gap-2.5 min-w-0">
          <!-- 3D Glowing Icon Container -->
          <div
            class="w-10 h-10 rounded-xl bg-cyan/15 border border-cyan/40 text-cyan flex items-center justify-center text-lg flex-shrink-0 group-hover:scale-110 group-hover:bg-cyan/25 group-hover:border-cyan transition-all duration-300 shadow-[0_0_14px_rgba(38,224,255,0.2)]"
            aria-hidden="true"
          >
            {icon}
          </div>
          <div class="min-w-0">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-cyan block truncate leading-tight">
              {displayCategory}
            </span>
            <span class="text-[10px] font-semibold text-slate-300 uppercase tracking-tight flex items-center gap-1.5 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00D084] animate-pulse" aria-hidden="true"></span>
              <span>Online Tool • Free</span>
            </span>
          </div>
        </div>

        {isNew && (
          <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-gradient-to-r from-cyan to-purple text-[#04141a] flex-shrink-0 shadow-sm">
            NEW
          </span>
        )}
      </div>

      <!-- Tool Title -->
      <h3
        itemprop="name"
        class="font-display font-bold text-white group-hover:text-cyan transition-colors text-base sm:text-lg mb-2 leading-snug"
      >
        {h1}
      </h3>

      <!-- Tool Description -->
      <p
        itemprop="description"
        class="text-xs sm:text-sm text-slate-100 line-clamp-2 leading-relaxed font-normal mb-3"
      >
        {description}
      </p>

      <!-- Trust & Micro-specs Badges -->
      <div class="flex items-center gap-1.5 flex-wrap mb-4" aria-label="Tool specifications">
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#101728] border border-[#2b3b5c] text-slate-200">
          ⚡ 0s Server Delay
        </span>
        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-[#101728] border border-[#2b3b5c] text-slate-200">
          🔒 100% In-Browser
        </span>
      </div>
    </header>

    <!-- Card Footer: Distinct & Interactive Action Trigger Button -->
    <footer class="mt-auto pt-3.5 border-t border-[#263552] flex items-center justify-between gap-2">
      <span class="text-[11px] text-slate-300 font-medium">No sign-up needed</span>
      
      <!-- Interactive Launch Button Pill -->
      <div
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-cyan/50 bg-gradient-to-r from-cyan/15 via-purple/20 to-cyan/10 text-cyan font-bold text-xs group-hover:from-cyan group-hover:to-[#a76bff] group-hover:text-[#04141a] group-hover:border-transparent group-hover:shadow-[0_0_20px_rgba(38,224,255,0.45)] transition-all duration-300 shadow-sm flex-shrink-0"
      >
        <span>Use Tool Free</span>
        <svg
          class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </footer>
  </a>
</article>
