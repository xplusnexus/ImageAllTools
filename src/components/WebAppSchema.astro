---
export interface Props {
  name: string;
  description: string;
  url: string;
}
const { name, description, url } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  name,
  description,
  url,
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: "PhotoEditorApplication",
  operatingSystem: "All (Web Browser, Windows, macOS, Linux, iOS, Android)",
  browserRequirements: "Requires JavaScript. Requires HTML5 Canvas.",
  softwareVersion: "2.5.0",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
  featureList: [
    "100% Client-Side In-Browser Processing",
    "Zero Server Storage or File Retention",
    "High-Performance Lossless & Lossy Compression",
    "No Registration or Subscription Required",
    "Works Offline on Modern Devices"
  ],
  creator: {
    "@type": "Organization",
    name: "XPlus Nexus",
    url: "https://www.xplusnexus.com",
  },
  publisher: {
    "@type": "Organization",
    name: "ImageAll",
    url: "https://www.imagealltools.com",
    logo: "https://www.imagealltools.com/logo.png",
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
