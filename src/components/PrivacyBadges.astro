---
export interface Props {
  badges?: string[];
}
const { badges = ["100% Free", "Secure & Private", "Instant Client-Side", "Works on Mobile"] } = Astro.props;
---
<div class="flex flex-wrap gap-2 mt-3 mb-6">
  {badges.map((b) => (
    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-surface-2 text-white border border-cyan/30 flex items-center gap-1.5 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan inline-block"></span>
      {b}
    </span>
  ))}
</div>
