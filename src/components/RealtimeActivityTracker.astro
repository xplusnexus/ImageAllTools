---
// RealtimeActivityTracker.astro - Lightweight, zero-bloat client-side presence & processed counter tracker
---
<script>
  (function () {
    // Unique session ID stored in sessionStorage (cleared when browser tab/window closes)
    let sessionId = '';
    try {
      sessionId = sessionStorage.getItem('imageall_sid') || '';
      if (!sessionId) {
        sessionId = Math.random().toString(36).substring(2, 10) + Date.now().toString(36).substring(4);
        sessionStorage.setItem('imageall_sid', sessionId);
      }
    } catch (e) {
      sessionId = 'anon_' + Math.random().toString(36).substring(2, 8);
    }

    // Check if new visitor session
    let isNewVisit = false;
    try {
      if (!sessionStorage.getItem('imageall_counted_visit')) {
        isNewVisit = true;
        sessionStorage.setItem('imageall_counted_visit', '1');
      }
    } catch (e) {
      isNewVisit = true;
    }

    // In-memory counter state (starts from zero/one for clean launch)
    let onlineUsers = 1;
    let imagesProcessed = 0;
    let totalVisitors = 1;
    let heartbeatTimer: any = null;
    let isRequestPending = false;
    let lastUploadTriggerTime = 0;

    // Helper: Format number with commas
    function formatNumber(num: number): string {
      return (Number(num) || 0).toLocaleString();
    }

    // Update all matching DOM elements across the page
    function updateDOM(animate: boolean = false) {
      const onlineElements = document.querySelectorAll('.live-online-count');
      const processedElements = document.querySelectorAll('.live-processed-count');
      const visitorElements = document.querySelectorAll('.live-visitors-count');

      const displayUsers = Math.max(1, totalVisitors || onlineUsers);
      onlineElements.forEach((el) => {
        el.textContent = formatNumber(displayUsers);
      });

      processedElements.forEach((el) => {
        el.textContent = formatNumber(imagesProcessed);
        if (animate) {
          el.classList.add('text-cyan', 'scale-110');
          setTimeout(() => {
            el.classList.remove('text-cyan', 'scale-110');
          }, 350);
        }
      });

      visitorElements.forEach((el) => {
        el.textContent = formatNumber(displayUsers);
      });
    }

    // Ping API (heartbeat or increment)
    async function sendPing(action: 'heartbeat' | 'increment_processed', amount: number = 1) {
      if (isRequestPending && action === 'heartbeat') return;
      isRequestPending = true;

      try {
        const payload = {
          action,
          session_id: sessionId,
          is_new_visit: isNewVisit ? 1 : 0,
          amount: Math.min(20, Math.max(1, amount))
        };
        isNewVisit = false; // only report once per browser session

        const res = await fetch('/api/stats.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          cache: 'no-store'
        });

        if (res.ok) {
          const data = await res.json();
          if (data && data.status === 'success') {
            const userCount = Number(data.total_users || data.total_visitors || data.online_users || 1);
            onlineUsers = userCount;
            totalVisitors = userCount;
            if (data.images_processed !== undefined) imagesProcessed = Number(data.images_processed);
            updateDOM(action === 'increment_processed');
          }
        }
      } catch (err) {
        // Keep current state on network error
      } finally {
        isRequestPending = false;
      }
    }

    // Global hook for incrementing processed count
    (window as any).trackImageProcessed = function (amount: number = 1) {
      const add = Math.min(20, Math.max(1, Number(amount) || 1));
      // Optimistic instant UI update
      imagesProcessed += add;
      updateDOM(true);

      // Inform server
      sendPing('increment_processed', add);
    };

    function triggerUploadIncrement(amount: number = 1) {
      const now = Date.now();
      // Debounce to prevent double-counting when clicking button then picking file
      if (now - lastUploadTriggerTime < 800) {
        return;
      }
      lastUploadTriggerTime = now;
      (window as any).trackImageProcessed(amount);

      // Also update local user counter
      try {
        const count = parseInt(localStorage.getItem('imageall_user_processed') || '0', 10) + amount;
        localStorage.setItem('imageall_user_processed', count.toString());
        const userProcessedEl = document.getElementById('user-local-processed');
        if (userProcessedEl) {
          userProcessedEl.textContent = count.toString();
          userProcessedEl.classList.add('text-white', 'bg-cyan', 'scale-125');
          setTimeout(() => userProcessedEl.classList.remove('text-white', 'bg-cyan', 'scale-125'), 600);
        }
      } catch (e) {}
    }

    // 1. Trigger when user clicks the "Click to Upload Image" button or dropzone
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target) {
        const isUploadTrigger = target.closest('.dropzone-cta-btn, .dropzone, #tw-drop, [data-upload-trigger]');
        if (isUploadTrigger) {
          triggerUploadIncrement(1);
        }
      }
    }, true);

    // 2. Trigger when file is selected from file picker dialog
    document.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target && target.type === 'file' && target.files && target.files.length > 0) {
        triggerUploadIncrement(target.files.length);
      }
    }, true);

    // 3. Trigger when file is dragged and dropped onto any dropzone
    document.addEventListener('drop', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.closest('.dropzone') && e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        triggerUploadIncrement(e.dataTransfer.files.length);
      }
    }, true);

    // Listen to custom event dispatched by existing widgets
    window.addEventListener('imageall:processed', () => {
      (window as any).trackImageProcessed(1);
    });

    // Start heartbeat interval (only when tab is visible)
    function startHeartbeat() {
      stopHeartbeat();
      // Send initial heartbeat
      sendPing('heartbeat');
      // Every 25 seconds while active
      heartbeatTimer = setInterval(() => {
        if (!document.hidden) {
          sendPing('heartbeat');
        }
      }, 25000);
    }

    function stopHeartbeat() {
      if (heartbeatTimer) {
        clearInterval(heartbeatTimer);
        heartbeatTimer = null;
      }
    }

    // Page Visibility API: Stop pinging when tab is minimized/hidden to prevent useless loops
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopHeartbeat();
      } else {
        startHeartbeat();
      }
    });

    // Initialize on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        updateDOM();
        startHeartbeat();
      });
    } else {
      updateDOM();
      startHeartbeat();
    }
  })();
</script>
