---
// CoreValueProps Component - Rendered on every page
export interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---
<section class={`py-10 ${className}`}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto">
    <!-- 100% Private -->
    <article class="p-6 rounded-2xl border border-[#334468] bg-gradient-to-b from-[#151d31] to-[#1c263e] hover:border-cyan/70 transition-all duration-200 group shadow-sm">
      <div class="w-10 h-10 rounded-xl bg-cyan/15 border border-cyan/40 text-cyan flex items-center justify-center text-lg mb-3.5 group-hover:scale-105 transition-transform" aria-hidden="true">
        🔒
      </div>
      <h3 class="text-lg font-display font-bold text-white group-hover:text-cyan transition-colors">100% Private</h3>
      <p class="text-sm text-slate-100 mt-2 leading-relaxed font-normal">
        All processing happens in your browser. Your images never leave your device.
      </p>
    </article>

    <!-- Lightning Fast -->
    <article class="p-6 rounded-2xl border border-[#334468] bg-gradient-to-b from-[#151d31] to-[#1c263e] hover:border-purple/70 transition-all duration-200 group shadow-sm">
      <div class="w-10 h-10 rounded-xl bg-purple/15 border border-purple/40 text-purple flex items-center justify-center text-lg mb-3.5 group-hover:scale-105 transition-transform" aria-hidden="true">
        ⚡
      </div>
      <h3 class="text-lg font-display font-bold text-white group-hover:text-purple transition-colors">Lightning Fast</h3>
      <p class="text-sm text-slate-100 mt-2 leading-relaxed font-normal">
        Instant processing with no server delays or upload times.
      </p>
    </article>

    <!-- Batch Processing -->
    <article class="p-6 rounded-2xl border border-[#334468] bg-gradient-to-b from-[#151d31] to-[#1c263e] hover:border-cyan/70 transition-all duration-200 group shadow-sm">
      <div class="w-10 h-10 rounded-xl bg-cyan/15 border border-cyan/40 text-cyan flex items-center justify-center text-lg mb-3.5 group-hover:scale-105 transition-transform" aria-hidden="true">
        📦
      </div>
      <h3 class="text-lg font-display font-bold text-white group-hover:text-cyan transition-colors">Batch Processing</h3>
      <p class="text-sm text-slate-100 mt-2 leading-relaxed font-normal">
        Process multiple images at once and download as ZIP.
      </p>
    </article>
  </div>
</section>
