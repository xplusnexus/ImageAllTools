---
import { getCollection, type CollectionEntry } from "astro:content";

export interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;

const allTools = await getCollection("tools");
const related = slugs
  .map((s) => allTools.find((t: CollectionEntry<"tools">) => t.slug === s))
  .filter((t): t is CollectionEntry<"tools"> => Boolean(t));
---
{related.length > 0 && (
  <section class="mt-12 pt-8 border-t border-border">
    <h2 class="text-lg font-bold font-display text-white mb-4">Related tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {related.map((t) => (
        <article class="h-full">
          <a
            href={`/${t.slug}`}
            class="group flex flex-col justify-between h-full p-4 rounded-2xl border border-[#334468] bg-gradient-to-b from-[#151d31] to-[#1c263e] hover:border-cyan hover:shadow-[0_4px_20px_rgba(38,224,255,0.15)] transition-all duration-150"
          >
            <div>
              <h3 class="font-bold text-sm sm:text-base text-white group-hover:text-cyan transition-colors">{t.data.h1}</h3>
              <p class="text-xs sm:text-sm text-slate-100 mt-1.5 line-clamp-2 leading-relaxed font-normal">{t.data.description}</p>
            </div>
            <div class="mt-3 text-xs text-cyan font-bold inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>Open Tool</span>
              <span>→</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}
