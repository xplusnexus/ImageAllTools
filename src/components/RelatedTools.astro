---
import { getCollection, type CollectionEntry } from "astro:content";
import ToolCard from "./ToolCard.astro";

export interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;

const allTools = await getCollection("tools");
const related = slugs
  .map((s) => allTools.find((t: CollectionEntry<"tools">) => t.slug === s))
  .filter((t): t is CollectionEntry<"tools"> => Boolean(t));
---
{related.length > 0 && (
  <section class="mt-12 pt-8 border-t border-border" aria-label="Related Image Tools">
    <div class="flex items-center justify-between mb-5">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-cyan block">More Utilities</span>
        <h2 class="text-xl sm:text-2xl font-bold font-display text-white mt-1">Related Creative Tools</h2>
      </div>
      <a href="/#catalog" class="text-xs sm:text-sm font-bold text-cyan hover:underline inline-flex items-center gap-1">
        <span>View all 45 tools</span>
        <span>→</span>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {related.map((t) => (
        <ToolCard
          slug={t.slug}
          h1={t.data.h1}
          description={t.data.description}
          category={t.data.category}
        />
      ))}
    </div>
  </section>
)}
