  function getCookie(name: string): string | null {
    const v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
    return v ? v[2] : null;
  }

  function getSavedLang(): string {
    const cookie = getCookie('googtrans');
    if (cookie) {
      const parts = cookie.split('/');
      if (parts.length >= 3 && parts[2]) return parts[2];
    }
    return localStorage.getItem('preferred_lang') || 'en';
  }

  function updateAllUI(langCode: string) {
    const langObj = POPULAR_LANGS.find(l => l.code === langCode);
    const labelText = langObj ? langObj.native : (langCode === 'en' ? 'English' : langCode);

    document.querySelectorAll('.current-lang-label').forEach((label) => {
      label.textContent = labelText;
    });

    document.querySelectorAll('.lang-option').forEach((opt) => {
      const code = opt.getAttribute('data-lang');
      const check = opt.querySelector('.check-mark');
      if (code === langCode) {
        if (check) check.classList.remove('hidden');
        opt.classList.add('bg-cyan', 'text-black', 'border-cyan', 'font-black', 'shadow-[0_0_18px_rgba(38,224,255,0.5)]');
        opt.classList.remove('bg-[#1f283f]', 'text-white', 'border-[#2e3b5e]');
      } else {
        if (check) check.classList.add('hidden');
        opt.classList.remove('bg-cyan', 'text-black', 'border-cyan', 'font-black', 'shadow-[0_0_18px_rgba(38,224,255,0.5)]');
        opt.classList.add('bg-[#1f283f]', 'text-white', 'border-[#2e3b5e]');
      }
    });
  }

  function setGoogleTranslateCookie(langCode: string) {
    const host = window.location.hostname;
    if (!langCode || langCode === 'en') {
      document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
      if (host.includes('.')) {
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=." + host + ";";
      }
      localStorage.removeItem('preferred_lang');
    } else {
      const val = '/en/' + langCode;
      document.cookie = "googtrans=" + val + "; path=/;";
      if (host.includes('.')) {
        document.cookie = "googtrans=" + val + "; path=/; domain=." + host + ";";
      }
      localStorage.setItem('preferred_lang', langCode);
    }
  }

  function applyTranslation(langCode: string) {
    setGoogleTranslateCookie(langCode);
    updateAllUI(langCode);

    // 1. Try to set via the hidden Google Translate combo box directly
    const combo = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
    if (combo) {
      combo.value = langCode;
      combo.dispatchEvent(new Event('change'));
      if (langCode === 'en') {
        setTimeout(() => location.reload(), 200);
      }
      return;
    }

    // 2. If combo box isn't ready yet, poll for it
    let attempts = 0;
    const interval = setInterval(() => {
      attempts++;
      const s = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
      if (s) {
        s.value = langCode;
        s.dispatchEvent(new Event('change'));
        clearInterval(interval);
        if (langCode === 'en') {
          setTimeout(() => location.reload(), 200);
        }
      } else if (attempts >= 25) {
        clearInterval(interval);
        location.reload();
      }
    }, 80);
  }

  function closeAllMenus() {
    document.querySelectorAll('.lang-dropdown-menu').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll('.chevron-icon').forEach((c) => c.classList.remove('rotate-180'));
    document.querySelectorAll('.lang-toggle-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  }

  // Global event delegation
  if (!(window as any).__langSelectorDelegated) {
    (window as any).__langSelectorDelegated = true;

    // Click handling
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Handle dropdown button toggle
      const btn = target.closest('.lang-toggle-btn') as HTMLButtonElement | null;
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const container = btn.closest('.lang-selector-container');
        const menu = container ? container.querySelector('.lang-dropdown-menu') : null;
        const chevron = btn.querySelector('.chevron-icon');

        if (!menu) return;

        const isCurrentlyOpen = !menu.classList.contains('hidden');
        closeAllMenus();

        if (!isCurrentlyOpen) {
          menu.classList.remove('hidden');
          if (chevron) chevron.classList.add('rotate-180');
          btn.setAttribute('aria-expanded', 'true');
          // Focus search input
          const input = menu.querySelector('.lang-search-input') as HTMLInputElement | null;
          if (input) {
            setTimeout(() => input.focus(), 50);
          }
        }
        return;
      }

      // Handle language option click
      const option = target.closest('.lang-option') as HTMLButtonElement | null;
      if (option) {
        e.preventDefault();
        e.stopPropagation();
        const lang = option.getAttribute('data-lang');
        if (lang) {
          applyTranslation(lang);
        }
        closeAllMenus();
        return;
      }

      // Handle click outside
      if (!target.closest('.lang-selector-container')) {
        closeAllMenus();
      }
    });

    // Real-time language live search filter
    document.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | null;
      if (!target || !target.classList.contains('lang-search-input')) return;

      const query = target.value.trim().toLowerCase();
      const menu = target.closest('.lang-dropdown-menu');
      if (!menu) return;

      const options = menu.querySelectorAll('.lang-option') as NodeListOf<HTMLElement>;
      let visibleCount = 0;

      options.forEach((opt) => {
        const text = opt.getAttribute('data-search') || '';
        if (!query || text.includes(query)) {
          opt.style.display = 'flex';
          visibleCount++;
        } else {
          opt.style.display = 'none';
        }
      });

      const noResults = menu.querySelector('.no-results') as HTMLElement | null;
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    });

    // Handle Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllMenus();
      }
    });

    // Google Translate Callback
    (window as any).googleTranslateElementInit = function() {
      const w = window as any;
      if (w.google && w.google.translate) {
        new w.google.translate.TranslateElement({
          pageLanguage: 'en',
          layout: w.google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false
        }, 'google_translate_element');

        const saved = getSavedLang();
        if (saved && saved !== 'en') {
          let attempts = 0;
          const poll = setInterval(() => {
            attempts++;
            const s = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
            if (s) {
              s.value = saved;
              s.dispatchEvent(new Event('change'));
              clearInterval(poll);
            } else if (attempts >= 30) {
              clearInterval(poll);
            }
          }, 80);
        }
      }
    };

    // Load Google Translate script once
    if (!document.getElementById('google-translate-script')) {
      const script = document.createElement('script');
      script.id = 'google-translate-script';
      script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      script.async = true;
      document.head.appendChild(script);
    }

    // Sync initial UI
    const initialLang = getSavedLang();
    if (initialLang) {
      updateAllUI(initialLang);
    }
  }
</script>
