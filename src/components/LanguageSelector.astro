<div class={`lang-selector-container relative inline-block text-left ${variant === 'footer' ? 'w-full sm:w-auto' : ''}`} data-id-prefix={idPrefix}>
  <button
    type="button"
    class={`lang-toggle-btn group flex items-center justify-between gap-2.5 px-4 py-2.5 rounded-xl border-2 border-cyan/60 bg-[#1c2438] hover:border-cyan hover:bg-[#25304b] text-white transition-all duration-200 text-xs font-bold cursor-pointer shadow-[0_4px_16px_rgba(0,0,0,0.6),0_0_18px_rgba(38,224,255,0.22)] ${variant === 'footer' ? 'w-full sm:w-auto' : ''}`}
    id={`${idPrefix}-lang-btn`}
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Change Language Worldwide"
  >
    <span class="flex items-center gap-2 pointer-events-none">
      <span class="text-lg">🌐</span>
      <span class="current-lang-label font-sans font-bold text-white tracking-wide">English</span>
    </span>
    <svg class="w-4 h-4 text-cyan group-hover:text-white transition-transform duration-200 chevron-icon pointer-events-none flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- High-Contrast Distinct Dropdown Menu (Solid Background & High Visibility) -->
  <div
    class={`lang-dropdown-menu hidden absolute ${
      variant === 'footer'
        ? 'bottom-full mb-3 left-0 sm:left-auto sm:right-0'
        : variant === 'floating'
        ? 'top-full mt-2 left-0 sm:left-auto sm:right-0'
        : 'top-full mt-2 right-0'
    } w-76 sm:w-92 max-h-[28rem] flex flex-col rounded-2xl border-2 border-cyan bg-[#161d2f] shadow-[0_25px_80px_rgba(0,0,0,0.98),0_0_35px_rgba(38,224,255,0.35)] ring-1 ring-cyan/40 p-3.5 z-[100]`}
    id={`${idPrefix}-lang-menu`}
    role="menu"
  >
    <!-- Header with High Contrast & Clear Title -->
    <div class="px-3 py-2 mb-3 bg-[#0f1422] rounded-xl border border-cyan/30 flex items-center justify-between text-xs font-black text-white uppercase tracking-wider">
      <span class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan shadow-[0_0_10px_rgba(38,224,255,0.9)] animate-pulse"></span>
        <span class="text-white font-bold">Select Language</span>
      </span>
      <span class="text-[11px] text-black font-extrabold px-3 py-0.5 rounded-full bg-cyan shadow-[0_0_12px_rgba(38,224,255,0.4)]">
        133+ Worldwide
      </span>
    </div>

    <!-- Quick Live Filter Search Box (High Contrast) -->
    <div class="mb-3">
      <div class="relative bg-[#0b0f1a] border-2 border-cyan/40 focus-within:border-cyan rounded-xl transition-all shadow-inner">
        <input
          type="text"
          placeholder="Search 133+ languages (e.g. Hindi, Spanish, French)..."
          class="lang-search-input w-full bg-transparent px-3.5 py-2.5 text-xs sm:text-sm text-white font-semibold placeholder:text-slate-300 focus:outline-none"
          aria-label="Filter languages"
        />
        <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-cyan pointer-events-none">🔍</span>
      </div>
    </div>

    <!-- Scrollable Language List (Distinct Card Tiles for Crystal-Clear Legibility) -->
    <div class="lang-list-container flex-1 overflow-y-auto space-y-1.5 pr-1.5 max-h-64 custom-scrollbar" role="none">
      {popularLanguages.map((l) => (
        <button
          type="button"
          class="lang-option group w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs sm:text-sm bg-[#1f283f] hover:bg-cyan hover:border-cyan hover:text-black border border-[#2e3b5e] transition-all duration-150 text-left cursor-pointer shadow-sm"
          data-lang={l.code}
          data-name={l.native}
          data-search={`${l.name} ${l.native} ${l.code}`.toLowerCase()}
          role="menuitem"
        >
          <span class="flex items-center gap-3 pointer-events-none truncate">
            <span class="text-lg flex-shrink-0">{l.flag}</span>
            <span class="font-bold text-white group-hover:text-black truncate text-xs sm:text-sm">{l.native}</span>
            <span class="text-xs text-slate-200 group-hover:text-black/90 truncate font-medium">({l.name})</span>
          </span>
          <span class="check-mark hidden text-cyan group-hover:text-black text-sm font-black pointer-events-none flex-shrink-0 ml-2">✓</span>
        </button>
      ))}
      <div class="no-results hidden py-8 text-center text-xs sm:text-sm text-white font-semibold bg-[#0f1422] rounded-xl border border-cyan/30">
        No language matched your search.<br />
        <span class="text-cyan text-xs mt-1 inline-block font-bold">133 languages are supported globally.</span>
      </div>
    </div>

    <!-- High-Contrast Footer Notice -->
    <div class="mt-3 pt-2.5 border-t border-cyan/30 px-2 flex items-center justify-between text-xs text-slate-100">
      <span class="flex items-center gap-1.5 font-semibold">
        <span class="text-cyan text-sm">⚡</span> Instant Client-Side Translation
      </span>
      <span class="text-cyan font-bold">133 Total Languages</span>
    </div>
  </div>
</div>

