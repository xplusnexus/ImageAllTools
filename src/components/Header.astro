---
import LanguageSelector from "./LanguageSelector.astro";

const navLinks = [
  { label: "Compress", href: "/#compress", icon: "🗜️" },
  { label: "Resize", href: "/#resize", icon: "📐" },
  { label: "Convert", href: "/#convert", icon: "🔄" },
  { label: "Crop", href: "/#crop", icon: "✂️" },
  { label: "Remove BG", href: "/#bg-remove", icon: "🪄" },
  { label: "Rotate & Flip", href: "/#rotate", icon: "⟳" },
  { label: "Watermark", href: "/#watermark", icon: "🏷️" },
  { label: "To PDF", href: "/#to-pdf", icon: "📄" },
  { label: "Color Palette", href: "/#palette", icon: "🎨" },
  { label: "WhatsApp DP", href: "/whatsapp-dp-maker", icon: "💬" },
  { label: "Instagram", href: "/resize-image-for-instagram", icon: "📸" },
  { label: "All 45 Tools", href: "/#catalog", icon: "⚡" },
  { label: "FAQ", href: "/#faq", icon: "❓" },
];
---
<header class="border-b border-border sticky top-0 z-50 bg-[#0f1422]/95 backdrop-blur-md shadow-lg" role="banner">
  <!-- Top Brand & Action Bar -->
  <div class="wrap py-2 sm:py-2.5 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo & Title -->
    <a href="/" class="brand flex items-center gap-2 sm:gap-2.5 font-display font-bold text-base sm:text-lg text-white hover:opacity-90 transition flex-shrink-0" aria-label="ImageAll by XPlus Nexus Home">
      <img src="/logo.png" alt="XPlus Nexus Logo" width="32" height="32" class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl object-cover border border-cyan/40 shadow-[0_0_12px_rgba(38,224,255,0.25)] flex-shrink-0" />
      <span class="tracking-tight text-white font-extrabold text-sm sm:text-base">ImageAll <span class="text-xs font-semibold text-cyan hidden md:inline">by XPlus Nexus</span></span>
    </a>
    
    <!-- Header Right: Stats, Language & Catalog Button -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      <!-- Live Global Activity Indicator (Desktop) -->
      <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-xl border border-cyan/30 bg-[#12192b] text-xs shadow-inner flex-shrink-0" title="Real-time global statistics">
        <span class="inline-flex items-center gap-1.5 font-bold text-slate-100">
          <span class="w-2 h-2 rounded-full bg-[#00D084] animate-pulse" aria-hidden="true"></span>
          <span class="live-online-count font-extrabold text-white">22</span> Users
        </span>
        <span class="text-slate-500 select-none">•</span>
        <span class="inline-flex items-center gap-1 font-bold text-cyan">
          <span aria-hidden="true">⚡</span>
          <span class="live-processed-count">20</span> Processed
        </span>
      </div>

      <!-- Worldwide Language Selector -->
      <LanguageSelector variant="header" idPrefix="header" />

      <!-- Browse All 45 Tools Button -->
      <a
        href="/#catalog"
        class="inline-flex text-xs sm:text-sm px-3 py-1.5 rounded-xl border border-cyan/40 bg-surface-2 text-white hover:border-cyan hover:bg-cyan hover:text-black transition-all font-bold whitespace-nowrap shadow-sm"
      >
        <span>Browse Tools</span> <span class="ml-1 text-cyan font-extrabold hover:text-black">(45)</span>
      </a>
    </div>
  </div>

  <!-- ALWAYS VISIBLE ON TOP FOR MOBILE VIEW & DESKTOP: All Options for Compress, Resize, Convert, Crop, Remove BG, Watermark, To PDF, All 45 Tools -->
  <nav class="border-t border-[#1f2b45] bg-[#0c1220]/95 px-2 py-1.5 overflow-x-auto no-scrollbar scroll-smooth" aria-label="Top Tools Navigation">
    <div class="wrap flex items-center gap-1.5 sm:gap-2 text-xs whitespace-nowrap min-w-max">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-[#283654] bg-[#162035] hover:border-cyan hover:bg-cyan/15 hover:text-cyan text-slate-100 hover:text-white text-[11px] sm:text-xs font-bold transition-all shadow-sm active:scale-95"
        >
          <span class="text-xs sm:text-sm">{item.icon}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // Smooth scroll for hash links when already on the homepage
  document.querySelectorAll('header a[href^="/#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return;
      const targetHash = href.substring(1); // e.g. "#compress"
      if (window.location.pathname === '/' || window.location.pathname === '') {
        const targetEl = document.querySelector(targetHash);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth' });
          history.pushState(null, '', targetHash);
        }
      }
    });
  });
</script>
