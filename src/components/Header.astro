---
import LanguageSelector from "./LanguageSelector.astro";

const navLinks = [
  { label: "Compress", href: "/#compress", icon: "🗜️" },
  { label: "Resize", href: "/#resize", icon: "📐" },
  { label: "Convert", href: "/#convert", icon: "🔄" },
  { label: "Crop", href: "/#crop", icon: "✂️" },
  { label: "Remove BG", href: "/#bg-remove", icon: "🪄" },
  { label: "Watermark", href: "/#watermark", icon: "🏷️" },
  { label: "To PDF", href: "/#to-pdf", icon: "📄" },
  { label: "All 45 Tools", href: "/#catalog", icon: "⚡" },
];
---
<header class="border-b border-border sticky top-0 z-50 bg-[#0f1422]/95 backdrop-blur-md shadow-lg" role="banner">
  <div class="wrap py-2.5 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo & Title -->
    <a href="/" class="brand flex items-center gap-2 sm:gap-3 font-display font-bold text-base sm:text-lg text-white hover:opacity-90 transition flex-shrink-0" aria-label="ImageAll by XPlus Nexus Home">
      <img src="/logo.png" alt="XPlus Nexus Logo" width="36" height="36" class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-cover border border-cyan/40 shadow-[0_0_15px_rgba(38,224,255,0.25)] flex-shrink-0" />
      <span class="tracking-tight text-white font-extrabold">ImageAll <span class="text-xs font-semibold text-cyan hidden md:inline">by XPlus Nexus</span></span>
    </a>
    
    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-sm" aria-label="Main Navigation">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="px-2.5 py-1.5 rounded-lg text-slate-100 hover:text-cyan hover:bg-surface-2 transition-colors text-sm font-semibold"
        >
          {item.label}
        </a>
      ))}
    </nav>
    
    <!-- Header Right: Language, Catalog & Mobile Menu Button -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      <!-- Live Global Activity Indicator (Desktop) -->
      <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-xl border border-cyan/30 bg-[#12192b] text-xs shadow-inner flex-shrink-0" title="Real-time global statistics">
        <span class="inline-flex items-center gap-1.5 font-bold text-slate-100">
          <span class="w-2 h-2 rounded-full bg-[#00D084] animate-pulse" aria-hidden="true"></span>
          <span class="live-online-count font-extrabold text-white">14</span> Online
        </span>
        <span class="text-slate-500 select-none">•</span>
        <span class="inline-flex items-center gap-1 font-bold text-cyan">
          <span aria-hidden="true">⚡</span>
          <span class="live-processed-count">148,520</span> Processed
        </span>
      </div>

      <!-- Worldwide Language Selector -->
      <LanguageSelector variant="header" idPrefix="header" />

      <!-- Desktop Browse Tools Button -->
      <a
        href="/#catalog"
        class="hidden sm:inline-flex text-xs sm:text-sm px-3.5 py-1.5 rounded-xl border border-cyan/40 bg-surface-2 text-white hover:border-cyan hover:bg-cyan hover:text-black transition-all font-bold whitespace-nowrap shadow-sm"
      >
        Browse Tools (45)
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-xl border border-[#334468] bg-[#192238] text-white hover:border-cyan hover:text-cyan focus:outline-none focus:ring-2 focus:ring-cyan transition-all flex items-center justify-center flex-shrink-0 shadow-sm"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Open Navigation Menu"
      >
        <!-- Closed state icon (Hamburger) -->
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Open state icon (X close) -->
        <svg id="close-icon" class="w-5 h-5 hidden text-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer (Collapsible) -->
  <nav
    id="mobile-nav-drawer"
    class="lg:hidden hidden border-t border-[#334468] bg-[#121827] px-4 py-3 shadow-2xl transition-all"
    aria-label="Mobile Navigation Menu"
  >
    <!-- Live Activity Banner on Mobile -->
    <div class="mb-3 px-3.5 py-2 rounded-xl border border-cyan/30 bg-[#151e33] flex items-center justify-between text-xs shadow-sm">
      <span class="flex items-center gap-1.5 font-bold text-slate-100">
        <span class="w-2 h-2 rounded-full bg-[#00D084] animate-pulse" aria-hidden="true"></span>
        <span class="live-online-count font-extrabold text-white">14</span> Users Online Now
      </span>
      <span class="font-bold text-cyan flex items-center gap-1">
        <span aria-hidden="true">⚡</span>
        <span class="live-processed-count">148,520</span> Processed
      </span>
    </div>

    <div class="grid grid-cols-2 gap-2 pb-2">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link flex items-center gap-2 px-3 py-2.5 rounded-xl border border-[#2b3956] bg-[#192238] text-white hover:border-cyan hover:bg-cyan/15 hover:text-cyan text-xs sm:text-sm font-bold transition-all shadow-sm"
        >
          <span class="text-base">{item.icon}</span>
          <span class="truncate">{item.label}</span>
        </a>
      ))}
    </div>
    <a
      href="/#catalog"
      class="mobile-nav-link mt-2 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-gradient-to-r from-cyan to-purple text-[#04141a] font-extrabold text-xs sm:text-sm shadow-md hover:brightness-110 transition-all text-center"
    >
      <span>⚡ Browse All 45 Image Tools</span>
      <span>→</span>
    </a>
  </nav>
</header>

<script>
  (function () {
    const toggle = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-nav-drawer");
    const hIcon = document.getElementById("hamburger-icon");
    const cIcon = document.getElementById("close-icon");

    if (!toggle || !drawer) return;

    function setMenuState(open: boolean) {
      drawer?.classList.toggle("hidden", !open);
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Close Navigation Menu" : "Open Navigation Menu");
      hIcon?.classList.toggle("hidden", open);
      cIcon?.classList.toggle("hidden", !open);
    }

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !drawer.classList.contains("hidden");
      setMenuState(!isOpen);
    });

    // Close when clicking any nav link
    drawer.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuState(false);
      });
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !drawer.classList.contains("hidden")) {
        setMenuState(false);
        toggle.focus();
      }
    });

    // Close when clicking outside header
    document.addEventListener("click", (e) => {
      const header = toggle.closest("header");
      if (header && !header.contains(e.target as Node) && !drawer.classList.contains("hidden")) {
        setMenuState(false);
      }
    });
  })();
</script>
