---
// How It Works Component - Rendered on every tool page and homepage
export interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---
<section class={`py-8 ${className}`}>
  <div class="text-center max-w-xl mx-auto mb-8">
    <span class="text-xs font-semibold uppercase tracking-wider text-cyan">Effortless Workflow</span>
    <h2 class="text-2xl sm:text-3xl font-display font-bold text-white mt-1.5">How It Works</h2>
    <p class="text-sm text-slate-200 mt-2">Three simple steps to perfect images</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto">
    <!-- Step 1 -->
    <div class="relative p-6 rounded-2xl border border-border bg-gradient-to-b from-surface to-surface-2 hover:border-cyan/60 transition-all duration-200 group">
      <div class="w-12 h-12 rounded-xl bg-cyan/10 border border-cyan/30 text-cyan flex items-center justify-center font-display font-bold text-lg mb-4 group-hover:scale-105 transition-transform">
        01
      </div>
      <h3 class="text-base font-display font-semibold text-white group-hover:text-cyan transition-colors">Upload</h3>
      <p class="text-xs sm:text-sm text-slate-200 mt-1.5 leading-relaxed">
        Drag & drop or select your images directly from your device. Supports all major formats.
      </p>
    </div>

    <!-- Step 2 -->
    <div class="relative p-6 rounded-2xl border border-border bg-gradient-to-b from-surface to-surface-2 hover:border-cyan/60 transition-all duration-200 group">
      <div class="w-12 h-12 rounded-xl bg-purple/10 border border-purple/30 text-purple flex items-center justify-center font-display font-bold text-lg mb-4 group-hover:scale-105 transition-transform">
        02
      </div>
      <h3 class="text-base font-display font-semibold text-white group-hover:text-purple transition-colors">Adjust</h3>
      <p class="text-xs sm:text-sm text-slate-200 mt-1.5 leading-relaxed">
        Configure size, quality, target KB, aspect ratios, or visual effects with real-time visual feedback.
      </p>
    </div>

    <!-- Step 3 -->
    <div class="relative p-6 rounded-2xl border border-border bg-gradient-to-b from-surface to-surface-2 hover:border-cyan/60 transition-all duration-200 group">
      <div class="w-12 h-12 rounded-xl bg-cyan/10 border border-cyan/30 text-cyan flex items-center justify-center font-display font-bold text-lg mb-4 group-hover:scale-105 transition-transform">
        03
      </div>
      <h3 class="text-base font-display font-semibold text-white group-hover:text-cyan transition-colors">Download</h3>
      <p class="text-xs sm:text-sm text-slate-200 mt-1.5 leading-relaxed">
        Save your processed images instantly to your device without quality loss, wait times, or watermarks.
      </p>
    </div>
  </div>
</section>
