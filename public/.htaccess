# Hostinger Apache / LiteSpeed Configuration for ImageAllTools Static Site

# Disable Directory Browsing (Prevents directory index leaks)
Options -Indexes

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block direct web access to internal stats storage
  RewriteRule ^api/storage/ - [F,L]

  # If requested resource exists as a file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve folder index.html for clean URLs (e.g. /image-compressor -> /image-compressor/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]
</IfModule>

# Block access to hidden files and directories (e.g. .git, .env, .htaccess)
<FilesMatch "^\.">
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Block direct access to sensitive file extensions (backups, configs, logs, sql, db)
<FilesMatch "\.(bak|config|sql|ini|log|sh|inc|swp|dist|env|db)$">
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Custom 404 Error Document
ErrorDocument 404 /404.html

# GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On

  # Immutable Astro Chunks & Bundled Assets (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # HTML files (10 minutes so updates reflect quickly)
  ExpiresByType text/html "access plus 600 seconds"
</IfModule>

# Comprehensive HTTP Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
